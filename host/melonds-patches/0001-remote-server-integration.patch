+constexpr GLsizei kNativeH = dualdeck::host::kFrameHeight;
+
+// Upper bound on how much of melonDS's own internal 3D upscale (up to
+// 16x, Config's "3D.GL.ScaleFactor" range) actually gets forwarded to a
+// remote client -- see GLBottomScreenCapture.h's own comment on why the
+// full range isn't streamed uncapped. 4x (1024x768) is already above a
+// Steam Deck's own 1280x800 display's height, so it's the point past
+// which more resolution stops being visibly sharper on the device this
+// project targets, while staying cheap enough to JPEG/H264-encode and
+// transmit in real time.
+constexpr GLsizei kMaxCaptureScale = 4;
+}
+
+GLBottomScreenCapture::~GLBottomScreenCapture() {
+    if (downscaleFB_) glDeleteFramebuffers(1, &downscaleFB_);
+    if (downscaleTex_) glDeleteTextures(1, &downscaleTex_);
+    if (readFB_) glDeleteFramebuffers(1, &readFB_);
+}
+
+bool GLBottomScreenCapture::captureBottomScreen(GLuint texArray, std::vector<uint8_t>& outBgra,
+                                                 uint16_t& outWidth, uint16_t& outHeight) {
+    GLint prevRead = 0, prevDraw = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prevDraw);
+
+    glBindTexture(GL_TEXTURE_2D_ARRAY, texArray);
+    GLint texW = 0, texH = 0;
+    glGetTexLevelParameteriv(GL_TEXTURE_2D_ARRAY, 0, GL_TEXTURE_WIDTH, &texW);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D_ARRAY, 0, GL_TEXTURE_HEIGHT, &texH);
+
+    bool ok = false;
+    if (texW >= kNativeW && texH >= kNativeH) {
+        // texW/texH are always an integer multiple of native DS
+        // resolution (both dimensions scaled by the same ScaleFactor --
+        // see GPU_OpenGL.cpp's glTexImage3D(..., 256*ScaleFactor,
+        // 256*ScaleFactor, ...) sizing this class's own header describes),
+        // so capping via that one integer ratio keeps the 4:3 aspect
+        // ratio intact rather than risking a non-uniform cap on width vs.
+        // height independently.
+        GLsizei scale = texW / kNativeW;
+        GLsizei cappedScale = scale < kMaxCaptureScale ? scale : kMaxCaptureScale;
+        GLsizei targetW = kNativeW * cappedScale;
+        GLsizei targetH = kNativeH * cappedScale;
+
+        if (!readFB_) glGenFramebuffers(1, &readFB_);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, readFB_);
+        // Layer 1 = bottom screen; see this class's header comment for
+        // where that layer convention comes from.
+        glFramebufferTextureLayer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, texArray, 0, 1);
+        glReadBuffer(GL_COLOR_ATTACHMENT0);
+
+        if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+            outBgra.resize(static_cast<size_t>(targetW) * static_cast<size_t>(targetH) * 4);
+
+            if (targetW == texW && targetH == texH) {
+                // Texture is already at or below the cap (the common
+                // case -- melonDS's default is 1x, and most "upscale my
+                // 3D" settings stay under kMaxCaptureScale): read
+                // directly, no downscale needed.
+                glReadPixels(0, 0, targetW, targetH, GL_BGRA, GL_UNSIGNED_BYTE, outBgra.data());
+                ok = true;
+            } else {
+                // Above the cap -- downscale via a GPU blit rather than
+                // forwarding the full texture uncapped (see this class's
+                // header comment and kMaxCaptureScale's above for why).
+                // Reallocate downscaleTex_ if the target size has
+                // changed since the last call (melonDS's 3D resolution
+                // setting can change live while a client is connected).
+                if (!downscaleTex_ || downscaleTexW_ != targetW || downscaleTexH_ != targetH) {
+                    if (!downscaleTex_) glGenTextures(1, &downscaleTex_);
+                    glBindTexture(GL_TEXTURE_2D, downscaleTex_);
+                    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, targetW, targetH, 0, GL_RGBA,
+                                 GL_UNSIGNED_BYTE, nullptr);
+                    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+                    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+                    downscaleTexW_ = targetW;
+                    downscaleTexH_ = targetH;
+                }
+                if (!downscaleFB_) glGenFramebuffers(1, &downscaleFB_);
+                glBindFramebuffer(GL_DRAW_FRAMEBUFFER, downscaleFB_);
+                glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                                       downscaleTex_, 0);
+
+                if (glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+                    glBlitFramebuffer(0, 0, texW, texH, 0, 0, targetW, targetH, GL_COLOR_BUFFER_BIT,
+                                       GL_LINEAR);
+
+                    glBindFramebuffer(GL_READ_FRAMEBUFFER, downscaleFB_);
+                    glReadBuffer(GL_COLOR_ATTACHMENT0);
+                    glReadPixels(0, 0, targetW, targetH, GL_BGRA, GL_UNSIGNED_BYTE, outBgra.data());
+                    ok = true;
+                }
+            }
+
+            if (ok) {
+                outWidth = static_cast<uint16_t>(targetW);
+                outHeight = static_cast<uint16_t>(targetH);
+            }
+        }
+    }
+
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(prevRead));
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(prevDraw));
+    return ok;
+}
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/GLBottomScreenCapture.h b/src/frontend/qt_sdl/remote_server/GLBottomScreenCapture.h
new file mode 100644
index 0000000..3e0cf18
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/GLBottomScreenCapture.h
@@ -0,0 +1,92 @@
+#pragma once
+
+// Reads the bottom-screen layer back from melonDS's OpenGL/OpenGLCompute
+// 3D renderer's final-output array texture, for hosts that don't use the
+// software 3D renderer (see docs/history.md's "Video transport"
+// entry and docs/melonds-integration-analysis.md section 1.2 for why
+// GPU::GetFramebuffers() alone isn't enough in that case: it hands back a
+// GL texture handle instead of a RAM pointer, and doesn't split out the
+// bottom screen on its own).
+//
+// GPU_OpenGL.cpp's GLRenderer stores both screens in one GL_TEXTURE_2D_ARRAY
+// (FPOutputTex[frontbuf]), format GL_RGBA/GL_UNSIGNED_BYTE, dimensions
+// (256*ScaleFactor) x (192*ScaleFactor) x 2 layers -- layer 0 is the top
+// screen, layer 1 is the bottom (see GLRenderer::Init()'s
+// glFramebufferTextureLayer(..., FPOutputTex[i], 0, 0/1) calls and
+// RenderScreen()'s GL_COLOR_ATTACHMENT0/1 usage). This is an internal
+// implementation detail, not part of GetFramebuffers()'s documented
+// contract, the same way the software path's "engine B is the bottom
+// screen" is -- both were established by reading melonDS's own renderer
+// source, not guessed.
+//
+// Must be called with melonDS's GL context current (EmuThread.cpp only
+// reaches this code when useOpenGL is true, right after
+// emuInstance->makeCurrentGL() earlier in the same frame).
+
+#include "PlatformOGL.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace dualdeck_bridge {
+
+class GLBottomScreenCapture {
+public:
+    ~GLBottomScreenCapture();
+
+    GLBottomScreenCapture(const GLBottomScreenCapture&) = delete;
+    GLBottomScreenCapture& operator=(const GLBottomScreenCapture&) = delete;
+    GLBottomScreenCapture() = default;
+
+    // `texArray` is the GL_TEXTURE_2D_ARRAY handle GetFramebuffers()
+    // pointed at (dereferenced by the caller -- see EmuThread.cpp).
+    // Reads layer 1 (bottom screen) into `outBgra` at the texture's own
+    // resolution -- melonDS's "3D Renderer -> Resolution" setting
+    // (Config's "3D.GL.ScaleFactor", 1-16, i.e. up to 4096x3072 for this
+    // one screen) genuinely changes the sharpness of any 3D content
+    // rendered to it, and the wire protocol/host/client are all already
+    // resolution-agnostic per-frame (see host/frame_source.h's
+    // IFrameSource::getLatestFrame() and net_client.cpp's
+    // hostNativeWidth()/hostNativeHeight(), both already built for a
+    // capture source whose real size isn't known until a frame actually
+    // arrives -- originally for CemuAdapter, equally applicable here).
+    //
+    // Real user report: the bottom screen stayed native 256x192 (soft,
+    // blocky 3D) no matter how high the user raised melonDS's own
+    // internal resolution, because this class used to unconditionally
+    // downscale back to 256x192 before the frame ever left the host.
+    //
+    // Still caps at kMaxCaptureScale (see .cpp) via the same downscale-
+    // blit path this class already had, rather than forwarding the full
+    // 16x/4096x3072 texture uncapped: that many raw BGRA bytes per frame
+    // (~50MB) would cost far more to read back, JPEG/H264-encode, and
+    // transmit than any real-time stream can absorb, and it's already
+    // well past what a Steam Deck's own 1280x800 display could show
+    // sharper for. Downscaling only kicks in above that cap -- most
+    // "upscale my 3D" settings (2x-4x) are read back directly, uncapped.
+    //
+    // Resizes `outBgra` to outWidth*outHeight*4 bytes (BGRA8888) and sets
+    // outWidth/outHeight to the actual captured resolution on success.
+    // Returns false (leaving `outBgra`/outWidth/outHeight unchanged) if
+    // the texture isn't at least native DS resolution or the readback
+    // otherwise couldn't be completed -- callers should fall back to
+    // their own diagnostic in that case, since it means this renderer
+    // isn't laid out the way this class assumes.
+    bool captureBottomScreen(GLuint texArray, std::vector<uint8_t>& outBgra, uint16_t& outWidth,
+                              uint16_t& outHeight);
+
+private:
+    GLuint readFB_ = 0;
+    GLuint downscaleFB_ = 0;
+    GLuint downscaleTex_ = 0;
+    // Size downscaleTex_ was last allocated at (0 until first use) --
+    // melonDS's 3D resolution setting can change live while connected
+    // (VideoSettingsDialog applies immediately), so the target downscale
+    // size isn't fixed the way it was when this was always 256x192;
+    // reallocate downscaleTex_ if it no longer matches.
+    GLsizei downscaleTexW_ = 0;
+    GLsizei downscaleTexH_ = 0;
+};
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/ManagementServer.cpp b/src/frontend/qt_sdl/remote_server/ManagementServer.cpp
new file mode 100644
index 0000000..4ec55e2
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/ManagementServer.cpp
@@ -0,0 +1,148 @@
+#include "ManagementServer.h"
+
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+namespace dualdeck_bridge {
+
+namespace {
+
+// Constant-time-ish comparison, matching the reasoning in net_server.cpp:
+// always walks the same number of bytes so a client can't use response
+// timing to learn how many leading bytes of the token it guessed right.
+bool constantTimeEquals(const std::string& a, const std::string& b) {
+    size_t maxLen = std::max(a.size(), b.size());
+    unsigned char diff = static_cast<unsigned char>(a.size() != b.size());
+    for (size_t i = 0; i < maxLen; ++i) {
+        unsigned char ca = i < a.size() ? static_cast<unsigned char>(a[i]) : 0;
+        unsigned char cb = i < b.size() ? static_cast<unsigned char>(b[i]) : 0;
+        diff = static_cast<unsigned char>(diff | (ca ^ cb));
+    }
+    return diff == 0;
+}
+
+} // namespace
+
+ManagementServer::ManagementServer(std::string bindAddress, uint16_t port, std::string token,
+                                    std::function<bool(bool)> onToggle, std::function<bool()> onStatus)
+    : bindAddress_(std::move(bindAddress)), port_(port), token_(std::move(token)),
+      onToggle_(std::move(onToggle)), onStatus_(std::move(onStatus)) {}
+
+ManagementServer::~ManagementServer() { stop(); }
+
+void ManagementServer::start() {
+    bool expected = false;
+    if (!running_.compare_exchange_strong(expected, true)) return;
+
+    listenFd_ = ::socket(AF_INET, SOCK_STREAM, 0);
+    if (listenFd_ < 0) {
+        std::perror("melonds-remote: management socket");
+        running_ = false;
+        return;
+    }
+
+    int reuse = 1;
+    ::setsockopt(listenFd_, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(port_);
+    if (::inet_pton(AF_INET, bindAddress_.c_str(), &addr.sin_addr) != 1) {
+        std::fprintf(stderr, "melonds-remote: invalid management bind address: %s\n", bindAddress_.c_str());
+        ::close(listenFd_);
+        listenFd_ = -1;
+        running_ = false;
+        return;
+    }
+
+    if (::bind(listenFd_, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0) {
+        std::perror("melonds-remote: management bind");
+        ::close(listenFd_);
+        listenFd_ = -1;
+        running_ = false;
+        return;
+    }
+
+    if (::listen(listenFd_, 1) < 0) {
+        std::perror("melonds-remote: management listen");
+        ::close(listenFd_);
+        listenFd_ = -1;
+        running_ = false;
+        return;
+    }
+
+    std::fprintf(stderr, "melonds-remote: management listener on %s:%u\n", bindAddress_.c_str(), port_);
+    acceptThread_ = std::thread(&ManagementServer::acceptLoop, this);
+}
+
+void ManagementServer::stop() {
+    if (!running_.exchange(false)) return;
+    if (listenFd_ >= 0) ::shutdown(listenFd_, SHUT_RDWR);
+    if (acceptThread_.joinable()) acceptThread_.join();
+    if (listenFd_ >= 0) ::close(listenFd_);
+    listenFd_ = -1;
+}
+
+void ManagementServer::acceptLoop() {
+    while (running_.load()) {
+        sockaddr_in clientAddr{};
+        socklen_t clientLen = sizeof(clientAddr);
+        int clientFd = ::accept(listenFd_, reinterpret_cast<sockaddr*>(&clientAddr), &clientLen);
+        if (clientFd < 0) {
+            if (!running_.load()) break;
+            continue;
+        }
+        handleClient(clientFd);
+        ::close(clientFd);
+    }
+}
+
+void ManagementServer::handleClient(int clientFd) {
+    // One line in, one line out -- a management command is tiny and
+    // infrequent, so this reads byte-by-byte up to a generous cap rather
+    // than needing a real buffered reader.
+    std::string line;
+    char c = 0;
+    while (line.size() < 256) {
+        ssize_t n = ::recv(clientFd, &c, 1, 0);
+        if (n <= 0) return; // closed/error before a full line arrived
+        if (c == '\n') break;
+        line.push_back(c);
+    }
+
+    size_t space = line.find(' ');
+    if (space == std::string::npos) {
+        static const char kMsg[] = "ERROR malformed request\n";
+        ::send(clientFd, kMsg, sizeof(kMsg) - 1, 0);
+        return;
+    }
+    std::string givenToken = line.substr(0, space);
+    std::string command = line.substr(space + 1);
+    while (!command.empty() && (command.back() == '\r' || command.back() == '\n')) command.pop_back();
+
+    if (!constantTimeEquals(givenToken, token_)) {
+        static const char kMsg[] = "ERROR bad token\n";
+        ::send(clientFd, kMsg, sizeof(kMsg) - 1, 0);
+        return;
+    }
+
+    std::string response;
+    if (command == "ENABLE") {
+        response = onToggle_(true) ? "OK ENABLED\n" : "ERROR failed to enable\n";
+    } else if (command == "DISABLE") {
+        response = onToggle_(false) ? "OK DISABLED\n" : "ERROR failed to disable\n";
+    } else if (command == "STATUS") {
+        response = onStatus_() ? "OK ENABLED\n" : "OK DISABLED\n";
+    } else {
+        response = "ERROR unrecognized command\n";
+    }
+    ::send(clientFd, response.data(), response.size(), 0);
+}
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/ManagementServer.h b/src/frontend/qt_sdl/remote_server/ManagementServer.h
new file mode 100644
index 0000000..2aece35
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/ManagementServer.h
@@ -0,0 +1,68 @@
+#pragma once
+
+// Small, always-on (once configured) TCP listener that lets something
+// else on the LAN -- e.g. a Decky Loader plugin running on a Steam Deck
+// -- turn melonDS's remote-streaming server on or off while melonDS is
+// already running, without needing to restart the process. Exists
+// independent of RemoteServerBridge's own lifecycle: it's constructed
+// whenever melonDS starts (instance 0 only) as long as a management
+// token is configured, and stays up regardless of whether remote
+// streaming itself is currently on.
+//
+// Deliberately a separate, much simpler channel than the main remote
+// protocol (NetServer/protocol.h): one command per connection, plain
+// newline-delimited ASCII, no persistent session, no device-approval
+// state machine -- this only flips a single on/off switch, so it doesn't
+// need any of that machinery. See host/melonds-patches/README.md for the
+// full rationale (GitHub issue: "Decky plugin to start/stop the host
+// server").
+//
+// Wire protocol: client connects, sends one line
+//   "<token> ENABLE\n" | "<token> DISABLE\n" | "<token> STATUS\n"
+// server sends one line back and closes the connection:
+//   "OK ENABLED\n" | "OK DISABLED\n" | "ERROR <reason>\n"
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <thread>
+
+namespace dualdeck_bridge {
+
+class ManagementServer {
+public:
+    // onToggle(true) should start remote streaming (idempotent if
+    // already running) and onToggle(false) should stop it (idempotent if
+    // already stopped); both return true on success. onStatus() reports
+    // whether it's currently running. All three are called from this
+    // class's own accept thread, never concurrently with each other (one
+    // client handled at a time), but concurrently with whatever else the
+    // caller's process is doing -- callers are responsible for their own
+    // thread safety (see EmuInstance::remoteServerMutex).
+    ManagementServer(std::string bindAddress, uint16_t port, std::string token,
+                      std::function<bool(bool enable)> onToggle, std::function<bool()> onStatus);
+    ~ManagementServer();
+
+    ManagementServer(const ManagementServer&) = delete;
+    ManagementServer& operator=(const ManagementServer&) = delete;
+
+    void start();
+    void stop();
+
+private:
+    void acceptLoop();
+    void handleClient(int clientFd);
+
+    std::string bindAddress_;
+    uint16_t port_;
+    std::string token_;
+    std::function<bool(bool)> onToggle_;
+    std::function<bool()> onStatus_;
+
+    std::atomic<bool> running_{false};
+    int listenFd_ = -1;
+    std::thread acceptThread_;
+};
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/MelonDSAdapter.cpp b/src/frontend/qt_sdl/remote_server/MelonDSAdapter.cpp
new file mode 100644
index 0000000..cecf7b6
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/MelonDSAdapter.cpp
@@ -0,0 +1,138 @@
+#include "MelonDSAdapter.h"
+
+// For MELONDS_VERSION, reported as this adapter's own version -- see
+// RemoteServerBridge.cpp's identical include for why (generated at
+// configure time, already on the include path).
+#include "version.h"
+
+namespace dualdeck_bridge {
+
+namespace {
+
+constexpr const char* kBottomSurfaceId = "bottom";
+
+dualdeck::adapter::AdapterCapabilities buildCapabilities() {
+    dualdeck::adapter::AdapterCapabilities caps;
+    caps.system = dualdeck::SystemIdentity{"nds", "Nintendo DS"};
+    caps.adapter = dualdeck::AdapterIdentity{"melonds", "melonDS", MELONDS_VERSION};
+
+    dualdeck::adapter::VideoSurfaceDescriptor bottom;
+    bottom.surfaceId = kBottomSurfaceId;
+    bottom.role = dualdeck::adapter::SurfaceRole::Bottom;
+    bottom.width = 256;
+    bottom.height = 192;
+    bottom.touchSupported = true;
+    bottom.touchRangeX = dualdeck::kTouchMaxX;
+    bottom.touchRangeY = dualdeck::kTouchMaxY;
+    bottom.required = true;
+    bottom.remotelyDisplayed = true;
+    caps.surfaces = {bottom};
+
+    // Mic audio is real here (GitHub issue #2), just not carried through
+    // this specific interface -- MelonDSMicAudioSink is wired directly
+    // to NetServer by RemoteServerBridge, independent of
+    // IEmulatorAdapter/host::AdapterBridge (which only cover video +
+    // controller/touch input). See RemoteServerBridge.h's comment.
+    caps.supportsMicrophone = true;
+    return caps;
+}
+
+// Inverse of host::AdapterBridge's dsButtonsToGenericButtons() (see
+// host/adapter_bridge.cpp) -- explicit bit-by-bit, not a shift/mask
+// trick, for the same reason that table gives: DSButton and
+// GenericButton agree on their low bits (A/B/X/Y/D-pad/L/R) but diverge
+// at Start/Select, since GenericButton reserves bits 10-13 for L2/R2/L3/
+// R3, concepts the DS has none of.
+uint16_t genericButtonsToDsButtons(uint32_t generic) {
+    uint16_t ds = 0;
+    if (generic & dualdeck::adapter::GenericButton_South) ds |= dualdeck::DSButton_A;
+    if (generic & dualdeck::adapter::GenericButton_East) ds |= dualdeck::DSButton_B;
+    if (generic & dualdeck::adapter::GenericButton_West) ds |= dualdeck::DSButton_X;
+    if (generic & dualdeck::adapter::GenericButton_North) ds |= dualdeck::DSButton_Y;
+    if (generic & dualdeck::adapter::GenericButton_DpadUp) ds |= dualdeck::DSButton_Up;
+    if (generic & dualdeck::adapter::GenericButton_DpadDown) ds |= dualdeck::DSButton_Down;
+    if (generic & dualdeck::adapter::GenericButton_DpadLeft) ds |= dualdeck::DSButton_Left;
+    if (generic & dualdeck::adapter::GenericButton_DpadRight) ds |= dualdeck::DSButton_Right;
+    if (generic & dualdeck::adapter::GenericButton_L1) ds |= dualdeck::DSButton_L;
+    if (generic & dualdeck::adapter::GenericButton_R1) ds |= dualdeck::DSButton_R;
+    if (generic & dualdeck::adapter::GenericButton_Start) ds |= dualdeck::DSButton_Start;
+    if (generic & dualdeck::adapter::GenericButton_Select) ds |= dualdeck::DSButton_Select;
+    return ds;
+}
+
+} // namespace
+
+dualdeck::adapter::AdapterCapabilities MelonDSAdapter::capabilities() const {
+    static const dualdeck::adapter::AdapterCapabilities caps = buildCapabilities();
+    return caps;
+}
+
+dualdeck::adapter::SessionState MelonDSAdapter::currentState() const {
+    // host::AdapterBridge (the only consumer of this adapter today)
+    // never calls currentState() -- melonDS's own session concept (ROM
+    // loaded, running, paused) isn't tracked at this layer yet, so this
+    // is a fixed placeholder rather than a real state machine. Revisit
+    // if/when a Host Service actually consults this.
+    return dualdeck::adapter::SessionState::Running;
+}
+
+void MelonDSAdapter::applyGenericInput(const dualdeck::adapter::GenericInputState& state) {
+    dualdeck::ControllerState cs;
+    cs.sequence = state.sequence;
+    cs.clientTimestampUs = state.clientTimestampUs;
+    cs.dsButtons = genericButtonsToDsButtons(state.buttons);
+    cs.leftStickX = state.leftStickX;
+    cs.leftStickY = state.leftStickY;
+    cs.rightStickX = state.rightStickX;
+    cs.rightStickY = state.rightStickY;
+    for (const auto& touch : state.touches) {
+        if (touch.surfaceId == kBottomSurfaceId) {
+            cs.touchActive = 1;
+            cs.touchX = touch.x;
+            cs.touchY = touch.y;
+            break;
+        }
+    }
+    // Bit layout is intentionally identical between EmulatorAction
+    // (protocol.h) and GenericEmulatorAction (generic_input.h) -- see
+    // host::AdapterBridge's matching comment -- so this is a direct
+    // pass-through, not a lookup table like the buttons above.
+    cs.emulatorActions = static_cast<uint16_t>(state.emulatorActions);
+    inputSink_.applyControllerState(cs);
+}
+
+void MelonDSAdapter::releaseAllInputs() {
+    inputSink_.releaseAll();
+}
+
+bool MelonDSAdapter::latestFrame(const std::string& surfaceId, dualdeck::adapter::SurfaceFrame& outFrame) {
+    if (surfaceId != kBottomSurfaceId) return false;
+    std::vector<uint8_t> frame;
+    uint64_t frameIndex = 0;
+    uint16_t frameWidth = 0, frameHeight = 0;
+    if (!frameSource_.getLatestFrame(frame, frameIndex, frameWidth, frameHeight)) return false;
+    outFrame.surfaceId = kBottomSurfaceId;
+    outFrame.frameIndex = frameIndex;
+    // The software renderer always pushes native 256x192 (matching
+    // capabilities()'s own bottom.width/height above), but the OpenGL
+    // renderer's capture can be any resolution melonDS's own 3D upscale
+    // setting produces (see GLBottomScreenCapture) -- this frame's actual
+    // dimensions, not a fixed assumption, same dynamic-capture treatment
+    // adapter_contract.h's SurfaceFrame comment already describes for
+    // e.g. Cemu.
+    outFrame.width = frameWidth;
+    outFrame.height = frameHeight;
+    outFrame.pixels = std::move(frame);
+    return true;
+}
+
+void MelonDSAdapter::pushFrame(const void* bgraData, size_t sizeBytes, uint16_t width,
+                                uint16_t height) {
+    frameSource_.pushFrame(bgraData, sizeBytes, width, height);
+}
+
+dualdeck::ControllerState MelonDSAdapter::latestControllerState() const {
+    return inputSink_.latestState();
+}
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/MelonDSAdapter.h b/src/frontend/qt_sdl/remote_server/MelonDSAdapter.h
new file mode 100644
