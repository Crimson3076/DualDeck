diff --git a/src/frontend/qt_sdl/remote_server/MelonDSMicAudioSink.cpp b/src/frontend/qt_sdl/remote_server/MelonDSMicAudioSink.cpp
new file mode 100644
index 0000000..b5d8d9b
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/MelonDSMicAudioSink.cpp
@@ -0,0 +1,44 @@
+#include "MelonDSMicAudioSink.h"
+
+#include <algorithm>
+#include <chrono>
+
+namespace dualdeck_bridge {
+
+namespace {
+uint64_t nowMicros() {
+    using namespace std::chrono;
+    return static_cast<uint64_t>(
+        duration_cast<microseconds>(steady_clock::now().time_since_epoch()).count());
+}
+} // namespace
+
+void MelonDSMicAudioSink::applyMicAudio(const dualdeck::MicAudioFramePayload& frame) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pending_.insert(pending_.end(), frame.samples.begin(), frame.samples.end());
+    if (pending_.size() > kMaxPendingSamples) {
+        pending_.erase(pending_.begin(),
+                        pending_.begin() + static_cast<long>(pending_.size() - kMaxPendingSamples));
+    }
+    lastPacketTimeUs_ = nowMicros();
+}
+
+void MelonDSMicAudioSink::releaseAudio() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pending_.clear();
+    lastPacketTimeUs_ = 0;
+}
+
+void MelonDSMicAudioSink::drainSamples(std::vector<int16_t>& out) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    out.insert(out.end(), pending_.begin(), pending_.end());
+    pending_.clear();
+}
+
+bool MelonDSMicAudioSink::isActive(uint64_t nowUs, uint64_t timeoutUs) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (lastPacketTimeUs_ == 0) return false;
+    return (nowUs - lastPacketTimeUs_) < timeoutUs;
+}
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/MelonDSMicAudioSink.h b/src/frontend/qt_sdl/remote_server/MelonDSMicAudioSink.h
new file mode 100644
index 0000000..a00f345
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/MelonDSMicAudioSink.h
@@ -0,0 +1,57 @@
+#pragma once
+
+// Queues microphone samples received from the network for
+// RemoteServerBridge to drain once per frame and feed into melonDS's
+// native mic pipeline (see EmuInstance::remoteMicFeed()), mirroring
+// MelonDSInputSink's role for ControllerState. Unlike ControllerState (a
+// "latest snapshot" the emulation thread polls and treats as the current
+// value), mic audio is a continuous sample stream -- losing track of
+// which samples were already delivered would drop or duplicate audio --
+// so this queues everything received rather than overwriting.
+
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+#include "host/mic_audio_sink.h"
+
+namespace dualdeck_bridge {
+
+class MelonDSMicAudioSink : public dualdeck::host::IMicAudioSink {
+public:
+    void applyMicAudio(const dualdeck::MicAudioFramePayload& frame) override;
+    void releaseAudio() override;
+
+    // Drains all samples queued since the last call, appending them to
+    // `out`. Called once per emulated frame from
+    // EmuInstance::inputProcess() on the emulation thread -- never from
+    // the network thread that applyMicAudio() runs on.
+    void drainSamples(std::vector<int16_t>& out);
+
+    // True if a MicAudioFrame arrived within the last `timeoutUs`
+    // microseconds -- distinguishes "a client is actively streaming
+    // audio right now" from "the remote-server feature merely exists,"
+    // which matters because EmuInstance::micReadInput() uses this to
+    // decide whether to override the host's own local Mic.InputType
+    // configuration (see its comment for why "remote server object
+    // exists" alone would be the wrong signal -- it would silently
+    // replace a host operator's local Noise/Wav test setup with silence
+    // whenever the remote-server feature is merely enabled, even with no
+    // client sending audio).
+    bool isActive(uint64_t nowUs, uint64_t timeoutUs) const;
+
+private:
+    // Bounds unbounded growth if drainSamples() stops being called (e.g.
+    // emulation paused) while packets keep arriving -- oldest samples are
+    // dropped first, same tradeoff as melonDS's own local-mic
+    // micExtBuffer ring buffer already makes implicitly by being a fixed
+    // size. 1 second at kMicAudioSampleRate is generous headroom for any
+    // normal frame-pump stall.
+    static constexpr size_t kMaxPendingSamples = 48000;
+
+    mutable std::mutex mutex_;
+    std::vector<int16_t> pending_;
+    uint64_t lastPacketTimeUs_ = 0; // 0 means "never received a packet"
+};
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/RemoteServerBridge.cpp b/src/frontend/qt_sdl/remote_server/RemoteServerBridge.cpp
new file mode 100644
index 0000000..79c4660
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/RemoteServerBridge.cpp
@@ -0,0 +1,153 @@
+#include "RemoteServerBridge.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+
+// For MELONDS_VERSION, reported as this adapter's own version (GitHub
+// issue #28's identity model -- distinct from NetServerConfig::appVersion,
+// which is melonds-remote's/DualDeck's own release string, not melonDS's).
+// Generated at configure time into the build directory; already on the
+// include path here the same way main.cpp/EmuThread.cpp include it (see
+// CMakeLists.txt's `target_include_directories(melonDS PUBLIC
+// "${CMAKE_CURRENT_SOURCE_DIR}")`).
+#include "version.h"
+
+namespace dualdeck_bridge {
+
+namespace {
+uint64_t nowMicros() {
+    using namespace std::chrono;
+    return static_cast<uint64_t>(
+        duration_cast<microseconds>(steady_clock::now().time_since_epoch()).count());
+}
+} // namespace
+
+RemoteServerBridge::RemoteServerBridge(
+    std::string bindAddress, uint16_t controlPort, uint16_t inputPort, uint16_t videoPort,
+    std::string authToken, std::string approvalStateFilePath,
+    std::function<void(std::vector<dualdeck::host::DeviceApprovalManager::PendingRequest>)>
+        onPendingRequestsChanged,
+    bool discoveryEnabled, uint16_t discoveryPort, std::string hostName,
+    std::function<void(bool)> onClientConnectionChanged, std::string appVersion, uint16_t audioPort) {
+    bridge_ = std::make_unique<dualdeck::host::AdapterBridge>(adapter_);
+    dualdeck::host::NetServerConfig config;
+    config.bindAddress = std::move(bindAddress);
+    config.controlPort = controlPort;
+    config.inputPort = inputPort;
+    config.videoPort = videoPort;
+    config.authToken = std::move(authToken);
+    config.approvalStateFilePath = std::move(approvalStateFilePath);
+    config.onPendingRequestsChanged = std::move(onPendingRequestsChanged);
+    config.discoveryEnabled = discoveryEnabled;
+    config.discoveryPort = discoveryPort;
+    config.hostName = std::move(hostName);
+    config.onClientConnectionChanged = std::move(onClientConnectionChanged);
+    config.appVersion = std::move(appVersion);
+    config.audioPort = audioPort;
+    config.micSupported = true;
+    // The melonDS adapter's own identity (GitHub issue #28) -- hardcoded
+    // here rather than threaded through as more constructor parameters,
+    // since this class *is* specifically the melonDS/Nintendo DS adapter;
+    // there is no scenario where a caller would construct a
+    // RemoteServerBridge and want it to claim to be anything else. A
+    // future 3DS/Wii U adapter's own bridge class would do the same
+    // one-line override in its own constructor with its own values,
+    // rather than this becoming a widely-threaded parameter (see
+    // docs/architecture.md's "Emulator identity model" section).
+    config.systemIdentity = dualdeck::SystemIdentity{"nds", "Nintendo DS"};
+    config.adapterIdentity =
+        dualdeck::AdapterIdentity{"melonds", "melonDS", MELONDS_VERSION};
+    server_ = std::make_unique<dualdeck::host::NetServer>(config, *bridge_, *bridge_, micSink_);
+}
+
+RemoteServerBridge::RemoteServerBridge(std::string adapterSocketPath) {
+    ipcClient_ = std::make_unique<dualdeck::adapter::ipc::AdapterIpcClient>(
+        adapter_, std::move(adapterSocketPath));
+}
+
+RemoteServerBridge::~RemoteServerBridge() {
+    stop();
+}
+
+bool RemoteServerBridge::start() {
+    if (server_) {
+        server_->start();
+        return server_->isRunning();
+    }
+
+    // Out-of-process mode: AdapterIpcClient::connect() is a single
+    // blocking, non-retrying attempt (see its own header comment) --
+    // this thread supplies the retry loop, mirroring
+    // client/src/main.cpp's own NetClient reconnect thread (same
+    // 1s-doubling-to-5s backoff, same 100ms poll granularity so stop()
+    // doesn't have to wait out a full backoff period to return).
+    stopRequested_ = false;
+    reconnectThread_ = std::thread([this]() {
+        uint32_t backoffMs = 1000;
+        constexpr uint32_t kMaxBackoffMs = 5000;
+        while (!stopRequested_.load()) {
+            if (!ipcClient_->isConnected()) {
+                std::fprintf(stderr,
+                              "melonds-remote: attempting to connect to the Host Service "
+                              "(adapter IPC)...\n");
+                if (ipcClient_->connect()) {
+                    std::fprintf(stderr, "melonds-remote: connected to Host Service\n");
+                    backoffMs = 1000;
+                } else {
+                    backoffMs = std::min(backoffMs * 2, kMaxBackoffMs);
+                }
+            }
+            for (uint32_t waited = 0; waited < backoffMs && !stopRequested_.load(); waited += 100) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            }
+        }
+    });
+    return true;
+}
+
+void RemoteServerBridge::stop() {
+    if (server_) {
+        server_->stop();
+        return;
+    }
+    if (ipcClient_) {
+        stopRequested_ = true;
+        if (reconnectThread_.joinable()) {
+            reconnectThread_.join();
+        }
+        ipcClient_->disconnect();
+    }
+}
+
+void RemoteServerBridge::pushBottomFrame(const void* bgraData, size_t sizeBytes, uint16_t width,
+                                          uint16_t height) {
+    adapter_.pushFrame(bgraData, sizeBytes, width, height);
+}
+
+dualdeck::ControllerState RemoteServerBridge::latestControllerState() const {
+    return adapter_.latestControllerState();
+}
+
+void RemoteServerBridge::drainMicAudio(std::vector<int16_t>& out) {
+    micSink_.drainSamples(out);
+}
+
+bool RemoteServerBridge::hasActiveMicAudio() const {
+    constexpr uint64_t kMicActiveTimeoutUs = 500'000; // 500ms, matches NetServerConfig::inputTimeoutUs
+    return micSink_.isActive(nowMicros(), kMicActiveTimeoutUs);
+}
+
+bool RemoteServerBridge::approveDevice(const std::string& deviceIdOrPrefix) {
+    if (server_) return server_->approveDevice(deviceIdOrPrefix);
+    // Out-of-process mode: nothing local to approve -- see this class's
+    // out-of-process constructor comment.
+    return false;
+}
+
+bool RemoteServerBridge::denyDevice(const std::string& deviceIdOrPrefix) {
+    if (server_) return server_->denyDevice(deviceIdOrPrefix);
+    return false;
+}
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/RemoteServerBridge.h b/src/frontend/qt_sdl/remote_server/RemoteServerBridge.h
new file mode 100644
index 0000000..31f3fc1
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/RemoteServerBridge.h
@@ -0,0 +1,170 @@
+#pragma once
+
+// Ties the standalone melonds-remote protocol/host networking code
+// (vendored under this remote_server/ directory) into melonDS. Owned by
+// EmuInstance (instance 0 only -- only one remote session is supported,
+// matching the melonds-remote project's v0.1 single-client scope),
+// started/stopped alongside the emulation thread.
+//
+// This class intentionally does not know about melonDS's KEYINPUT bit
+// order or hotkey enum -- see remoteButtonsToKeyMask()/
+// remoteActionsToHotkeyBits() in EmuInstanceInput.cpp for that mapping,
+// kept next to the rest of the input-merging code it parallels.
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "MelonDSAdapter.h"
+#include "MelonDSMicAudioSink.h"
+#include "host/adapter_bridge.h"
+#include "host/net_server.h"
+#include "dualdeck/adapter/ipc/adapter_ipc_client.h"
+
+namespace dualdeck_bridge {
+
+class RemoteServerBridge {
+public:
+    // `approvalStateFilePath` and `onPendingRequestsChanged` implement
+    // device-approval authentication (see
+    // host/device_approval_manager.h); only used when `authToken` is
+    // empty. `onPendingRequestsChanged` is invoked on NetServer's control
+    // thread (or its watchdog thread, for stale evictions), not the Qt UI
+    // thread -- callers must marshal it themselves (e.g.
+    // QMetaObject::invokeMethod with Qt::QueuedConnection) before
+    // touching any widget.
+    //
+    // `discoveryEnabled`/`discoveryPort`/`hostName` implement LAN
+    // discovery (spec section 8.1): on by default, see
+    // NetServerConfig::discoveryEnabled for the security reasoning.
+    //
+    // `onClientConnectionChanged` forwards NetServerConfig::onClientConnectionChanged
+    // (see host/net_server.h) -- fired true/false as a client's session
+    // starts/ends, so the caller can e.g. switch the local window to a
+    // top-screen-only layout while someone is actively streaming.
+    //
+    // `appVersion` forwards NetServerConfig::appVersion -- see its comment
+    // in host/net_server.h for the AppVersionMismatch rejection this
+    // enables.
+    //
+    // `audioPort` forwards NetServerConfig::audioPort (GitHub issue #2).
+    // Microphone support itself is always advertised as available (the
+    // sink always exists here, unlike the standalone host's optional
+    // --no-mic) -- there is no separate on/off switch beyond the whole
+    // remote-server feature's own enable toggle.
+    RemoteServerBridge(
+        std::string bindAddress, uint16_t controlPort, uint16_t inputPort, uint16_t videoPort,
+        std::string authToken, std::string approvalStateFilePath = {},
+        std::function<void(std::vector<dualdeck::host::DeviceApprovalManager::PendingRequest>)>
+            onPendingRequestsChanged = {},
+        bool discoveryEnabled = true, uint16_t discoveryPort = 8763, std::string hostName = {},
+        std::function<void(bool)> onClientConnectionChanged = {}, std::string appVersion = {},
+        uint16_t audioPort = 8765);
+
+    // Out-of-process mode (GitHub issue #4: host-control requires
+    // something host-side running independently of melonDS, which means
+    // melonDS itself can no longer own the NetServer melonDS's Qt
+    // approval dialog above depends on). Connects to an already-running
+    // standalone Host Service (melonds-remote-server --adapter-ipc)
+    // instead of constructing a NetServer here -- MelonDSAdapter (the
+    // same class the in-process constructor above uses) is wrapped in an
+    // AdapterIpcClient and driven entirely by that external process.
+    // `adapterSocketPath` empty uses
+    // dualdeck::adapter::ipc::defaultAdapterSocketPath(), matching
+    // the standalone host's own --adapter-socket default.
+    //
+    // Real, deliberate limitations of this mode, not yet solved (see
+    // docs/adr/0001-host-service-and-adapter-architecture.md and GitHub
+    // issue #4): device approval belongs entirely to the external Host
+    // Service now, so approveDevice()/denyDevice() below are no-ops here
+    // -- use that process's own console approve/deny/list commands or a
+    // static --auth-token instead of melonDS's Qt dialog, which has
+    // nothing to approve locally in this mode. Mic audio does not flow
+    // in this mode either (nothing feeds micSink_ here, since there is
+    // no local NetServer receiving UDP audio packets) -- the same
+    // already-documented "generic adapter contract doesn't carry mic
+    // audio yet" limitation as host/remote-server's --adapter-ipc mode.
+    explicit RemoteServerBridge(std::string adapterSocketPath);
+
+    ~RemoteServerBridge();
+
+    RemoteServerBridge(const RemoteServerBridge&) = delete;
+    RemoteServerBridge& operator=(const RemoteServerBridge&) = delete;
+
+    // Returns whether the server actually started -- false after a real
+    // bind failure (e.g. another process already listening on one of
+    // these ports; see NetServer::isRunning()'s own comment). Always
+    // true for the out-of-process constructor above, which has no
+    // synchronous failure mode of its own (a failed IPC connection just
+    // keeps retrying on its own thread).
+    bool start();
+    void stop();
+
+    // Called by EmuThread once per emulated frame -- either the software
+    // renderer path directly after GPU::GetFramebuffers() (always native
+    // DS resolution), or GLBottomScreenCapture's readback for the
+    // OpenGL/OpenGLCompute 3D renderer (whatever resolution melonDS's own
+    // 3D upscale setting produced, up to GLBottomScreenCapture's own cap).
+    void pushBottomFrame(const void* bgraData, size_t sizeBytes, uint16_t width, uint16_t height);
+
+    // Called by EmuInstance::inputProcess() once per frame to read the
+    // latest remote controller/touch/action state to merge in.
+    dualdeck::ControllerState latestControllerState() const;
+
+    // Called by EmuInstance::inputProcess() once per frame (GitHub issue
+    // #2): drains whatever mic samples have arrived since the last call,
+    // appending them to `out` for remoteMicFeed() to resample into
+    // melonDS's native mic pipeline.
+    void drainMicAudio(std::vector<int16_t>& out);
+
+    // True if a client has sent mic audio within the last 500ms -- see
+    // MelonDSMicAudioSink::isActive()'s comment for why this liveness
+    // check (not just "is the remote server running") is what
+    // EmuInstance::micReadInput() needs.
+    bool hasActiveMicAudio() const;
+
+    // Forwarded to NetServer -- see host/net_server.h. Safe to call from
+    // the Qt UI thread (e.g. a dialog's button-click slot). Always
+    // return false in out-of-process mode (see that constructor's
+    // comment) -- there is no local NetServer/DeviceApprovalManager to
+    // forward to.
+    bool approveDevice(const std::string& deviceIdOrPrefix);
+    bool denyDevice(const std::string& deviceIdOrPrefix);
+
+private:
+    // GitHub issue #28: melonDS's DS-specific input/video handling goes
+    // through the generic adapter contract now (MelonDSAdapter
+    // implements IEmulatorAdapter), translated back into the
+    // IEmulatorInputSink/IFrameSource shape NetServer expects by
+    // host::AdapterBridge -- the same "DS compatibility adapter" class
+    // the standalone host's --adapter-ipc mode uses, just wired
+    // in-process here instead of over a socket (see the ADR's "for an
+    // adapter that runs in the same process... no IPC is needed at all"
+    // allowance). Mic audio is unaffected -- micSink_ is still handed to
+    // NetServer directly, independent of the adapter contract, exactly
+    // as before.
+    //
+    // Exactly one of (bridge_+server_) or ipcClient_ is populated,
+    // depending on which constructor ran -- see each constructor's own
+    // comment. adapter_/micSink_ are shared by both modes: adapter_ is
+    // what either an in-process AdapterBridge or an out-of-process
+    // AdapterIpcClient ultimately drives, and micSink_ simply never gets
+    // fed anything in out-of-process mode (see that constructor's
+    // comment), so pushBottomFrame()/latestControllerState()/
+    // drainMicAudio()/hasActiveMicAudio() need no mode-specific branches
+    // at all -- only start()/stop()/approveDevice()/denyDevice() do.
+    MelonDSAdapter adapter_;
+    MelonDSMicAudioSink micSink_;
+    std::unique_ptr<dualdeck::host::AdapterBridge> bridge_;
+    std::unique_ptr<dualdeck::host::NetServer> server_;
+    std::unique_ptr<dualdeck::adapter::ipc::AdapterIpcClient> ipcClient_;
+    std::thread reconnectThread_;
+    std::atomic<bool> stopRequested_{false};
+};
