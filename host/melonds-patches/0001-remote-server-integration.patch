+#pragma once
+
+// Stores the latest ControllerState received from the network for
+// EmuInstance::inputProcess() to poll and merge into its own input state,
+// on the emulation thread, once per frame -- never called directly from
+// the network thread (see docs/melonds-integration-analysis.md section 2
