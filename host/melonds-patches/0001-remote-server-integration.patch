+// Constructs/starts remoteServer if it isn't already running, using the
+// same env-var-or-Config precedence as always (env var wins if set, for
+// scripting/CI; otherwise the Config key, already carrying the right
+// built-in default via Config.cpp's DefaultInts/DefaultBools/
+// DefaultStrings). Idempotent -- a second call while already running is
+// a no-op. Callable at any point in the process's life, not just at
+// startup, which is what lets the management listener (see
+// ManagementServer.h) and the constructor share this one code path.
+void EmuInstance::startRemoteServer()
+{
+    std::lock_guard<std::mutex> lock(remoteServerMutex);
+    if (remoteServer) return;
+
+    auto envOr = [this](const char* name, const std::string& cfgKey) -> std::string
+    {
+        const char* v = getenv(name);
+        if (v) return std::string(v);
+        return globalCfg.GetString(cfgKey);
+    };
+    auto envPortOr = [this](const char* name, const std::string& cfgKey) -> uint16_t
+    {
+        const char* v = getenv(name);
+        if (v) return static_cast<uint16_t>(std::stoi(v));
+        return static_cast<uint16_t>(globalCfg.GetInt(cfgKey));
+    };
+
+    // GitHub issue #4: out-of-process adapter mode -- connects to an
+    // already-running standalone Host Service instead of melonDS owning
+    // its own NetServer, required for host-control mode (something must
+    // be listening before melonDS even starts). See
+    // RemoteServerBridge.h's out-of-process constructor for exactly what
+    // this changes and gives up (melonDS's own device-approval dialog no
+    // longer applies -- approval belongs entirely to that external
+    // process now). Off by default; env var wins if set, matching every
+    // other flag in this function.
+    bool outOfProcess = getenv("MELONDS_REMOTE_OUT_OF_PROCESS")
+        ? true : globalCfg.GetBool("MelonDSRemote.OutOfProcess");
+    if (outOfProcess)
+    {
+        remoteServer = std::make_unique<melonds_remote_bridge::RemoteServerBridge>(
+            envOr("MELONDS_REMOTE_ADAPTER_SOCKET", "MelonDSRemote.AdapterSocket"));
+        // Always true for this constructor -- see RemoteServerBridge::
+        // start()'s own comment -- but checked anyway rather than
+        // assumed, so this stays correct if that ever changes.
+        if (remoteServer->start()) {
+            Platform::Log(Platform::LogLevel::Info,
+                           "melonds-remote: remote server enabled (out-of-process adapter mode)\n");
+        } else {
+            Platform::Log(Platform::LogLevel::Error,
+                           "melonds-remote: remote server FAILED to start (out-of-process adapter "
+                           "mode)\n");
+            remoteServer.reset();
+        }
+        return;
+    }
+
+    // Where approved device identities are remembered across restarts
+    // (see host/device_approval_manager.h). Defaults under $HOME/.config
+    // so a normal install just works with no extra configuration;
+    // MELONDS_REMOTE_STATE_DIR/MelonDSRemote.StateDir overrides it.
+    std::string approvalStateFilePath;
+    {
+        std::string stateDir = envOr("MELONDS_REMOTE_STATE_DIR", "MelonDSRemote.StateDir");
+        const char* home = getenv("HOME");
+        if (!stateDir.empty())
+            approvalStateFilePath = stateDir + "/approved_devices.txt";
+        else if (home && *home)
+            approvalStateFilePath = std::string(home) + "/.config/melonds-remote/approved_devices.txt";
+    }
+
+    // Tracks which pending device ids a dialog has already been shown
+    // for, so a client's automatic reconnect retries (every few seconds
+    // while awaiting approval) don't keep reopening the prompt. A denied
+    // device stays suppressed for the rest of this *remote-server*
+    // instance's lifetime (deliberately -- an operator who just clicked
+    // Deny shouldn't be nagged again a second later by the same client's
+    // next retry); stopping and starting the remote server again (or
+    // restarting melonDS) clears it. Held by shared_ptr so the callback
+    // (which may outlive any single invocation) keeps it alive.
+    auto shownDeviceIds = std::make_shared<std::unordered_set<std::string>>();
+
+    remoteServer = std::make_unique<melonds_remote_bridge::RemoteServerBridge>(
+        envOr("MELONDS_REMOTE_BIND", "MelonDSRemote.Bind"),
+        envPortOr("MELONDS_REMOTE_CONTROL_PORT", "MelonDSRemote.ControlPort"),
+        envPortOr("MELONDS_REMOTE_INPUT_PORT", "MelonDSRemote.InputPort"),
+        envPortOr("MELONDS_REMOTE_VIDEO_PORT", "MelonDSRemote.VideoPort"),
+        envOr("MELONDS_REMOTE_AUTH_TOKEN", "MelonDSRemote.AuthToken"),
+        approvalStateFilePath,
+        [this, shownDeviceIds](std::vector<melonds_remote::host::DeviceApprovalManager::PendingRequest> requests) {
+            // Fired on NetServer's control thread (or its watchdog
+            // thread, for stale evictions) -- marshal to the Qt UI
+            // thread via qApp (always valid once Qt is up, unlike
+            // mainWindow which isn't created until just below this
+            // block) before touching any widget.
+            QMetaObject::invokeMethod(qApp, [this, shownDeviceIds, requests]() {
+                if (!mainWindow) return;
+
+                if (requests.empty()) {
+                    mainWindow->statusBar()->clearMessage();
+                } else {
+                    mainWindow->statusBar()->showMessage(
+                        QString("DualDeck: %1 pending connection request(s)")
+                            .arg(requests.size()));
+                }
+
+                for (const auto& req : requests) {
+                    if (shownDeviceIds->count(req.deviceId) > 0) continue;
+                    shownDeviceIds->insert(req.deviceId);
+
+                    QMessageBox box(mainWindow);
+                    box.setWindowTitle("DualDeck -- connection request");
+                    box.setText(QString("Allow \"%1\" at %2 to connect?")
+                                    .arg(QString::fromStdString(req.clientName))
+                                    .arg(QString::fromStdString(req.address)));
+                    QPushButton* approveButton = box.addButton("Approve", QMessageBox::YesRole);
+                    box.addButton("Deny", QMessageBox::NoRole);
+                    box.setDefaultButton(approveButton);
+                    box.exec();
+
+                    // remoteServer may have been stopped (e.g. via the
+                    // management listener) while this dialog was open --
+                    // re-check under the lock rather than assuming it's
+                    // still there.
+                    std::lock_guard<std::mutex> innerLock(remoteServerMutex);
+                    if (!remoteServer) continue;
+                    if (box.clickedButton() == approveButton) {
+                        remoteServer->approveDevice(req.deviceId);
+                    } else {
+                        remoteServer->denyDevice(req.deviceId);
+                    }
+                }
+            }, Qt::QueuedConnection);
+        },
+        getenv("MELONDS_REMOTE_NO_DISCOVERY") ? false : globalCfg.GetBool("MelonDSRemote.DiscoveryEnabled"),
+        envPortOr("MELONDS_REMOTE_DISCOVERY_PORT", "MelonDSRemote.DiscoveryPort"),
+        envOr("MELONDS_REMOTE_HOST_NAME", "MelonDSRemote.HostName"),
+        [this, previousScreenSizing = std::make_shared<int>(-1)](bool connected) {
+            // Fired on NetServer's control thread -- marshal to the Qt
+            // UI thread the same way the other remote-server callbacks
+            // above do, before touching mainWindow's config/layout.
+            QMetaObject::invokeMethod(qApp, [this, previousScreenSizing, connected]() {
+                if (!mainWindow) return;
+                Config::Table& windowCfg = mainWindow->getWindowConfig();
+
+                if (connected)
+                {
+                    // Per SPEC.md's "Wii U GamePad" model: the bottom
+                    // screen is going to the client, so showing it here
+                    // too is redundant -- show only the top screen
+                    // locally while someone is actively streaming.
+                    // Remembers whatever was configured before (unless
+                    // it was already TopOnly) so disconnecting restores
+                    // it rather than always resetting to some fixed
+                    // default.
+                    int current = windowCfg.GetInt("ScreenSizing");
+                    if (current != screenSizing_TopOnly)
+                        *previousScreenSizing = current;
+                    windowCfg.SetInt("ScreenSizing", screenSizing_TopOnly);
+                    // stderr (not Platform::Log's stdout) to match
+                    // NetServer's own per-connection-event logging
+                    // convention -- stdout is fully buffered once
+                    // redirected to a file/pipe, so a stdout message
+                    // here could sit unflushed long after the event
+                    // actually happened.
+                    std::fprintf(stderr,
+                                  "melonds-remote: client streaming -- showing top screen only "
+                                  "locally (was ScreenSizing=%d)\n", current);
+                }
+                else if (*previousScreenSizing >= 0)
+                {
+                    std::fprintf(stderr,
+                                  "melonds-remote: client disconnected -- restoring local "
+                                  "ScreenSizing=%d\n", *previousScreenSizing);
+                    windowCfg.SetInt("ScreenSizing", *previousScreenSizing);
+                    *previousScreenSizing = -1;
+                }
+
+                emit mainWindow->screenLayoutChange();
+            }, Qt::QueuedConnection);
+        },
+        envOr("MELONDS_REMOTE_VERSION", "MelonDSRemote.Version"),
+        envPortOr("MELONDS_REMOTE_AUDIO_PORT", "MelonDSRemote.AudioPort"));
+    // Real user report, 2026-08-01: this used to unconditionally log
+    // "enabled" and return, even when the NetServer underneath failed to
+    // bind (e.g. a leftover process -- most plausibly an orphaned
+    // dualdeck-host-service, see docs/known-limitations.md's "orphaned
+    // private host-service" entry -- already listening on one of the
+    // same default ports) -- the only trace of the real failure was a
+    // NetServer stderr line nobody launching via a Steam/EmuDeck
+    // shortcut would ever see. "does not run a server, cannot connect"
+    // with zero visible error is exactly what that produces.
+    if (remoteServer->start()) {
+        Platform::Log(Platform::LogLevel::Info, "melonds-remote: remote server enabled\n");
+    } else {
+        Platform::Log(Platform::LogLevel::Error,
+                       "melonds-remote: remote server FAILED to start -- likely a port already in "
+                       "use by another process (e.g. a leftover dualdeck-host-service); see stderr "
+                       "for exactly which socket failed to bind\n");
+        remoteServer.reset();
+        // Marshaled the same way the pending-approval status message
+        // above is -- mainWindow may not exist yet the first time this
+        // runs (matching that callback's own comment), and this must
+        // never touch a widget off the Qt UI thread.
+        QMetaObject::invokeMethod(qApp, [this]() {
+            if (!mainWindow) return;
+            mainWindow->statusBar()->showMessage(
+                "DualDeck: remote server failed to start -- a port it needs is already in use "
+                "(see the log for details)",
+                10000);
+        }, Qt::QueuedConnection);
+    }
+}
+
+void EmuInstance::stopRemoteServer()
+{
+    std::lock_guard<std::mutex> lock(remoteServerMutex);
+    if (!remoteServer) return;
+    remoteServer.reset();
+    Platform::Log(Platform::LogLevel::Info, "melonds-remote: remote server disabled\n");
+}
+
+bool EmuInstance::remoteServerRunning()
+{
+    std::lock_guard<std::mutex> lock(remoteServerMutex);
+    return remoteServer != nullptr;
+}
