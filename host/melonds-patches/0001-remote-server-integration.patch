+
+namespace melonds_remote_bridge {
+
+void MelonDSInputSink::applyControllerState(const melonds_remote::ControllerState& state) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    state_ = state;
+}
+
+void MelonDSInputSink::releaseAll() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    state_ = melonds_remote::InputStateTracker::releasedState();
+}
+
+melonds_remote::ControllerState MelonDSInputSink::latestState() const {
+    std::lock_guard<std::mutex> lock(mutex_);
