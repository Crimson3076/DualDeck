@@ -0,0 +1,47 @@
+#pragma once
+
+// melonDS's implementation of dualdeck::adapter::IEmulatorAdapter
+// (GitHub issue #28) -- the "reference implementation" the ADR
+// (docs/adr/0001-host-service-and-adapter-architecture.md) describes.
+// Wraps the same MelonDSInputSink/MelonDSFrameSource this patch already
+// used directly (unchanged, see their own headers), translating between
+// them and the generic adapter contract so RemoteServerBridge can hand a
+// single IEmulatorAdapter to host::AdapterBridge instead of exposing
+// MelonDSInputSink/MelonDSFrameSource as IEmulatorInputSink/IFrameSource
+// itself. Still runs entirely in-process, still fed by the exact same
+// NetServer as before -- see RemoteServerBridge.h/.cpp for how the
+// pieces connect. Out-of-process operation (this adapter connected to a
+// separately-running Host Service over adapter-sdk/ipc/) is a distinct,
+// larger follow-up milestone, not attempted by this class.
+
+#include <cstddef>
+#include <cstdint>
+
+#include "MelonDSFrameSource.h"
+#include "MelonDSInputSink.h"
+#include "dualdeck/adapter/adapter_contract.h"
+
+namespace dualdeck_bridge {
+
+class MelonDSAdapter : public dualdeck::adapter::IEmulatorAdapter {
+public:
+    dualdeck::adapter::AdapterCapabilities capabilities() const override;
+    dualdeck::adapter::SessionState currentState() const override;
+    void applyGenericInput(const dualdeck::adapter::GenericInputState& state) override;
+    void releaseAllInputs() override;
+    bool latestFrame(const std::string& surfaceId, dualdeck::adapter::SurfaceFrame& outFrame) override;
+
+    // Non-contract pass-throughs RemoteServerBridge calls directly (the
+    // adapter contract itself has no "push a frame in" or "read the
+    // merged controller state back out" method -- those stay exactly
+    // the same shape they were before this class existed, see
+    // MelonDSFrameSource::pushFrame()/MelonDSInputSink::latestState()).
+    void pushFrame(const void* bgraData, size_t sizeBytes, uint16_t width, uint16_t height);
+    dualdeck::ControllerState latestControllerState() const;
+
+private:
+    MelonDSInputSink inputSink_;
+    MelonDSFrameSource frameSource_;
+};
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/MelonDSFrameSource.cpp b/src/frontend/qt_sdl/remote_server/MelonDSFrameSource.cpp
new file mode 100644
index 0000000..0806357
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/MelonDSFrameSource.cpp
@@ -0,0 +1,36 @@
+#include "MelonDSFrameSource.h"
+
+#include <cstring>
+
+namespace dualdeck_bridge {
+
+void MelonDSFrameSource::pushFrame(const void* bgraData, size_t sizeBytes, uint16_t width,
+                                    uint16_t height) {
+    if (bgraData == nullptr ||
+        sizeBytes != static_cast<size_t>(width) * static_cast<size_t>(height) * 4) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    latestFrame_.resize(sizeBytes);
+    std::memcpy(latestFrame_.data(), bgraData, sizeBytes);
+    width_ = width;
+    height_ = height;
+    ++frameIndex_;
+    hasFrame_ = true;
+}
+
+bool MelonDSFrameSource::getLatestFrame(std::vector<uint8_t>& outFrame, uint64_t& outFrameIndex,
+                                         uint16_t& outWidth, uint16_t& outHeight) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!hasFrame_) {
+        return false;
+    }
+    outFrame = latestFrame_;
+    outFrameIndex = frameIndex_;
+    outWidth = width_;
+    outHeight = height_;
+    return true;
+}
+
+} // namespace dualdeck_bridge
diff --git a/src/frontend/qt_sdl/remote_server/MelonDSFrameSource.h b/src/frontend/qt_sdl/remote_server/MelonDSFrameSource.h
new file mode 100644
index 0000000..d43e29a
--- /dev/null
+++ b/src/frontend/qt_sdl/remote_server/MelonDSFrameSource.h
@@ -0,0 +1,46 @@
+#pragma once
+
+// Push-driven IFrameSource: EmuThread calls pushFrame() once per emulated
+// frame (software renderer directly, or GLBottomScreenCapture's readback
+// for the OpenGL/OpenGLCompute 3D renderer) right after
+// GPU::GetFramebuffers(), and NetServer's video thread calls
+// getLatestFrame() to pull the newest one. Same single-slot, mutex-guarded,
+// latest-wins shape as the standalone prototype's SyntheticFrameSource
+// (see melonds-remote's host/remote-server), but produced by the real
+// emulation thread instead of a self-timed generator thread.
+
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+#include "host/frame_source.h"
+
+namespace dualdeck_bridge {
+
+class MelonDSFrameSource : public dualdeck::host::IFrameSource {
+public:
+    // Copies `sizeBytes` bytes from `bgraData` into the single-slot
+    // buffer, tagged with this frame's actual width/height. Silently
+    // ignored if sizeBytes doesn't equal width*height*4 (BGRA8888) --
+    // the software renderer always pushes native DS resolution, but the
+    // OpenGL renderer's capture can be any resolution melonDS's own 3D
+    // upscale setting produces (see GLBottomScreenCapture), so this
+    // checks the actual claimed size rather than assuming
+    // dualdeck::host::kFrameSizeBytes the way it used to when
+    // every pushed frame was native resolution.
+    void pushFrame(const void* bgraData, size_t sizeBytes, uint16_t width, uint16_t height);
+
+    bool getLatestFrame(std::vector<uint8_t>& outFrame, uint64_t& outFrameIndex,
+                         uint16_t& outWidth, uint16_t& outHeight) override;
+
+private:
+    std::mutex mutex_;
+    std::vector<uint8_t> latestFrame_;
+    uint16_t width_ = static_cast<uint16_t>(dualdeck::host::kFrameWidth);
+    uint16_t height_ = static_cast<uint16_t>(dualdeck::host::kFrameHeight);
+    uint64_t frameIndex_ = 0;
+    bool hasFrame_ = false;
+};
+
+} // namespace dualdeck_bridge
