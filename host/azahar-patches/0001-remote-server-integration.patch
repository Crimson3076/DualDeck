+    RemoteServerBridge(Core::System& system, std::string azaharVersion,
+                       std::string adapterSocketPath, GMainWindow* mainWindow);
+    ~RemoteServerBridge();
+
+    RemoteServerBridge(const RemoteServerBridge&) = delete;
+    RemoteServerBridge& operator=(const RemoteServerBridge&) = delete;
+
+    void start();
+    void stop();
+
+private:
+    std::unique_ptr<AzaharAdapter> adapter_;
+    std::unique_ptr<melonds_remote::adapter::ipc::AdapterIpcClient> ipcClient_;
+    std::thread reconnectThread_;
+    std::atomic<bool> stopRequested_{false};
