+void GMainWindow::OnRemoteClientConnectionChanged(bool connected) {
+    // Per SPEC.md's "Wii U GamePad" model: the bottom screen is going to
+    // the client, so showing it here too locally is redundant -- matches
+    // melonDS's own EmuInstance::startRemoteServer() behavior for the
+    // same reason. Sequence (set layout_option, SyncMenuUISettings(),
+    // ApplySettings(), UpdateSecondaryWindowVisibility()) mirrors
+    // ChangeScreenLayout() above exactly, since that's this codebase's
+    // own real, working "the layout changed live" path -- not invented
+    // fresh here. swap_screen is saved/forced too, not just
+    // layout_option: SingleScreen alone still shows whichever screen
+    // swap_screen says is primary, and forcing only layout_option would
+    // show the *bottom* screen locally instead of the top if the user
+    // had swap_screen on, which is exactly the redundant case this
+    // exists to avoid.
+    if (connected) {
+        Settings::LayoutOption current = Settings::values.layout_option.GetValue();
+        bool currentSwap = Settings::values.swap_screen.GetValue();
+        if (current != Settings::LayoutOption::SingleScreen || currentSwap) {
+            remote_client_previous_layout_option = static_cast<int>(current);
+            remote_client_previous_swap_screen = currentSwap;
+            remote_client_have_saved_layout = true;
+        }
+        Settings::values.layout_option = Settings::LayoutOption::SingleScreen;
+        Settings::values.swap_screen = false;
+    } else if (remote_client_have_saved_layout) {
+        Settings::values.layout_option = static_cast<Settings::LayoutOption>(remote_client_previous_layout_option);
+        Settings::values.swap_screen = remote_client_previous_swap_screen;
+        remote_client_have_saved_layout = false;
+    }
+
+    SyncMenuUISettings();
+    system.ApplySettings();
+    UpdateSecondaryWindowVisibility();
+}
