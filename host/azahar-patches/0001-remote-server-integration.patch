new file mode 100644
index 000000000..6a8439675
--- /dev/null
+++ b/src/citra_qt/remote_server/AzaharAdapter.cpp
@@ -0,0 +1,454 @@
+#include "citra_qt/remote_server/AzaharAdapter.h"
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+
+#include "common/param_package.h"
+#include "common/settings.h"
+#include "core/3ds.h"
+#include "core/core.h"
+#include "core/frontend/framebuffer_layout.h"
+#include "core/hle/service/hid/hid.h"
+#include "video_core/gpu.h"
+#include "video_core/renderer_base.h"
+
+namespace CitraQt::RemoteServer {
+
+namespace {
+
+constexpr const char* kInputEngineName = "melonds_remote";
+
+// Defaults to 60fps (up from an earlier, untested-on-real-hardware 30fps
+// guess -- see docs/history.md's performance-tuning entry in
+// the DualDeck repo this was vendored from): real playtest data showed
+// zero RequestScreenshot() timeouts at 30fps with plenty of headroom, so
+// 60 was the obvious next thing to try. Overridable via
+// AZAHAR_REMOTE_CAPTURE_FPS so this can be tuned per-machine without a
+// new host build for every value -- e.g. a lower-end system might need
+// to drop back down if 60 turns out to visibly stall the game itself
+// (RequestScreenshot() can force a GPU sync on some backends/paths).
+// Clamped to [1, 60]: below 1 doesn't make sense, and there's no benefit
+// polling faster than a real display's own refresh rate -- it would
+// just be extra GPU syncs for frames that don't exist yet.
+std::chrono::milliseconds resolveCaptureInterval() {
+    int fps = 60;
+    if (const char* env = std::getenv("AZAHAR_REMOTE_CAPTURE_FPS")) {
+        int parsed = std::atoi(env);
+        if (parsed > 0) {
+            fps = std::clamp(parsed, 1, 60);
+        }
+    }
+    return std::chrono::milliseconds(1000 / fps);
+}
+
+// Defaults to following Azahar's own resolution_factor setting instead
+// of always native -- real feedback found the earlier "always native
+// unless you know a separate env var exists" default surprising: setting
+// resolution_factor to a high value in Azahar's own graphics settings
+// visibly had no effect on the stream at all. AZAHAR_REMOTE_CAPTURE_SCALE
+// still overrides this explicitly for anyone who wants a sharper *local*
+// picture than is worth streaming over their particular link -- a more
+// affordable ask now than when this default was first written, since
+// every frame is JPEG-compressed (DualDeck's host/remote-server) before
+// it goes out over the wire, rather than sent raw.
+// resolution_factor's own 0 ("Auto (Window Size)") is resolved via
+// GetResolutionScaleFactor() the same way the renderer itself resolves
+// it (video_core/renderer_base.cpp), not reimplemented here -- calling
+// this from AzaharAdapter's constructor is safe because RemoteServerBridge
+// (and so this adapter) is only ever constructed after BootGame() has
+// already loaded the ROM and created the renderer (see citra_qt.cpp),
+// the same precondition RequestScreenshot() below already relies on.
+// Clamped to [1, 10], matching resolution_factor's own valid range
+// (common/settings.h).
+int resolveCaptureScale(Core::System& system) {
+    if (const char* env = std::getenv("AZAHAR_REMOTE_CAPTURE_SCALE")) {
+        int parsed = std::atoi(env);
+        if (parsed > 0) {
+            return std::clamp(parsed, 1, 10);
+        }
+    }
+    const u32 factor = system.GPU().Renderer().GetResolutionScaleFactor();
+    return std::clamp(static_cast<int>(factor), 1, 10);
+}
+
+// Mirrors host/adapter_bridge.cpp's dsButtonsToGenericButtons() table --
+// deliberately explicit, not a bit-shift trick, for the same reason
+// that file's comment gives (getting this silently wrong swaps which
+// physical button does what). Index matches Settings::NativeButton's
+// first 12 entries (A, B, X, Y, Up, Down, Left, Right, L, R, Start,
+// Select) -- confirmed by reading settings.h, not assumed -- which is
+// also the same physical-button order protocol.h's DSButton uses, so
+// this table is deliberately parallel to (not derived from) the one
+// host/adapter_bridge.cpp already has for melonDS.
+//
+// X/Y are straight here (West -> X, North -> Y), like every other
+// entry. Between 2026-08-03 and 2026-08-04 they were deliberately
+// cross-wired to compensate for Steam Input's default template for
+// the DualDeck Client's shortcut, which reports the physical X/Y
+// face buttons swapped (SDL_GAMEPAD_BUTTON_WEST firing for a
+// physical Y press and vice versa) -- confirmed at the time by the
+// reporting user's screenshot of the action-set legend.
+//
+// That compensation is gone now, not because the quirk was imagined,
+// but because the client corrects the same symptom one layer earlier:
+// kButtonMappings maps SDL's positional SOUTH/EAST/WEST/NORTH onto
+// the DS button in the matching physical position (SPEC.md 7.3), so
+// every emulator benefits, not just the one carrying a compensating
+// table. With both in place the swap was applied twice -- real user
+// report, 2026-08-04: melonDS came out correct while Azahar's X/Y
+// were flipped, exactly because melonDS has no table like this and
+// Azahar did. Fixing it upstream also retires the old tradeoff, where
+// anyone without that Steam Input quirk saw X/Y wrong the other way.
+// See docs/history.md's 2026-08-03 and 2026-08-04 entries.
+constexpr std::array<uint32_t, 12> kNativeButtonToGenericBit = {
+    melonds_remote::adapter::GenericButton_South,     // A
+    melonds_remote::adapter::GenericButton_East,      // B
+    melonds_remote::adapter::GenericButton_West,      // X (see comment above)
+    melonds_remote::adapter::GenericButton_North,     // Y (see comment above)
+    melonds_remote::adapter::GenericButton_DpadUp,    // Up
+    melonds_remote::adapter::GenericButton_DpadDown,  // Down
+    melonds_remote::adapter::GenericButton_DpadLeft,  // Left
+    melonds_remote::adapter::GenericButton_DpadRight, // Right
+    melonds_remote::adapter::GenericButton_L1,        // L
+    melonds_remote::adapter::GenericButton_R1,        // R
+    melonds_remote::adapter::GenericButton_Start,     // Start
+    melonds_remote::adapter::GenericButton_Select,    // Select
+};
+
+class RemoteButtonFactory final : public Input::Factory<Input::ButtonDevice> {
+public:
+    explicit RemoteButtonFactory(std::shared_ptr<RemoteInputStatus> status)
+        : status_(std::move(status)) {}
+    std::unique_ptr<Input::ButtonDevice> Create(const Common::ParamPackage& params) override {
+        const int index = params.Get("button", 0);
+        const uint32_t bit = (index >= 0 && index < static_cast<int>(kNativeButtonToGenericBit.size()))
+                                  ? kNativeButtonToGenericBit[static_cast<size_t>(index)]
+                                  : 0;
+        return std::make_unique<RemoteButtonDevice>(status_, bit);
+    }
+
+private:
+    std::shared_ptr<RemoteInputStatus> status_;
+};
+
+class RemoteAnalogFactory final : public Input::Factory<Input::AnalogDevice> {
+public:
+    explicit RemoteAnalogFactory(std::shared_ptr<RemoteInputStatus> status)
+        : status_(std::move(status)) {}
+    std::unique_ptr<Input::AnalogDevice> Create(const Common::ParamPackage& params) override {
+        // index 0 = circle pad (leftStick), 1 = c-stick (rightStick, New3DS only) --
+        // see Settings::NativeAnalog::Values.
+        const int index = params.Get("index", 0);
+        return std::make_unique<RemoteAnalogDevice>(status_, index != 0);
+    }
+
+private:
+    std::shared_ptr<RemoteInputStatus> status_;
+};
+
+class RemoteTouchFactory final : public Input::Factory<Input::TouchDevice> {
+public:
+    explicit RemoteTouchFactory(std::shared_ptr<RemoteInputStatus> status)
+        : status_(std::move(status)) {}
+    std::unique_ptr<Input::TouchDevice> Create(const Common::ParamPackage&) override {
+        return std::make_unique<RemoteTouchDevice>(status_);
+    }
+
+private:
+    std::shared_ptr<RemoteInputStatus> status_;
+};
+
+std::string paramString(std::initializer_list<Common::ParamPackage::DataType::value_type> fields) {
+    return Common::ParamPackage(fields).Serialize();
+}
+
+} // namespace
+
+AzaharAdapter::AzaharAdapter(Core::System& system, std::string azaharVersion,
+                             std::function<void()> onQuitSession, std::function<void()> onQuitApplication)
+    : system_(system), azaharVersion_(std::move(azaharVersion)), onQuitSession_(std::move(onQuitSession)),
+      onQuitApplication_(std::move(onQuitApplication)), inputStatus_(std::make_shared<RemoteInputStatus>()),
+      captureInterval_(resolveCaptureInterval()), captureScale_(resolveCaptureScale(system)) {
+    registerInputEngine();
+    running_ = true;
+    captureThread_ = std::thread(&AzaharAdapter::captureLoop, this);
+}
+
+AzaharAdapter::~AzaharAdapter() {
+    running_ = false;
+    if (captureThread_.joinable()) {
+        captureThread_.join();
+    }
+    unregisterInputEngine();
+}
+
+void AzaharAdapter::registerInputEngine() {
+    Input::RegisterFactory<Input::ButtonDevice>(kInputEngineName,
+                                                std::make_shared<RemoteButtonFactory>(inputStatus_));
+    Input::RegisterFactory<Input::AnalogDevice>(kInputEngineName,
+                                                std::make_shared<RemoteAnalogFactory>(inputStatus_));
+    Input::RegisterFactory<Input::TouchDevice>(kInputEngineName,
+                                               std::make_shared<RemoteTouchFactory>(inputStatus_));
+
+    // Overwrite the active input profile so the HID service actually
+    // reads through our engine instead of whatever local input backend
+    // was previously configured -- same "this session is remote-driven
+    // now" precedence every other DualDeck emulator integration already
+    // gives the network input over local input while a client is
+    // connected.
+    for (int i = 0; i < static_cast<int>(kNativeButtonToGenericBit.size()); ++i) {
+        Settings::values.current_input_profile.buttons[static_cast<size_t>(i)] =
+            paramString({{"engine", kInputEngineName}, {"button", std::to_string(i)}});
+    }
+    Settings::values.current_input_profile.analogs[Settings::NativeAnalog::CirclePad] =
+        paramString({{"engine", kInputEngineName}, {"index", "0"}});
+    Settings::values.current_input_profile.analogs[Settings::NativeAnalog::CStick] =
+        paramString({{"engine", kInputEngineName}, {"index", "1"}});
+    Settings::values.current_input_profile.touch_device = paramString({{"engine", kInputEngineName}});
+}
+
+void AzaharAdapter::unregisterInputEngine() {
+    Input::UnregisterFactory<Input::ButtonDevice>(kInputEngineName);
+    Input::UnregisterFactory<Input::AnalogDevice>(kInputEngineName);
+    Input::UnregisterFactory<Input::TouchDevice>(kInputEngineName);
+}
+
+melonds_remote::adapter::AdapterCapabilities AzaharAdapter::capabilities() const {
+    melonds_remote::adapter::AdapterCapabilities caps;
+    caps.system = melonds_remote::SystemIdentity{"3ds", "Nintendo 3DS"};
+    caps.adapter = melonds_remote::AdapterIdentity{"azahar", "Azahar", azaharVersion_};
+
+    melonds_remote::adapter::VideoSurfaceDescriptor bottom;
+    bottom.surfaceId = kBottomSurfaceId;
+    bottom.role = melonds_remote::adapter::SurfaceRole::Bottom;
+    // Reports whatever captureLoop() actually produces (native *
+    // captureScale_), not always the fixed native constants -- the
+    // client already resizes its texture to whatever width/height a
+    // HelloAck reports (see client/src/main.cpp's host-resize handling),
+    // so this alone is enough to stream at a higher-than-native
+    // resolution with no client-side change needed.
+    bottom.width = kBottomScreenWidth * captureScale_;
+    bottom.height = kBottomScreenHeight * captureScale_;
+    bottom.pixelFormat = melonds_remote::adapter::PixelFormat::Bgra8888;
+    bottom.touchSupported = true;
+    // Touch precision is defined by the 3DS's own native touch-screen
+    // coordinate space (see applyGenericInput()'s touch handling, which
+    // works in normalized 0..1 fractions regardless of surface pixel
+    // size) -- deliberately NOT scaled by captureScale_, unlike
+    // width/height above, since a higher-resolution video capture
+    // doesn't change how precisely the touch digitizer itself can report
+    // a position.
+    bottom.touchRangeX = kBottomScreenWidth - 1;
+    bottom.touchRangeY = kBottomScreenHeight - 1;
+    bottom.required = true;
+    bottom.remotelyDisplayed = true;
+    bottom.nominalFps = 30; // see captureLoop()'s comment on why 30, not 60
+    bottom.maxFps = 30;
+    caps.surfaces.push_back(bottom);
+
+    return caps;
+}
+
+melonds_remote::adapter::SessionState AzaharAdapter::currentState() const {
+    return running_.load() ? melonds_remote::adapter::SessionState::Running
+                            : melonds_remote::adapter::SessionState::Stopped;
+}
+
+void AzaharAdapter::applyGenericInput(const melonds_remote::adapter::GenericInputState& state) {
+    {
+        std::lock_guard guard(inputStatus_->mutex);
+        inputStatus_->buttons = state.buttons;
+        inputStatus_->leftStickX = state.leftStickX;
+        inputStatus_->leftStickY = state.leftStickY;
+        inputStatus_->rightStickX = state.rightStickX;
+        inputStatus_->rightStickY = state.rightStickY;
+        if (!state.touches.empty()) {
+            // Only the first touch contact -- the 3DS bottom screen (like
+            // the DS's) only ever has one touch point, matching
+            // protocol.h's ControllerState.touchX/Y single-contact model
+            // this state was translated from (see host/adapter_bridge.cpp).
+            const auto& touch = state.touches.front();
+            // protocol.h's touchX/Y are 0..kTouchMaxX/kTouchMaxY (the DS's
+            // native touch range, 255x191) regardless of which adapter is
+            // actually driving the session -- reinterpreted here as a
+            // proportional 0..1 position within whatever surface it's
+            // actually addressed to, not literally "DS pixel space". See
+            // AzaharAdapter.h's RemoteTouchDevice comment for the 0..1
+            // convention src/core/hle/service/hid/hid.cpp's touch handling
+            // itself expects.
+            inputStatus_->touchX =
+                static_cast<float>(touch.x) / static_cast<float>(melonds_remote::kTouchMaxX);
+            inputStatus_->touchY =
+                static_cast<float>(touch.y) / static_cast<float>(melonds_remote::kTouchMaxY);
+            inputStatus_->touchActive = true;
+        } else {
+            inputStatus_->touchActive = false;
+        }
+    }
+
+    // GitHub issue #25 (as implemented for melonDS's own
+    // EmuInstanceInput.cpp): client-side "exit emulation" menu, letting
+    // the user eject the ROM (QuitSession) or close Azahar entirely
+    // (QuitApplication) without needing to be at the host. Edge-detected
+    // against lastEmulatorActions_, not "bit is set this frame" -- the
+    // client resends its confirmed choice for a short window to survive
+    // UDP loss, not just one packet (see client/src/main.cpp's
+    // pendingEmulatorAction), so a naive "is the bit set" check here
+    // would fire the callback repeatedly for one menu confirmation.
+    // Outside inputStatus_'s lock, and via the injected callbacks (never
+    // called directly) since this runs on AdapterIpcClient's readLoop()
+    // thread, not Qt's UI thread -- see AzaharAdapter.h's constructor
+    // comment and RemoteServerBridge.cpp's QMetaObject::invokeMethod use.
+    uint32_t risingEdge = state.emulatorActions & ~lastEmulatorActions_;
+    if ((risingEdge & melonds_remote::adapter::GenericAction_QuitSession) && onQuitSession_) {
+        onQuitSession_();
+    }
+    if ((risingEdge & melonds_remote::adapter::GenericAction_QuitApplication) && onQuitApplication_) {
+        onQuitApplication_();
+    }
+    lastEmulatorActions_ = state.emulatorActions;
+}
+
+void AzaharAdapter::releaseAllInputs() {
+    std::lock_guard guard(inputStatus_->mutex);
+    inputStatus_->buttons = 0;
+    inputStatus_->leftStickX = 0;
+    inputStatus_->leftStickY = 0;
+    inputStatus_->rightStickX = 0;
+    inputStatus_->rightStickY = 0;
+    inputStatus_->touchActive = false;
+}
+
+bool AzaharAdapter::latestFrame(const std::string& surfaceId,
+                                melonds_remote::adapter::SurfaceFrame& outFrame) {
+    if (surfaceId != kBottomSurfaceId) {
+        return false;
+    }
+    std::lock_guard guard(frameMutex_);
+    if (!hasFrame_) {
+        return false;
+    }
+    outFrame.surfaceId = kBottomSurfaceId;
+    outFrame.frameIndex = frameIndex_;
+    // Contract v2: same width/height captureLoop() itself captures at and
+    // capabilities() declares -- captureScale_ is fixed for this adapter's
+    // whole lifetime, so this is always consistent (see
+    // adapter_contract.h's SurfaceFrame comment for why other adapters,
+    // e.g. Cemu's, can't make the same claim).
+    outFrame.width = static_cast<uint16_t>(kBottomScreenWidth * captureScale_);
+    outFrame.height = static_cast<uint16_t>(kBottomScreenHeight * captureScale_);
+    outFrame.pixels = latestFrame_;
+    return true;
+}
+
+void AzaharAdapter::captureLoop() {
+    const int width = kBottomScreenWidth * captureScale_;
+    const int height = kBottomScreenHeight * captureScale_;
+    std::vector<uint8_t> buffer(static_cast<size_t>(width) * height * 4);
+    // swapped=true -> bottom screen only (see SingleFrameLayout's
+    // implementation in framebuffer_layout.cpp, confirmed by reading
+    // it: FramebufferLayout{..., top_screen_enabled=!swapped,
+    // bottom_screen_enabled=swapped, ...}). Native 3DS bottom-screen
+    // resolution unless AZAHAR_REMOTE_CAPTURE_SCALE says otherwise (see
+    // resolveCaptureScale()) -- this is what gets streamed over the
+    // network, not what the host's own window shows.
+    const Layout::FramebufferLayout layout =
+        Layout::SingleFrameLayout(width, height, /*swapped=*/true, /*upright=*/false);
+
+    // Diagnostic counters, logged every ~5s (see below) -- captureLoop()
+    // had no visibility at all into whether RequestScreenshot() was
+    // actually succeeding, so a silent, total capture failure (every
+    // single request timing out) looked identical, from the host's own
+    // NetServer stats, to "nothing is even trying": both show
+    // "video: sent=0". This makes that distinction visible on Azahar's
+    // own stderr instead.
+    uint64_t attempts = 0;
+    uint64_t successes = 0;
+    uint64_t timeouts = 0;
+    auto lastLogTime = std::chrono::steady_clock::now();
+
+    while (running_.load()) {
+        std::mutex doneMutex;
+        std::condition_variable doneCv;
+        bool done = false;
+        bool invertY = false;
+        ++attempts;
+
+        system_.GPU().Renderer().RequestScreenshot(
+            buffer.data(),
+            // The bool here is NOT a success flag (a real bug in an
+            // earlier version of this function, only surfaced once a
+            // user actually ran this on real hardware with the Vulkan
+            // backend): it's invert_y, the same parameter
+            // GRenderWindow::CaptureScreenshot() (bootmanager.cpp)
+            // passes straight to GetMirroredImage() before saving a
+            // screenshot. OpenGL's RenderScreenshot() always passes
+            // true (glReadPixels() returns bottom-up rows), Vulkan's
+            // always passes false (its rows are already top-down) --
+            // treating "false" as "failed" meant every Vulkan frame
+            // was silently dropped, while OpenGL frames were kept
+            // without ever actually being flipped. The callback firing
+            // at all (barring RequestScreenshot() ignoring an
+            // already-in-flight request, see renderer_base.cpp) is the
+            // real success signal.
+            [&](bool invert_y) {
+                std::lock_guard lock(doneMutex);
+                invertY = invert_y;
+                done = true;
+                doneCv.notify_one();
+            },
+            layout);
+
+        {
+            std::unique_lock lock(doneMutex);
+            // Bounded wait, not indefinite: if emulation is paused or
+            // between frames for any other reason, the renderer may
+            // never get around to servicing this request, and this
+            // thread must still be able to notice running_ became
+            // false and exit promptly rather than hang the destructor's
+            // join().
+            doneCv.wait_for(lock, std::chrono::milliseconds(500), [&] { return done; });
+        }
+
+        if (done) {
+            ++successes;
+            if (invertY) {
+                // Flip rows in place so latestFrame_ is always top-down
+                // regardless of which renderer backend captured it --
+                // see the comment above on why this is needed for
+                // OpenGL specifically.
+                const size_t rowBytes = static_cast<size_t>(width) * 4;
+                for (int row = 0; row < height / 2; ++row) {
+                    const int mirrorRow = height - 1 - row;
+                    std::swap_ranges(buffer.begin() + static_cast<size_t>(row) * rowBytes,
+                                      buffer.begin() + static_cast<size_t>(row + 1) * rowBytes,
+                                      buffer.begin() + static_cast<size_t>(mirrorRow) * rowBytes);
+                }
+            }
+            std::lock_guard<std::mutex> frameLock(frameMutex_);
+            latestFrame_ = buffer;
+            ++frameIndex_;
+            hasFrame_ = true;
+        } else {
+            ++timeouts;
+        }
+
+        auto now = std::chrono::steady_clock::now();
+        if (now - lastLogTime >= std::chrono::seconds(5)) {
+            std::fprintf(stderr,
+                          "AzaharAdapter: capture stats -- target=%lldms/frame attempts=%llu succeeded=%llu "
+                          "timed_out=%llu (last invert_y=%s)\n",
+                          static_cast<long long>(captureInterval_.count()),
+                          static_cast<unsigned long long>(attempts), static_cast<unsigned long long>(successes),
+                          static_cast<unsigned long long>(timeouts), done ? (invertY ? "true" : "false") : "n/a");
+            lastLogTime = now;
+        }
+
+        std::this_thread::sleep_for(captureInterval_);
+    }
+}
+
+} // namespace CitraQt::RemoteServer
diff --git a/src/citra_qt/remote_server/AzaharAdapter.h b/src/citra_qt/remote_server/AzaharAdapter.h
new file mode 100644
index 000000000..b34a559c3
--- /dev/null
+++ b/src/citra_qt/remote_server/AzaharAdapter.h
@@ -0,0 +1,207 @@
+#pragma once
+
+// DualDeck's IEmulatorAdapter implementation for Azahar (Nintendo 3DS).
+// See docs/azahar-integration-analysis.md (in the DualDeck repo, not
+// this one) for the Phase 0 investigation this is built from, and
+// docs/adr/0001-host-service-and-adapter-architecture.md's AzaharAdapter
+// section for the design decisions summarized here.
+//
+// Unlike melonDS's own default in-process RemoteServerBridge (which owns
+// a full NetServer, discovery, and device-approval), this adapter only
+// ever runs out-of-process: it wraps itself in an
+// melonds_remote::adapter::ipc::AdapterIpcClient and connects out to an
+// already-running standalone melonds-remote-server (the same Host
+// Service GitHub issue #4's host-control mode already uses). This
+// avoids reimplementing NetServer's device-approval Qt dialog a second
+// time for a second emulator -- authentication for this path is a
+// static shared token, same trade-off already made and documented for
+// host-control mode.
+//
+// Two responsibilities:
+//  1. Video: periodically requests a bottom-screen-only screenshot via
+//     VideoCore::RendererBase::RequestScreenshot() (backend-agnostic
+//     across the software/OpenGL/Vulkan renderers -- see the analysis
+//     doc's section 1), storing the result as this adapter's one
+//     "bottom" surface.
+//  2. Input: registers a custom Input::Factory engine ("melonds_remote")
+//     for buttons/circle-pad/c-stick/touch, and points
+//     Settings::values.current_input_profile at it -- see the analysis
+//     doc's section 2 for why this is the idiomatic Azahar integration
+//     point (the same mechanism input_common's sdl/udp backends use).
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include "core/frontend/input.h"
+#include "melonds_remote/adapter/adapter_contract.h"
+
+namespace Core {
+class System;
+}
+
+namespace CitraQt::RemoteServer {
+
+// 3DS bottom (touch) screen native resolution -- see Core::kScreenBottomWidth/
+// Core::kScreenBottomHeight (src/core/3ds.h). Streamed to the DualDeck
+// client the same way melonDS streams the DS's bottom screen; the top
+// (3D) screen stays on the host's own display, matching this project's
+// existing "host shows one screen, client shows the other" model.
+inline constexpr int kBottomScreenWidth = 320;
+inline constexpr int kBottomScreenHeight = 240;
+inline constexpr const char* kBottomSurfaceId = "bottom";
+
+// Shared, mutex-protected input state read by the registered Input
+// devices below and written by AzaharAdapter::applyGenericInput(). A
+// separate struct (rather than storing GenericInputState directly)
+// because the button/analog/touch devices need cheap, lock-scoped reads
+// of just their own field on every HID poll (~every frame), not the
+// whole adapter object.
+struct RemoteInputStatus {
+    std::mutex mutex;
+    uint32_t buttons = 0; // GenericButton bitmask
+    int16_t leftStickX = 0;
+    int16_t leftStickY = 0;
+    int16_t rightStickX = 0;
+    int16_t rightStickY = 0;
+    bool touchActive = false;
+    float touchX = 0.0f; // normalized 0..1, see AzaharAdapter.cpp's touch-coordinate comment
+    float touchY = 0.0f;
+};
+
+// One native 3DS button (A/B/X/Y/Up/Down/Left/Right/L/R/Start/Select --
+// see Settings::NativeButton::Values). Reads a single GenericButton bit
+// out of the shared RemoteInputStatus via a fixed index this file's
+// .cpp assigns at registration time, mirroring
+// host/adapter_bridge.cpp's explicit dsButtonsToGenericButtons() table
+// (never a raw bit-shift trick, for the same "getting this silently
+// wrong swaps which button does what" reason that file's comment gives).
+class RemoteButtonDevice final : public Input::ButtonDevice {
+public:
+    RemoteButtonDevice(std::shared_ptr<RemoteInputStatus> status, uint32_t genericBit)
+        : status_(std::move(status)), genericBit_(genericBit) {}
+    bool GetStatus() const override {
+        std::lock_guard guard(status_->mutex);
+        return (status_->buttons & genericBit_) != 0;
+    }
+
+private:
+    std::shared_ptr<RemoteInputStatus> status_;
+    uint32_t genericBit_;
+};
+
+// One of the 3DS's two analog sticks (circle pad or, New3DS-only, the
+// c-stick -- see Settings::NativeAnalog::Values). GetStatus() returns
+// (x, y) in the -1..1 range src/core/hle/service/hid/hid.cpp's
+// Module::UpdatePadCallback() expects (confirmed by reading that
+// function, not assumed) -- our wire-format leftStickX/Y/rightStickX/Y
+// are int16_t (-32768..32767, see protocol.h's ControllerState), so
+// this just divides by 32768.
+class RemoteAnalogDevice final : public Input::AnalogDevice {
+public:
+    RemoteAnalogDevice(std::shared_ptr<RemoteInputStatus> status, bool isRightStick)
+        : status_(std::move(status)), isRightStick_(isRightStick) {}
+    std::tuple<float, float> GetStatus() const override {
+        std::lock_guard guard(status_->mutex);
+        int16_t x = isRightStick_ ? status_->rightStickX : status_->leftStickX;
+        int16_t y = isRightStick_ ? status_->rightStickY : status_->leftStickY;
+        return {static_cast<float>(x) / 32768.0f, static_cast<float>(y) / 32768.0f};
+    }
+
+private:
+    std::shared_ptr<RemoteInputStatus> status_;
+    bool isRightStick_;
+};
+
+// The 3DS's single bottom-screen touch point. GetStatus() returns
+// (x, y, pressed) normalized 0..1 -- confirmed against
+// src/core/hle/service/hid/hid.cpp's touch handling, which multiplies
+// by Core::kScreenBottomWidth/Height itself.
+class RemoteTouchDevice final : public Input::TouchDevice {
+public:
+    explicit RemoteTouchDevice(std::shared_ptr<RemoteInputStatus> status)
+        : status_(std::move(status)) {}
+    std::tuple<float, float, bool> GetStatus() const override {
+        std::lock_guard guard(status_->mutex);
+        return {status_->touchX, status_->touchY, status_->touchActive};
+    }
+
+private:
+    std::shared_ptr<RemoteInputStatus> status_;
+};
+
+class AzaharAdapter final : public melonds_remote::adapter::IEmulatorAdapter {
+public:
+    // `system` must outlive this adapter -- same lifetime contract
+    // RemoteServerBridge.cpp gives it (constructed after a successful
+    // BootGame(), destroyed at the top of ShutdownGame(), see that
+    // file). `azaharVersion` is this build's own version string (for
+    // AdapterCapabilities::adapter.adapterVersion), read once at
+    // construction. `onQuitSession`/`onQuitApplication`, if set, are
+    // invoked (from whatever thread applyGenericInput() is called on --
+    // never Qt's UI thread, see RemoteServerBridge.cpp) on a
+    // GenericAction_QuitSession/_QuitApplication rising edge, mirroring
+    // melonDS's own EmuInstanceInput.cpp handling of the client's
+    // "exit emulation" menu (GitHub issue #25).
+    AzaharAdapter(Core::System& system, std::string azaharVersion,
+                  std::function<void()> onQuitSession = {},
+                  std::function<void()> onQuitApplication = {});
+    ~AzaharAdapter() override;
+
+    AzaharAdapter(const AzaharAdapter&) = delete;
+    AzaharAdapter& operator=(const AzaharAdapter&) = delete;
+
+    // melonds_remote::adapter::IEmulatorAdapter
+    melonds_remote::adapter::AdapterCapabilities capabilities() const override;
+    melonds_remote::adapter::SessionState currentState() const override;
+    void applyGenericInput(const melonds_remote::adapter::GenericInputState& state) override;
+    void releaseAllInputs() override;
+    bool latestFrame(const std::string& surfaceId,
+                      melonds_remote::adapter::SurfaceFrame& outFrame) override;
+
+private:
+    void captureLoop();     // background thread: periodic RequestScreenshot
+    void registerInputEngine();
+    void unregisterInputEngine();
+
+    Core::System& system_;
+    std::string azaharVersion_;
+    std::function<void()> onQuitSession_;
+    std::function<void()> onQuitApplication_;
+    // Rising-edge tracking for the two callbacks above -- see
+    // applyGenericInput()'s use of this, mirroring melonDS's own
+    // EmuInstanceInput.cpp's lastRemoteEmulatorActions member and the
+    // reasoning in its comment (the client resends its confirmed choice
+    // for a short window to survive UDP loss, so a naive "is the bit
+    // set" check would fire the callback repeatedly for one menu pick).
+    uint32_t lastEmulatorActions_ = 0;
+
+    std::shared_ptr<RemoteInputStatus> inputStatus_;
+
+    std::mutex frameMutex_;
+    std::vector<uint8_t> latestFrame_;
+    uint64_t frameIndex_ = 0;
+    bool hasFrame_ = false;
+
+    std::atomic<bool> running_{false};
+    std::thread captureThread_;
+    // Resolved once at construction (from AZAHAR_REMOTE_CAPTURE_FPS, or
+    // 60fps by default) -- see resolveCaptureInterval() in the .cpp.
+    std::chrono::milliseconds captureInterval_;
+    // Resolved once at construction (from AZAHAR_REMOTE_CAPTURE_SCALE, or
+    // native 1x by default) -- see resolveCaptureScale() in the .cpp.
+    // kBottomScreenWidth/Height multiplied by this; independent of
+    // Azahar's own internal resolution_factor rendering-quality setting
+    // (which affects the top screen's local 3D rendering sharpness, not
+    // what gets captured here) so bumping stream resolution is a
+    // deliberate, separate choice rather than an automatic side effect of
+    // an unrelated setting.
+    int captureScale_ = 1;
+};
+
+} // namespace CitraQt::RemoteServer
diff --git a/src/citra_qt/remote_server/RemoteServerBridge.cpp b/src/citra_qt/remote_server/RemoteServerBridge.cpp
new file mode 100644
index 000000000..9d8eb24a9
--- /dev/null
+++ b/src/citra_qt/remote_server/RemoteServerBridge.cpp
@@ -0,0 +1,120 @@
+#include "citra_qt/remote_server/RemoteServerBridge.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+
+#include <QMetaObject>
+
+#include "citra_qt/citra_qt.h"
+#include "citra_qt/remote_server/AzaharAdapter.h"
+
+namespace CitraQt::RemoteServer {
+
+RemoteServerBridge::RemoteServerBridge(Core::System& system, std::string azaharVersion,
+                                       std::string adapterSocketPath, GMainWindow* mainWindow) {
+    // Both callbacks below fire from a non-Qt thread (AzaharAdapter's
+    // from whatever thread applyGenericInput() runs on, AdapterIpcClient's
+    // connection-state one from its own readLoop() thread) -- marshaled
+    // onto Qt's UI thread via QMetaObject::invokeMethod's queued
+    // connection, same pattern melonDS's own EmuInstance.cpp uses for its
+    // pending-approval dialog and screen-layout-change callback. "close"
+    // is QWidget's own public slot (no GMainWindow-specific declaration
+    // needed); OnStopGame/OnRemoteClientConnectionChanged are
+    // GMainWindow's -- Qt's meta-object system can invoke a private slot
+    // by name regardless of C++ access control, same as melonDS's
+    // onEjectCart()/onQuit() invocations.
+    adapter_ = std::make_unique<AzaharAdapter>(
+        system, std::move(azaharVersion),
+        [mainWindow]() {
+            if (mainWindow) QMetaObject::invokeMethod(mainWindow, "OnStopGame", Qt::QueuedConnection);
+        },
+        [mainWindow]() {
+            if (mainWindow) QMetaObject::invokeMethod(mainWindow, "close", Qt::QueuedConnection);
+        });
+    ipcClient_ = std::make_unique<melonds_remote::adapter::ipc::AdapterIpcClient>(
+        *adapter_, std::move(adapterSocketPath));
+    ipcClient_->setConnectionStateCallback([mainWindow](bool connected) {
+        if (mainWindow) {
+            QMetaObject::invokeMethod(mainWindow, "OnRemoteClientConnectionChanged", Qt::QueuedConnection,
+                                       Q_ARG(bool, connected));
+        }
+    });
+}
+
+RemoteServerBridge::~RemoteServerBridge() {
+    stop();
+}
+
+void RemoteServerBridge::start() {
+    // AdapterIpcClient::connect() is a single blocking, non-retrying
+    // attempt (see its own header comment) -- this thread supplies the
+    // retry loop, mirroring melonDS's own out-of-process
+    // RemoteServerBridge::start() (same 1s-doubling-to-5s backoff, same
+    // 100ms poll granularity so stop() doesn't have to wait out a full
+    // backoff period to return), which itself mirrors
+    // client/src/main.cpp's NetClient reconnect thread -- the same
+    // pattern reused a third time here rather than invented fresh.
+    stopRequested_ = false;
+    reconnectThread_ = std::thread([this]() {
+        uint32_t backoffMs = 1000;
+        constexpr uint32_t kMaxBackoffMs = 5000;
+        while (!stopRequested_.load()) {
+            if (!ipcClient_->isConnected()) {
+                std::fprintf(stderr,
+                             "azahar-remote: attempting to connect to the Host Service "
+                             "(adapter IPC)...\n");
+                if (ipcClient_->connect()) {
+                    std::fprintf(stderr, "azahar-remote: connected to Host Service\n");
+                    backoffMs = 1000;
+                } else {
+                    backoffMs = std::min(backoffMs * 2, kMaxBackoffMs);
+                }
+            }
+            for (uint32_t waited = 0; waited < backoffMs && !stopRequested_.load(); waited += 100) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            }
+        }
+    });
+}
+
+void RemoteServerBridge::stop() {
+    stopRequested_ = true;
+    if (!reconnectThread_.joinable() && !ipcClient_ && !adapter_) {
+        return;
+    }
+    // Real user report against Cemu's identical RemoteServerBridge, 2026-08-03:
+    // "cemu seems to hang when trying to exit. and I usually have to
+    // terminate it." This function is the same reconnect-thread-join
+    // pattern Cemu's own RemoteServerBridge::stop() has (this file's own
+    // header comment even calls out that the two mirror each other's
+    // teardown ordering), so it carries the identical bug: called
+    // SYNCHRONOUSLY from Qt's UI thread (via GMainWindow::ShutdownGame()'s
+    // remote_server_bridge.reset(), see citra_qt.cpp), it can block for
+    // however long the reconnect loop below takes to notice
+    // stopRequested_ and wake up, INCLUDING the up-to-~5s it can be stuck
+    // inside a blocking AdapterIpcClient::connect() attempt at the exact
+    // moment stop() is called (bounded by adapter_ipc_client.cpp's own
+    // kRecvTimeoutSeconds, but still long enough to freeze the UI).
+    // Fixed the same way: hand the actual join + disconnect off to a
+    // detached background thread, which also takes ownership of
+    // ipcClient_/adapter_ (moved in below) rather than leaving them to be
+    // destroyed synchronously right after this function returns --
+    // ipcClient_'s read/write threads hold a reference to *adapter_ (see
+    // the constructor above) and must finish shutting down (inside
+    // ipcClient->disconnect(), which joins them) before adapter_'s
+    // destructor can safely run, so both must move into the same closure
+    // and be destroyed there, in that order.
+    std::thread cleanup([reconnectThread = std::move(reconnectThread_), ipcClient = std::move(ipcClient_),
+                          adapter = std::move(adapter_)]() mutable {
+        if (reconnectThread.joinable()) {
+            reconnectThread.join();
+        }
+        if (ipcClient) {
+            ipcClient->disconnect();
+        }
+    });
+    cleanup.detach();
+}
+
+} // namespace CitraQt::RemoteServer
diff --git a/src/citra_qt/remote_server/RemoteServerBridge.h b/src/citra_qt/remote_server/RemoteServerBridge.h
new file mode 100644
index 000000000..e4dde1cb5
--- /dev/null
+++ b/src/citra_qt/remote_server/RemoteServerBridge.h
@@ -0,0 +1,59 @@
+#pragma once
+
+// Owns an AzaharAdapter and connects it out to an already-running
+// standalone melonds-remote-server (--adapter-ipc) as an adapter --
+// this is the ONLY mode Azahar's integration supports, unlike melonDS's
+// own RemoteServerBridge (which defaults to owning an in-process
+// NetServer + device-approval). See AzaharAdapter.h's top comment for
+// why: reimplementing NetServer's device-approval Qt dialog a second
+// time for a second emulator wasn't worth it for a first integration --
+// see docs/history.md's AzaharAdapter entry.
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <thread>
+
+#include "melonds_remote/adapter/ipc/adapter_ipc_client.h"
+
+namespace Core {
+class System;
+}
+
+class GMainWindow;
+
+namespace CitraQt::RemoteServer {
+
+class AzaharAdapter;
+
+class RemoteServerBridge {
+public:
+    // `adapterSocketPath` empty uses
+    // melonds_remote::adapter::ipc::defaultAdapterSocketPath(), matching
