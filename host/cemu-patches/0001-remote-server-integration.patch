+# DualDeck (github.com/crimson3076/DualDeck) remote-server integration --
+# see CemuAdapter.h's top comment. Vendors the same adapter-sdk contract
+# (adapter_sdk/) already vendored into this project's melonDS and Azahar
+# patches, plus this emulator's own CemuAdapter/RemoteController*/
+# RemoteServerBridge glue.
+
+add_library(CemuRemoteServer STATIC
+	CemuAdapter.cpp
+	CemuAdapter.h
+	RemoteController.cpp
+	RemoteController.h
+	RemoteControllerProvider.cpp
+	RemoteControllerProvider.h
+	RemoteInputStatus.h
+	RemoteServerBridge.cpp
+	RemoteServerBridge.h
+	adapter_sdk/src/adapter_ipc_client.cpp
+	adapter_sdk/src/ipc_protocol.cpp
+	adapter_sdk/src/protocol.cpp
+	adapter_sdk/src/session_state.cpp
+	adapter_sdk/src/socket_path.cpp
+)
+
+set_property(TARGET CemuRemoteServer PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+
+# Project-wide typedefs like uint32/uint16/sint32 (plain aliases for
+# uint32_t/uint16_t/int32_t) are established in Common/precompiled.h,
+# force-included via CemuCommon's own `target_precompile_headers(CemuCommon
+# PUBLIC precompiled.h)` (src/Common/CMakeLists.txt) -- PUBLIC there means
+# any target linking CemuCommon reuses the same precompiled header
+# automatically, which is how every other library in this codebase gets
+# it (see e.g. Cafe/CMakeLists.txt's own target_link_libraries(CemuCafe
+# ... CemuCommon ...)), not via a separate helper function. CemuAdapter.cpp
+# reaches into Cemu's own Latte headers (Renderer.h, LatteTextureLoader.h,
+# LatteAddrLib.h, ...), which use those bare typedefs throughout with no
+# self-contained fallback, so linking CemuCommon here is required, not
+# just conventional.
+
+# "../" (src/) for input/, Cafe/, gui/, etc. -- same convention every
+# other top-level library here uses (see e.g. Cafe/CMakeLists.txt's
+# identical target_include_directories(CemuCafe PUBLIC "../") line).
+# RemoteServerBridge.cpp's own #include "gui/MainWindow.h" resolves
+# through this alone -- unlike some later Cemu versions, this codebase's
+# gui/ headers consistently use "gui/..."-prefixed includes among
+# themselves rather than bare same-directory includes, so no extra
+# include directory is needed here.
+target_include_directories(CemuRemoteServer PUBLIC "../")
+target_include_directories(CemuRemoteServer PUBLIC "adapter_sdk/include")
+
+target_link_libraries(CemuRemoteServer PRIVATE
+	CemuCommon
+	CemuGui
+)
