+#pragma once
+
+// Owns a CemuAdapter and connects it out to an already-running
+// standalone dualdeck-host-service (--adapter-ipc) as an adapter --
+// the only mode this integration supports, matching Azahar's own
+// RemoteServerBridge (see the DualDeck repo's
+// client/src/citra_qt/remote_server/RemoteServerBridge.h) rather than
+// melonDS's in-process NetServer + device-approval default: reusing an
+// existing standalone Host Service avoids building a second
+// device-approval Qt/wx dialog for a third emulator.
+//
+// Also exposes the single, process-lifetime "current bridge" pointer
+// LatteRenderTarget.cpp's render hook uses to reach the live
+// CemuAdapter's onSurfaceRendered() -- see currentAdapter()'s comment.
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <thread>
+
+#include "dualdeck/adapter/ipc/adapter_ipc_client.h"
+
+class LatteTextureView;
+
+namespace DualDeck::RemoteServer {
+
+class CemuAdapter;
+
+class RemoteServerBridge {
+public:
+    // `adapterSocketPath` empty uses
+    // dualdeck::adapter::ipc::defaultAdapterSocketPath(), matching
+    // the standalone host's own --adapter-socket default.
+    RemoteServerBridge(std::string cemuVersion, std::string adapterSocketPath);
+    ~RemoteServerBridge();
+
+    RemoteServerBridge(const RemoteServerBridge&) = delete;
+    RemoteServerBridge& operator=(const RemoteServerBridge&) = delete;
+
+    void start();
+    void stop();
+
+    // The live CemuAdapter belonging to whichever RemoteServerBridge is
+    // currently constructed (there is at most one at a time -- one per
+    // running title, see the patch's CafeSystem.cpp
+    // LaunchForegroundTitle()/ShutdownTitle() hooks), or null if no
+    // DualDeck session is active (CEMU_REMOTE_ENABLE unset, or no title
+    // currently running). LatteRenderTarget.cpp's render hook calls this
+    // on every frame per surface, so it must stay cheap (a single
+    // atomic load) -- see RemoteServerBridge.cpp for how it's kept in
+    // sync with construction/destruction.
+    static CemuAdapter* currentAdapter();
+
+private:
+    std::unique_ptr<CemuAdapter> adapter_;
+    std::unique_ptr<dualdeck::adapter::ipc::AdapterIpcClient> ipcClient_;
+    std::thread reconnectThread_;
+    std::atomic<bool> stopRequested_{false};
+};
+
+} // namespace DualDeck::RemoteServer
