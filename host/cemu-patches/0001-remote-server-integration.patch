+# automatically, which is how every other library in this codebase gets
+# it (see e.g. Cafe/CMakeLists.txt's own target_link_libraries(CemuCafe
+# ... CemuCommon ...)), not via a separate helper function. CemuAdapter.cpp
+# reaches into Cemu's own Latte headers (Renderer.h, LatteTextureLoader.h,
+# LatteAddrLib.h, ...), which use those bare typedefs throughout with no
+# self-contained fallback, so linking CemuCommon here is required, not
+# just conventional.
+
+# "../" (src/) for input/, Cafe/, gui/, etc. -- same convention every
+# other top-level library here uses (see e.g. Cafe/CMakeLists.txt's
+# identical target_include_directories(CemuCafe PUBLIC "../") line).
+# RemoteServerBridge.cpp's own #include "gui/MainWindow.h" resolves
+# through this alone -- unlike some later Cemu versions, this codebase's
+# gui/ headers consistently use "gui/..."-prefixed includes among
+# themselves rather than bare same-directory includes, so no extra
+# include directory is needed here.
+target_include_directories(CemuRemoteServer PUBLIC "../")
+target_include_directories(CemuRemoteServer PUBLIC "adapter_sdk/include")
+
+target_link_libraries(CemuRemoteServer PRIVATE
+	CemuCommon
+	CemuGui
+)
