+namespace DualDeck::RemoteServer {
+
+namespace {
+
+// Defaults to 30fps: unlike Azahar's RequestScreenshot() (an async
+// callback the emulator services whenever it gets around to it), this
+// adapter's onSurfaceRendered() is invoked synchronously, inline, from
+// the render thread itself, once per surface per real frame -- so on
+// Vulkan (a full blit+copy-to-buffer+submit+wait every call, see
+// VulkanRenderer::HandleScreenshotRequest for the equivalent one-shot
+// cost this mirrors) calling the real capture on literally every frame
+// at 60-144fps would add a GPU sync stall to every single frame Cemu
+// renders, whether or not a client is even watching. 30fps matches this
+// project's own established default for a small streamed display (see
+// AzaharAdapter.cpp's identical reasoning) and is overridable via
+// CEMU_REMOTE_CAPTURE_FPS for the same tuning reasons.
+std::chrono::milliseconds resolveCaptureInterval() {
+    int fps = 30;
+    if (const char* env = std::getenv("CEMU_REMOTE_CAPTURE_FPS")) {
+        int parsed = std::atoi(env);
+        if (parsed > 0) {
+            fps = std::clamp(parsed, 1, 60);
+        }
+    }
+    return std::chrono::milliseconds(1000 / fps);
+}
+
+// Off by default. Real, measured waste, found while diagnosing the Wind
+// Waker HD 14-20fps regression (see this file's own onSurfaceRendered()
+// comment and docs/known-limitations.md): CemuAdapter::capabilities()
+// below reports the TV surface with remotelyDisplayed=false (its role is
+// the host's own local screen only -- see that method's own comment),
+// and NetServer's video loop (host/remote-server/src/net_server.cpp)
+// only ever streams a session's one remotelyDisplayed surface. So even
+// before today's async-capture fix, every TV-surface capture -- GPU
+// blit/copy, CPU BGRA conversion, mutex-guarded publish, then a Frame
+// message shipped across the local adapter IPC socket by
+// AdapterIpcClient::writeLoop() (it iterates every declared surface,
+// TV included) -- was work done for a frame nothing downstream ever
+// reads. CEMU_REMOTE_CAPTURE_TV=1 (or "true"/"on") re-enables it, for
+// the currently-hypothetical future case of a client wanting the TV
+// feed too.
+bool captureTvWanted() {
+    static const bool wanted = [] {
+        const char* env = std::getenv("CEMU_REMOTE_CAPTURE_TV");
+        if (!env) {
+            return false;
+        }
+        const std::string_view value = env;
+        return value == "1" || value == "true" || value == "on";
+    }();
+    return wanted;
+}
+
+// Finds (or, on first use, causes InputManager to lazily construct) the
+// process-lifetime RemoteControllerProvider registered by the patch's
+// InputManager.cpp change (create_provider<RemoteControllerProvider>(),
+// alongside the other built-in providers -- see
+// RemoteControllerProvider.h's top comment). Returns null if the
+// provider somehow isn't registered (e.g. this binary wasn't built with
+// the DualDeck patch applied at all), in which case the caller treats
+// remote input as unavailable rather than crashing.
+std::shared_ptr<RemoteControllerProvider> getRemoteControllerProvider() {
+    const auto provider = InputManager::instance().get_api_provider(InputAPI::DualDeckRemote);
+    return std::dynamic_pointer_cast<RemoteControllerProvider>(provider);
+}
+
+// Real user report, 2026-08-03: "Cemu controls *Work*, but they need to
+// be binded by the user, which I do not like." Root cause: VPADController::
+// set_default_mapping() (input/emulated/VPADController.cpp) only fills a
+// Wii U button slot when `m_mappings.find(m.first) == m_mappings.cend()`
+// -- i.e. it silently no-ops for any slot Player 1 already has a mapping
+// for, which is true for essentially any real-world Cemu profile (Cemu
+// ships with no controller configured at all only on a literally fresh
+// install; the very first time a user sets up *any* controller for
+// Player 1, every slot below becomes "already mapped" and
+// set_default_mapping() stops doing anything for a controller added
+// afterward, including this remote one). EmulatedController::set_mapping()
+// (public, EmulatedController.h) has no such guard -- confirmed by
+// reading it directly, it's an unconditional `m_mappings[mapping] = {
+// controller, button }`. This table is VPADController.cpp's own
+// `InputAPI::XInput`/`InputAPI::DualDeckRemote` case (the two share this
+// exact table -- see this patch's VPADController.cpp hunk), replicated
+// here so the remote controller can be force-applied via set_mapping()
+// directly, unconditionally taking over Player 1 regardless of whatever
+// was mapped before -- matching "a client just connected, it should be
+// in control now" semantics, the same precedence this project's other
+// emulator integrations already give network input over local/physical
+// input while a client session is active.
+// Takes EmulatedController&, not VPADController&, matching m_vpadController's
+// own declared type in CemuAdapter.h (std::shared_ptr<EmulatedController> --
+// set_mapping() lives on that base class, no VPADController-specific API is
+// needed here). The VPADController::kButtonId_* values below are just
+// compile-time constants pulled from that subclass's enum.
+void forceRemoteControllerMapping(EmulatedController& vpad, const std::shared_ptr<ControllerBase>& controller) {
+    static constexpr std::pair<uint64, uint64> kMapping[] = {
+        {VPADController::kButtonId_A, kButton13},
+        {VPADController::kButtonId_B, kButton12},
+        {VPADController::kButtonId_X, kButton15},
+        {VPADController::kButtonId_Y, kButton14},
+
+        {VPADController::kButtonId_L, kButton8},
+        {VPADController::kButtonId_R, kButton9},
+        {VPADController::kButtonId_ZL, kTriggerXP},
+        {VPADController::kButtonId_ZR, kTriggerYP},
+
+        {VPADController::kButtonId_Plus, kButton4},
+        {VPADController::kButtonId_Minus, kButton5},
+
+        {VPADController::kButtonId_Up, kButton0},
+        {VPADController::kButtonId_Down, kButton1},
+        {VPADController::kButtonId_Left, kButton2},
+        {VPADController::kButtonId_Right, kButton3},
+
+        {VPADController::kButtonId_StickL, kButton6},
+        {VPADController::kButtonId_StickR, kButton7},
+
+        {VPADController::kButtonId_StickL_Up, kAxisYP},
+        {VPADController::kButtonId_StickL_Down, kAxisYN},
+        {VPADController::kButtonId_StickL_Left, kAxisXN},
+        {VPADController::kButtonId_StickL_Right, kAxisXP},
+
+        {VPADController::kButtonId_StickR_Up, kRotationYP},
+        {VPADController::kButtonId_StickR_Down, kRotationYN},
+        {VPADController::kButtonId_StickR_Left, kRotationXN},
+        {VPADController::kButtonId_StickR_Right, kRotationXP},
+    };
+    for (const auto& m : kMapping) {
+        vpad.set_mapping(m.first, controller, m.second);
+    }
+}
+
+} // namespace
+
+CemuAdapter::CemuAdapter(std::string cemuVersion, std::function<void()> onQuitSession,
+                         std::function<void()> onQuitApplication)
+    : m_cemuVersion(std::move(cemuVersion)), m_onQuitSession(std::move(onQuitSession)),
+      m_onQuitApplication(std::move(onQuitApplication)) {
+    const auto provider = getRemoteControllerProvider();
+    if (!provider) {
+        // No DualDeckRemote provider registered -- this adapter still
+        // works for video, just never receives input. Should not happen
+        // in a real patched build (see the patch's InputManager.cpp
+        // change), but a stray CemuAdapter constructed in a test binary
+        // without that change applied should degrade, not crash.
+        return;
+    }
+    m_inputStatus = provider->inputStatus();
+
+    m_vpadController = InputManager::instance().get_vpad_controller(0);
+    if (m_vpadController) {
+        // get_controllers() mints a fresh RemoteController every call
+        // (see RemoteControllerProvider.h) -- hold the specific instance
+        // handed to add_controller() here so the destructor's
+        // remove_controller() call targets the exact same object,
+        // matching InputSettings2.cpp's own add/set_default_mapping/
+        // (eventual) remove pairing for a real controller.
+        m_remoteController = provider->get_controllers().front();
+        m_vpadController->add_controller(m_remoteController);
+        // Not set_default_mapping() -- see forceRemoteControllerMapping()'s
+        // comment above for why that silently no-ops on any Cemu profile
+        // that already has Player 1 configured.
+        forceRemoteControllerMapping(*m_vpadController, m_remoteController);
+    }
+    else {
+        // Real user report, 2026-08-01: "Cemu works, no touch screen or
+        // controls work" -- player 1 isn't currently configured as a
+        // VPAD-type controller (e.g. switched to Pro/Classic/Wiimote in
+        // Controller Settings), so there's nothing to auto-map onto and
+        // remote input is silently inert for this session, same as it
+        // would be for a real physical controller connected while
+        // player 1 is set to a different type. This used to have no log
+        // line at all -- completely undiagnosable from a user report,
+        // since video streams fine either way and nothing else fails.
+        // Fix Controller Settings -> Player 1 -> "Wii U GamePad" first;
+        // if remote input still doesn't work with that set correctly,
+        // this log line's absence rules this specific cause out.
+        cemuLog_log(LogType::Force,
+                     "DualDeck: remote input inactive -- player 1 is not configured as a Wii U "
+                     "GamePad controller (Controller Settings)");
+    }
+}
+
+CemuAdapter::~CemuAdapter() {
+    m_running.store(false);
+    if (m_vpadController && m_remoteController) {
+        m_vpadController->remove_controller(m_remoteController);
+    }
+}
+
+melonds_remote::adapter::AdapterCapabilities CemuAdapter::capabilities() const {
+    melonds_remote::adapter::AdapterCapabilities caps;
+    caps.system = melonds_remote::SystemIdentity{"wiiu", "Nintendo Wii U"};
+    caps.adapter = melonds_remote::AdapterIdentity{"cemu", "Cemu", m_cemuVersion};
+    caps.supportsAnalogTriggers = true;
+
+    // TV output: shown on the host's own display, matching this
+    // project's existing "host shows one screen, client streams the
+    // other" model for DS/3DS -- not required to be captured for the
+    // client session to be considered healthy (a title with the
+    // GamePad screen blanked/disabled is still fully playable via the
+    // TV alone, unlike the reverse).
+    // Real-usage bug (GitHub-reported): this used to always report
+    // kTvDefaultWidth/kTvDefaultHeight and kGamePadDefaultWidth/
+    // kGamePadDefaultHeight below, contrary to this file's own top
+    // comment ("these are only the AdapterCapabilities defaults reported
+    // before the first frame is captured") -- onSurfaceRendered() always
+    // recorded the real captured size into m_tvSurface/m_gamePadSurface,
+    // but capabilities() never actually read it back. NetServer queries
+    // capabilities() (via AdapterBridge::frameDimensions()) once per
+    // connection and uses that value for the rest of the session to
+    // interpret every subsequent raw frame's byte layout (JPEG encode
+    // width/pitch) -- so any title whose actual internal GamePad/DRC
+    // render resolution isn't exactly 854x480 (the vast majority: this
+    // is only Wii U's *physical GamePad hardware's* native resolution,
+    // not something every title's software renderer is required to
+    // render at) streamed a sheared/torn image, since the encoder read
+    // a differently-sized real buffer using the wrong stride. Confirmed
+    // via user report + screenshots: Wind Waker HD (actual GamePad
+    // resolution apparently == 854x480) streamed perfectly; Twilight
+    // Princess HD and Pokemon Rumble U (different actual resolutions)
+    // both showed the same horizontal-tearing corruption. Fixed by
+    // reporting the real last-captured size once one exists, falling
+    // back to the compile-time default only before the very first
+    // GamePad/TV frame has ever been captured (in practice always
+    // resolved by the time a client's Hello arrives, since Cemu renders
+    // continuously from title boot, well before a user gets to opening
+    // the DualDeck client).
+    melonds_remote::adapter::VideoSurfaceDescriptor tv;
+    tv.surfaceId = kTvSurfaceId;
+    tv.role = melonds_remote::adapter::SurfaceRole::Tv;
+    {
+        std::lock_guard guard(m_tvSurface.mutex);
+        tv.width = m_tvSurface.hasFrame ? static_cast<uint16_t>(m_tvSurface.width) : kTvDefaultWidth;
+        tv.height = m_tvSurface.hasFrame ? static_cast<uint16_t>(m_tvSurface.height) : kTvDefaultHeight;
+    }
+    tv.pixelFormat = melonds_remote::adapter::PixelFormat::Bgra8888;
+    tv.touchSupported = false;
+    tv.required = false;
+    tv.locallyDisplayed = true;
+    tv.remotelyDisplayed = false;
+    tv.nominalFps = 60;
+    tv.maxFps = 60;
+    caps.surfaces.push_back(tv);
+
+    // GamePad/DRC output: streamed to the DualDeck client, the Wii U
+    // analogue of DS/3DS's bottom screen. Touch-capable -- see
+    // CemuAdapter.h's top comment's touch section and
+    // applyGenericInput()'s touch handling below.
+    melonds_remote::adapter::VideoSurfaceDescriptor gamePad;
+    gamePad.surfaceId = kGamePadSurfaceId;
+    gamePad.role = melonds_remote::adapter::SurfaceRole::GamePad;
+    {
+        std::lock_guard guard(m_gamePadSurface.mutex);
+        gamePad.width = m_gamePadSurface.hasFrame ? static_cast<uint16_t>(m_gamePadSurface.width) : kGamePadDefaultWidth;
+        gamePad.height = m_gamePadSurface.hasFrame ? static_cast<uint16_t>(m_gamePadSurface.height) : kGamePadDefaultHeight;
+    }
+    gamePad.pixelFormat = melonds_remote::adapter::PixelFormat::Bgra8888;
+    gamePad.touchSupported = true;
+    gamePad.required = true;
+    gamePad.locallyDisplayed = false;
+    gamePad.remotelyDisplayed = true;
+    gamePad.nominalFps = 30; // see resolveCaptureInterval()'s comment on why 30, not 60
+    gamePad.maxFps = 30;
+    caps.surfaces.push_back(gamePad);
+
+    return caps;
+}
+
+melonds_remote::adapter::SessionState CemuAdapter::currentState() const {
+    return m_running.load() ? melonds_remote::adapter::SessionState::Running
+                             : melonds_remote::adapter::SessionState::Stopped;
+}
+
+void CemuAdapter::applyGenericInput(const melonds_remote::adapter::GenericInputState& state) {
+    if (m_inputStatus) {
+        std::lock_guard guard(m_inputStatus->mutex);
+        m_inputStatus->buttons = state.buttons;
+        m_inputStatus->leftStickX = state.leftStickX;
+        m_inputStatus->leftStickY = state.leftStickY;
+        m_inputStatus->rightStickX = state.rightStickX;
+        m_inputStatus->rightStickY = state.rightStickY;
+        // ZL/ZR are analog-only on the Wii U GamePad (see
+        // RemoteController.cpp's top comment) -- take the client's real
+        // analog value if it sent one, otherwise fall back to full-scale
+        // when only the digital L2/R2 click is set, so a client with no
+        // analog trigger hardware still registers a full ZL/ZR press.
+        m_inputStatus->leftTrigger = static_cast<uint8_t>(
+            state.leftTrigger != 0    ? state.leftTrigger
+            : (state.buttons & melonds_remote::adapter::GenericButton_L2) ? 0xFF
+                                                                           : 0);
+        m_inputStatus->rightTrigger = static_cast<uint8_t>(
+            state.rightTrigger != 0   ? state.rightTrigger
+            : (state.buttons & melonds_remote::adapter::GenericButton_R2) ? 0xFF
+                                                                           : 0);
+
+        // Touch: mirrors AzaharAdapter.cpp's identical normalization
+        // (host/azahar-patches/) -- protocol.h's wire touchX/touchY are
+        // always quantized into the DS's fixed 0..kTouchMaxX/kTouchMaxY
+        // range regardless of which surface/aspect ratio the touch was
+        // actually made against (touch_mapping.cpp's mapPointToDSCoords()
+        // normalizes the tap's *fractional* position within the
+        // aspect-fit rect first, then rescales that fraction into
+        // DS-space, so the fraction recovered here is correct for any
+        // surface shape, including the GamePad's 16:9 854x480 output --
+        // not just the DS/3DS's native 4:3). Dividing back by
+        // kTouchMaxX/kTouchMaxY recovers that same 0..1 fraction, which
+        // is exactly the convention RemoteController::get_position() (and
+        // ControllerBase::get_position() generally) already promises.
+        // AdapterBridge::applyControllerState() only ever targets one
+        // surface (targetSurfaceId(), the one with remotelyDisplayed set
+        // -- the GamePad here), so state.touches has at most one contact
+        // in practice; matched by surfaceId anyway rather than assumed by
+        // position, in case that ever changes.
+        m_inputStatus->touchActive = false;
+        for (const auto& touch : state.touches) {
+            if (touch.surfaceId != kGamePadSurfaceId) {
+                continue;
+            }
+            m_inputStatus->touchActive = true;
+            m_inputStatus->touchX =
+                static_cast<float>(touch.x) / static_cast<float>(melonds_remote::kTouchMaxX);
+            m_inputStatus->touchY =
+                static_cast<float>(touch.y) / static_cast<float>(melonds_remote::kTouchMaxY);
+            break;
+        }
+    }
+
+    // GitHub issue #25 (as implemented for melonDS/Azahar): client-side
+    // "exit emulation" menu. Edge-detected against m_lastEmulatorActions,
+    // not "bit is set this frame" -- the client resends its confirmed
+    // choice for a short window to survive UDP loss, so a naive
+    // "is the bit set" check would fire the callback repeatedly for one
+    // menu confirmation. See CemuAdapter.h's constructor comment for why
+    // this runs via injected callbacks rather than calling into Cemu's
+    // GUI directly (this method runs on AdapterIpcClient's readLoop()
+    // thread, never Cemu's own UI thread).
+    const uint32_t risingEdge = state.emulatorActions & ~m_lastEmulatorActions;
+    if ((risingEdge & melonds_remote::adapter::GenericAction_QuitSession) && m_onQuitSession) {
+        m_onQuitSession();
+    }
+    if ((risingEdge & melonds_remote::adapter::GenericAction_QuitApplication) && m_onQuitApplication) {
+        m_onQuitApplication();
+    }
+    m_lastEmulatorActions = state.emulatorActions;
+}
+
+void CemuAdapter::releaseAllInputs() {
+    if (!m_inputStatus) {
+        return;
+    }
+    std::lock_guard guard(m_inputStatus->mutex);
+    m_inputStatus->buttons = 0;
+    m_inputStatus->leftStickX = 0;
+    m_inputStatus->leftStickY = 0;
+    m_inputStatus->rightStickX = 0;
+    m_inputStatus->rightStickY = 0;
+    m_inputStatus->leftTrigger = 0;
+    m_inputStatus->rightTrigger = 0;
+    m_inputStatus->touchActive = false;
+}
+
+bool CemuAdapter::latestFrame(const std::string& surfaceId, melonds_remote::adapter::SurfaceFrame& outFrame) {
+    CapturedSurface* surface = nullptr;
+    if (surfaceId == kTvSurfaceId) {
+        surface = &m_tvSurface;
+    } else if (surfaceId == kGamePadSurfaceId) {
+        surface = &m_gamePadSurface;
+    } else {
+        return false;
+    }
+
+    std::lock_guard guard(surface->mutex);
+    if (!surface->hasFrame) {
+        return false;
+    }
+    outFrame.surfaceId = surfaceId;
+    outFrame.frameIndex = surface->frameIndex;
+    // Contract v2: this frame's own real captured size, not whatever
+    // capabilities() declared -- the definitive fix for the same
+    // real-usage bug capabilities()'s own hasFrame-gated fallback above
+    // only partially covers (that one only helps once, at Hello time;
+    // this one is correct for every single frame of the whole session,
+    // including if a title's real GamePad/DRC resolution ever changes
+    // after the first one). See adapter_contract.h's SurfaceFrame comment.
+    outFrame.width = static_cast<uint16_t>(surface->width);
+    outFrame.height = static_cast<uint16_t>(surface->height);
+    outFrame.pixels = surface->pixels;
+    return true;
+}
+
+void CemuAdapter::onSurfaceRendered(LatteTextureView* texView, bool isPadView) {
+    // Step 1 (per this feature's own design doc, docs/known-limitations.md):
+    // ignore the TV surface unless DualDeck explicitly needs it. See
+    // captureTvWanted()'s own comment -- this surface is never actually
+    // sent to any client today, so capturing it is 100% wasted work.
+    if (!isPadView && !captureTvWanted()) {
+        return;
+    }
+
+    // Step 2: is a capture even wanted right now at all? Two conditions,
+    // both must hold:
+    //  - A real client is actually connected and watching (see
+    //    m_clientConnected's own comment) -- AdapterIpcClient merely
+    //    being connected to dualdeck-host-service is not that signal.
+    //  - This surface's own CEMU_REMOTE_CAPTURE_FPS throttle interval
+    //    has actually elapsed since its last real capture.
+    if (!m_clientConnected.load()) {
+        ++m_captureDiagnostics.skippedNoViewer;
+        return;
+    }
+
+    static const std::chrono::milliseconds kInterval = resolveCaptureInterval();
+    auto& lastCapture = isPadView ? m_lastGamePadCapture : m_lastTvCapture;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - lastCapture < kInterval) {
+        return;
+    }
+
+    if (!g_renderer) {
+        return;
+    }
+
+    if (!g_renderer->SupportsAsyncCaptureSurfaceBGRA()) {
+        // Fallback for a backend with no async implementation (currently:
+        // OpenGL) -- the original, still-synchronous path, completely
+        // unchanged. Real hardware testing for this fix was Vulkan-only
+        // (both machines in the bug report use it, and it's Cemu's
+        // default/recommended backend on Linux), so this is deliberately
+        // left as-is rather than risking an unverified change to a path
+        // this fix's own testing never exercised.
+        std::vector<uint8_t> pixels;
+        int width = 0;
+        int height = 0;
+        if (!g_renderer->CaptureSurfaceBGRA(texView, isPadView, pixels, width, height)) {
+            return;
+        }
+        lastCapture = now;
+        ++m_captureDiagnostics.completedSync;
+
+        CapturedSurface& surface = isPadView ? m_gamePadSurface : m_tvSurface;
+        std::lock_guard guard(surface.mutex);
+        surface.pixels = std::move(pixels);
+        surface.width = width;
+        surface.height = height;
+        ++surface.frameIndex;
+        surface.hasFrame = true;
+        return;
+    }
+
+    // Async (Vulkan) path from here on. Resolved once, lazily -- the
+    // renderer (and therefore its real slot count) doesn't exist yet the
+    // very first time this class is even constructed.
+    if (m_captureSlotCount == 0) {
+        m_captureSlotCount = std::min<uint32_t>(g_renderer->GetCaptureSlotCount(), kMaxCaptureSlots);
+    }
+
+    // Step 3: attempt to reserve a free capture slot.
+    uint32_t freeSlot = kMaxCaptureSlots;
+    for (uint32_t slot = 0; slot < m_captureSlotCount; ++slot) {
+        if (!m_pendingCaptures[slot].inFlight && g_renderer->IsCaptureSlotFree(slot)) {
+            freeSlot = slot;
+            break;
+        }
+    }
+    if (freeSlot == kMaxCaptureSlots) {
+        // No slot available -- every one is still waiting on the GPU
+        // from an earlier capture. Never block Cemu to get one: drop
+        // this DualDeck frame and try again next time
+        // onSurfaceRendered() is called for this surface.
+        ++m_captureDiagnostics.dropped;
+        return;
+    }
+
+    // Steps 4-6: record the capture into the currently-recording command
+    // buffer (VulkanRenderer::ScheduleCaptureSurfaceBGRA() does this,
+    // including saving the resulting command-buffer id internally, and
+    // nudging Cemu's own normal submission cadence via
+    // RequestSubmitSoon()/RequestSubmitOnIdle() -- see its own comment
+    // for why that's the whole extent of "requesting submission" this
+    // needs to do). Step 7 (return immediately) is just... returning;
+    // there is nothing else for this function to wait on.
+    int width = 0;
+    int height = 0;
+    if (!g_renderer->ScheduleCaptureSurfaceBGRA(texView, isPadView, freeSlot, width, height)) {
+        ++m_captureDiagnostics.failed;
+        return;
+    }
+    lastCapture = now;
+    m_pendingCaptures[freeSlot] = PendingCapture{true, isPadView, width, height};
+    ++m_captureDiagnostics.scheduled;
+}
+
+void CemuAdapter::pumpCaptures() {
+    logCaptureDiagnosticsIfDue();
+
+    if (!g_renderer || !g_renderer->SupportsAsyncCaptureSurfaceBGRA()) {
+        return;
+    }
+
+    for (uint32_t slot = 0; slot < m_captureSlotCount; ++slot) {
+        PendingCapture& pending = m_pendingCaptures[slot];
+        if (!pending.inFlight) {
+            continue;
+        }
+        if (!g_renderer->IsCaptureSlotReady(slot)) {
+            continue; // still waiting on the GPU -- check again next frame
+        }
+
+        std::vector<uint8_t> pixels;
+        const bool ok = g_renderer->ReadAndReleaseCaptureSlot(slot, pixels);
+        // The slot itself is always freed by ReadAndReleaseCaptureSlot()
+        // regardless of `ok` (see its own comment) -- this adapter's
+        // *own* bookkeeping needs the same unconditional reset, or a
+        // failed readback would permanently strand this slot as
+        // "in flight" from CemuAdapter's point of view even though
+        // VulkanRenderer already considers it free again.
+        pending.inFlight = false;
+        if (!ok) {
+            ++m_captureDiagnostics.failed;
+            continue;
+        }
+
+        CapturedSurface& surface = pending.isPadView ? m_gamePadSurface : m_tvSurface;
+        {
+            // Just a std::vector move (a pointer/size/capacity swap, not
+            // a byte copy) under the lock -- same "swap a completed
+            // frame buffer in" shape latestFrame()'s own std::move-based
+            // publish already had; the mutex is held for that swap only,
+            // never for copying pixel data.
+            std::lock_guard guard(surface.mutex);
+            surface.pixels = std::move(pixels);
+            surface.width = pending.width;
+            surface.height = pending.height;
+            ++surface.frameIndex;
+            surface.hasFrame = true;
+        }
+        ++m_captureDiagnostics.completed;
+    }
+}
+
+void CemuAdapter::logCaptureDiagnosticsIfDue() {
+    // Once every 10s, and only if there's something worth a line about
+    // (skip an entirely idle interval -- e.g. no client connected at
+    // all -- to avoid spamming Cemu's log with repeated all-zero lines).
+    constexpr auto kLogInterval = std::chrono::seconds(10);
+    const auto now = std::chrono::steady_clock::now();
+    if (now - m_lastDiagnosticsLog < kLogInterval) {
+        return;
+    }
+    m_lastDiagnosticsLog = now;
+
+    const auto& d = m_captureDiagnostics;
+    if (d.scheduled == 0 && d.completedSync == 0 && d.dropped == 0 && d.failed == 0 &&
+        d.completed == 0 && d.skippedNoViewer == 0) {
+        return;
+    }
+
+    uint32_t pendingSlots = 0;
+    for (uint32_t slot = 0; slot < m_captureSlotCount; ++slot) {
+        if (m_pendingCaptures[slot].inFlight) {
+            ++pendingSlots;
+        }
+    }
+
+    cemuLog_log(LogType::Force,
+                 "DualDeck: capture diagnostics (last 10s) -- scheduled={} completed={} completedSync={} "
+                 "dropped={} failed={} skippedNoViewer={} pendingSlots={}/{}",
+                 d.scheduled, d.completed, d.completedSync, d.dropped, d.failed, d.skippedNoViewer,
+                 pendingSlots, m_captureSlotCount);
+
+    m_captureDiagnostics = CaptureDiagnostics{};
+}
+
+} // namespace DualDeck::RemoteServer
diff --git a/src/remote_server/CemuAdapter.h b/src/remote_server/CemuAdapter.h
new file mode 100644
index 0000000..fc708e0
--- /dev/null
+++ b/src/remote_server/CemuAdapter.h
@@ -0,0 +1,323 @@
+#pragma once
+
+// DualDeck's IEmulatorAdapter implementation for Cemu (Nintendo Wii U).
+// Mirrors CitraQt::RemoteServer::AzaharAdapter's shape (see the DualDeck
+// repo's client/src/citra_qt/remote_server/AzaharAdapter.h) as closely as
+// Wii U's own two-screen model allows -- out-of-process only, via
+// melonds_remote::adapter::ipc::AdapterIpcClient, connecting out to an
+// already-running standalone dualdeck-host-service (--adapter-ipc). See
+// docs/adr/0001-host-service-and-adapter-architecture.md.
+//
+// Two responsibilities:
+//  1. Video: exposes two surfaces (SurfaceRole::Tv for the TV output,
+//     SurfaceRole::GamePad for the GamePad/DRC output) matching the shape
+//     the existing FakeWiiUAdapter fixture (adapter-sdk/fake_adapters)
+//     already models. Captured at the exact point Cemu itself finalizes
+//     each scan buffer -- LatteRenderTarget.cpp's existing
+//     HandleScreenshotRequest(textureView, isPadView) call site, confirmed
+//     by reading it, not assumed -- via a small parallel hook this patch
+//     adds alongside that call (never reusing or interfering with Cemu's
+//     own single-shot screenshot-to-file feature).
+//
+//     Real hardware regression, 2026-08-26: this used to call
+//     g_renderer->CaptureSurfaceBGRA() directly, which on Vulkan is a
+//     full record+submit+vkWaitForFences every call -- a guaranteed
+//     render-thread stall up to CEMU_REMOTE_CAPTURE_FPS times/sec per
+//     surface. Confirmed (two independent machines: Fedora/RTX 4070
+//     Laptop GPU, Bazzite/RX 7900 XTX) to run Wind Waker HD at ~14-20fps
+//     instead of its native 30, with CEMU_REMOTE_CAPTURE_FPS=1 (nearly
+//     eliminating the stalls) restoring full speed -- see
+//     docs/known-limitations.md's matching entry for the full
+//     before/after writeup. onSurfaceRendered() (below) now schedules a
+//     capture via Renderer::ScheduleCaptureSurfaceBGRA() (Vulkan only;
+//     see Renderer.h's own comment) into one of a small, fixed pool of
+//     reusable slots and returns immediately, never waiting on the GPU
+//     itself; pumpCaptures() (also below), called once per real frame
+//     from the same LatteRenderTarget.cpp hook, drains whatever slots
+//     the GPU has since actually finished (Renderer::IsCaptureSlotReady())
+//     and publishes their pixels. A backend without an async
+//     implementation (currently: OpenGL) falls back to the old,
+//     still-synchronous CaptureSurfaceBGRA() path unchanged.
+//
+//     Also as of 2026-08-26: the TV surface is only ever captured (by
+//     either path) if CEMU_REMOTE_CAPTURE_TV is set -- see
+//     captureTvWanted()'s own comment in CemuAdapter.cpp for why it's
+//     off by default (capabilities() below already reports
+//     remotelyDisplayed=false for it: no client has ever actually
+//     received a TV frame, so capturing it by default was 100% wasted
+//     GPU/CPU/IPC work). And onSurfaceRendered() no longer captures
+//     anything at all unless a NetServer client is actually connected
+//     (see m_clientConnected's own comment) -- AdapterIpcClient staying
+//     connected to dualdeck-host-service says nothing about whether a
+//     Deck is actually watching.
+//  2. Input: registers a RemoteControllerProvider (see
+//     RemoteControllerProvider.h) through InputManager's existing
+//     create_provider<TProvider>() template and, once at construction,
+//     auto-wires it as VPAD player 1's default mapping. Confirmed by
+//     reading gui/input/InputSettings2.cpp (the only two call
+//     sites of EmulatedController::set_default_mapping() anywhere in
+//     Cemu) that the real, idiomatic sequence is always
+//     add_controller() *then* set_default_mapping() on the target
+//     EmulatedController -- set_default_mapping() alone is not enough,
+//     since VPADController::get_axis_value()/is_mapping_down() resolve a
+//     mapped button through a weak_ptr stored by set_mapping(), but the
+//     controller's own update()/connect() (and therefore raw_state()
+//     ever being polled at all) are only driven for controllers actually
+//     present in EmulatedController::m_controllers, which add_controller()
+//     is what populates. CemuAdapter's constructor/destructor reproduce
+//     that exact pairing (add_controller founded at construction,
+//     remove_controller at destruction) directly against
+//     InputManager::instance().get_vpad_controller(0), bypassing the GUI
+//     entirely -- this is what makes the mapping "auto injected" rather
+//     than requiring the user to open Controller Settings themselves.
+//     The mapping table itself (see RemoteController.cpp's top comment)
+//     mirrors VPADController::set_default_mapping()'s existing
+//     InputAPI::XInput case bit-for-bit, added as a second case label on
+//     the same switch arm in the patch (not a new table) -- confirmed by
+//     reading that function's full switch statement, not assumed.
+//     set_mapping() only fills in a Wii U button that isn't already
+//     mapped, so this never clobbers a real controller the user already
+//     configured.
+//
+//  3. Touch: Wii U GamePad touchscreen input. `VPADRead()`
+//     (Cafe/OS/libs/vpad/vpad.cpp) does default tpData/tpProcessed1/
+//     tpProcessed2 validity to VPAD_TP_VALIDITY_INVALID_XY before it does
+//     anything else -- but that's only the pre-controller-poll default,
+//     not the final value: for channel 0 (the Wii U GamePad) it then
+//     calls the mapped EmulatedController's own VPADRead(status, repeat)
+//     (VPADController::VPADRead(), input/emulated/VPADController.cpp),
+//     which unconditionally overwrites tpData via update_touch(). That
+//     function's first branch is `if (has_position())` -- an existing
+//     ControllerBase virtual (input/api/Controller.h) two other real
+//     backends already implement for exactly this purpose (DSUController
+//     for a DSU/cemuhook touchpad, NativeWiimoteController for the
+//     Wiimote IR pointer): a normalized [0,1]x[0,1] position plus an
+//     active flag, with no notion of *which* physical device produced it.
+//     RemoteController below implements the same pair, backed by
+//     RemoteInputStatus::touchActive/touchX/touchY (see RemoteController.h
+//     for the exact table this pairs with the shared-XInput button table
+//     above) -- so no upstream vpad.cpp/VPADController.cpp change is
+//     needed at all, unlike every other class of change this patch makes.
+//     The earlier assumption that this required "an entirely new
+//     Cemu-side touch pipeline" was wrong: that pipeline already existed,
+//     just gated behind a controller-level virtual this adapter hadn't
+//     implemented yet.
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include "melonds_remote/adapter/adapter_contract.h"
+#include "remote_server/RemoteInputStatus.h"
+
+class LatteTextureView;
+class ControllerBase;
+class EmulatedController;
+
+namespace DualDeck::RemoteServer {
+
+// Wii U TV and GamePad output resolutions. Most titles render the TV at
+// 1280x720 and the GamePad/DRC at 854x480, but Latte's actual render
+// target can differ per-title (and, unlike DS/3DS, Wii U has no single
+// fixed native resolution to hardcode) -- these are only the
+// AdapterCapabilities defaults reported before the first frame is
+// captured; onSurfaceRendered() records whatever the real captured
+// texture size turns out to be into the corresponding CapturedSurface,
+// same as the width/height CemuAdapter.cpp actually streams.
+inline constexpr const char* kTvSurfaceId = "tv";
+inline constexpr const char* kGamePadSurfaceId = "gamepad";
+inline constexpr int kTvDefaultWidth = 1280;
+inline constexpr int kTvDefaultHeight = 720;
+inline constexpr int kGamePadDefaultWidth = 854;
+inline constexpr int kGamePadDefaultHeight = 480;
+
+// One captured surface's most recent frame, guarded by its own mutex so
+// the TV and GamePad surfaces never block each other's capture or
+// latestFrame() reads.
+struct CapturedSurface {
+    // mutable: capabilities() (a const method, see CemuAdapter.cpp) locks
+    // this to read width/height/hasFrame -- the actual most-recently-
+    // captured size, not just latestFrame()'s non-const pixel readout.
+    mutable std::mutex mutex;
+    std::vector<uint8_t> pixels;
+    int width = 0;
+    int height = 0;
+    uint64_t frameIndex = 0;
+    bool hasFrame = false;
+};
+
+class CemuAdapter final : public melonds_remote::adapter::IEmulatorAdapter {
+public:
+    // `cemuVersion` is this build's own version string (for
+    // AdapterCapabilities::adapter.adapterVersion), read once at
+    // construction. `onQuitSession`/`onQuitApplication`, if set, are
+    // invoked (from whatever thread applyGenericInput() is called on --
+    // never Cemu's UI thread) on a GenericAction_QuitSession/
+    // _QuitApplication rising edge, mirroring AzaharAdapter's identical
+    // handling of the client's "exit emulation" menu (GitHub issue #25).
+    explicit CemuAdapter(std::string cemuVersion, std::function<void()> onQuitSession = {},
+                         std::function<void()> onQuitApplication = {});
+    ~CemuAdapter() override;
+
+    CemuAdapter(const CemuAdapter&) = delete;
+    CemuAdapter& operator=(const CemuAdapter&) = delete;
+
+    // melonds_remote::adapter::IEmulatorAdapter
+    melonds_remote::adapter::AdapterCapabilities capabilities() const override;
+    melonds_remote::adapter::SessionState currentState() const override;
+    void applyGenericInput(const melonds_remote::adapter::GenericInputState& state) override;
+    void releaseAllInputs() override;
+    bool latestFrame(const std::string& surfaceId,
+                      melonds_remote::adapter::SurfaceFrame& outFrame) override;
+
+    // Called from the patch's LatteRenderTarget.cpp hook, once per frame
+    // per surface, immediately after Cemu's own HandleScreenshotRequest()
+    // call for that surface -- i.e. potentially 60-144 times/sec per
+    // surface, far more often than this needs to actually do an expensive
+    // GPU readback. Throttled internally to CEMU_REMOTE_CAPTURE_FPS
+    // (default 30, same default and env-var-override pattern as Azahar's
+    // AZAHAR_REMOTE_CAPTURE_FPS); also does nothing at all unless
+    // captureTvWanted() (for the TV surface) and m_clientConnected (for
+    // either) both say so -- see this file's top comment and each one's
+    // own comment in CemuAdapter.cpp. On the async (Vulkan) path this
+    // only ever *schedules* a capture (Renderer::ScheduleCaptureSurfaceBGRA())
+    // into a free slot and returns -- it never itself waits on or reads
+    // back anything; pumpCaptures() below is what actually publishes a
+    // completed one. On any backend without an async implementation,
+    // falls back to the old synchronous CaptureSurfaceBGRA() call,
+    // unchanged.
+    void onSurfaceRendered(LatteTextureView* texView, bool isPadView);
+
+    // Called from the same LatteRenderTarget.cpp hook as
+    // onSurfaceRendered() above, once per real frame (not per surface,
+    // and not subject to onSurfaceRendered()'s own throttle) --
+    // deliberately BEFORE that call's own throttle/gating checks, so a
+    // capture scheduled a frame or two ago gets picked up and published
+    // promptly regardless of whether *this* frame ends up scheduling a
+    // new one. Drains every in-flight slot Renderer::IsCaptureSlotReady()
+    // now reports true for: reads it back via
+    // Renderer::ReadAndReleaseCaptureSlot() (pure CPU work against an
+    // already-mapped, host-coherent buffer -- no Vulkan calls), publishes
+    // it into the right CapturedSurface, and frees the slot. Doing this
+    // here, on the same render thread that owns all the relevant Vulkan/
+    // Cemu state, rather than on a dedicated worker thread, is
+    // deliberate -- see docs/known-limitations.md's design writeup for
+    // why a separate completion thread was considered and rejected (it
+    // would need its own synchronization around state this render thread
+    // already owns exclusively, for no real latency benefit given this
+    // hook already runs every real frame). No-op on a backend without an
+    // async implementation (SupportsAsyncCaptureSurfaceBGRA() false).
+    void pumpCaptures();
+
+    // Wired to AdapterIpcClient::setConnectionStateCallback() by
+    // RemoteServerBridge -- see m_clientConnected's own comment.
+    void setClientConnected(bool connected) { m_clientConnected.store(connected); }
+
+    std::shared_ptr<RemoteInputStatus> inputStatus() const { return m_inputStatus; }
+
+private:
+    std::string m_cemuVersion;
+    std::function<void()> m_onQuitSession;
+    std::function<void()> m_onQuitApplication;
+    // Rising-edge tracking for the two callbacks above -- see
+    // applyGenericInput()'s use of this, mirroring AzaharAdapter's
+    // lastEmulatorActions_ member and its comment (the client resends its
+    // confirmed choice for a short window to survive UDP loss, so a naive
+    // "is the bit set" check would fire the callback repeatedly for one
+    // menu pick).
+    uint32_t m_lastEmulatorActions = 0;
+
+    std::shared_ptr<RemoteInputStatus> m_inputStatus;
+
+    // The single, process-lifetime RemoteController instance (see
+    // RemoteController.h/RemoteControllerProvider.h), and VPAD player 1's
+    // EmulatedController -- both looked up once at construction via
+    // InputManager::instance() and held here only so the destructor can
+    // call remove_controller() on the same pair passed to add_controller()
+    // at construction (see this file's top comment). Null if either
+    // lookup failed (e.g. player 1 isn't configured as a VPAD controller
+    // type), in which case this adapter's input side is inert but video
+    // capture still works.
+    std::shared_ptr<ControllerBase> m_remoteController;
+    std::shared_ptr<EmulatedController> m_vpadController;
+
+    CapturedSurface m_tvSurface;
+    CapturedSurface m_gamePadSurface;
+
+    // Per-surface throttle state for onSurfaceRendered() -- see that
+    // method's declaration comment above.
+    std::chrono::steady_clock::time_point m_lastTvCapture{};
+    std::chrono::steady_clock::time_point m_lastGamePadCapture{};
+
+    // Set by setClientConnected(), called by RemoteServerBridge via
+    // AdapterIpcClient::setConnectionStateCallback() (ipc_protocol.h's
+    // ClientConnectionChanged message -- already existed, already
+    // reaches this process, just never previously wired to anything
+    // capture-related): true only while a NetServer client is actually
+    // connected and handshaked, as opposed to
+    // AdapterIpcClient::isConnected(), which only ever means "this Cemu
+    // process is connected to dualdeck-host-service" and says nothing
+    // about whether a Deck is on the other end watching. Gating capture
+    // on this (see onSurfaceRendered()) means an idle host service with
+    // no client -- the common case between play sessions on an
+    // always-running Bazzite HTPC -- costs Cemu nothing at all, not even
+    // a throttled/no-op check against the GPU.
+    std::atomic<bool> m_clientConnected{false};
+
+    // Bookkeeping for the async (Vulkan) capture path -- which slot
+    // index (if any) currently holds an outstanding, not-yet-published
+    // capture this adapter itself scheduled, and which surface it
+    // belongs to. Renderer/VulkanRenderer owns the actual GPU resources
+    // per slot (staging buffers, blit images); this is purely
+    // CemuAdapter's own view of "what did I ask for and not collect
+    // yet," used by onSurfaceRendered() to pick a free slot and by
+    // pumpCaptures() to know which CapturedSurface a completed slot's
+    // pixels belong to.
+    struct PendingCapture {
+        bool inFlight = false;
+        bool isPadView = false;
+        int width = 0;
+        int height = 0;
+    };
+    static constexpr uint32_t kMaxCaptureSlots = 4; // upper bound; real count is std::min(this, renderer's own GetCaptureSlotCount())
+    std::array<PendingCapture, kMaxCaptureSlots> m_pendingCaptures{};
+    uint32_t m_captureSlotCount = 0; // resolved lazily, once, on first async schedule attempt
+
+    // Diagnostics -- see CemuAdapter.cpp's logCaptureDiagnosticsIfDue()
+    // for how these actually surface (a throttled cemuLog_log() summary
+    // line, visible in Cemu's own log window/log.txt). Plain counters,
+    // not atomics: every increment happens on the render thread (the
+    // only thread that ever calls onSurfaceRendered()/pumpCaptures()),
+    // same single-writer assumption every other per-surface state in
+    // this class already relies on (m_lastTvCapture etc. above).
+    struct CaptureDiagnostics {
+        uint64_t scheduled = 0;      // ScheduleCaptureSurfaceBGRA() succeeded (async path)
+        uint64_t completedSync = 0;  // old synchronous CaptureSurfaceBGRA() path succeeded
+        uint64_t dropped = 0;        // wanted to capture, but no free slot -- frame skipped, Cemu never blocked
+        uint64_t failed = 0;         // Schedule/ReadAndRelease returned false
+        uint64_t completed = 0;      // ReadAndReleaseCaptureSlot() succeeded and was published
+        uint64_t skippedNoViewer = 0; // m_clientConnected was false
+    };
+    CaptureDiagnostics m_captureDiagnostics;
+    std::chrono::steady_clock::time_point m_lastDiagnosticsLog{};
+
+    // Prints a throttled (see its own definition) cemuLog_log() summary
+    // of m_captureDiagnostics -- acceptance criterion "diagnostics for
+    // capture scheduling, dropped frames, pending slots, and completed
+    // frames," surfaced through Cemu's existing log window/log.txt
+    // rather than a new IPC message or UI, matching how every other
+    // DualDeck-specific condition in this file already reports itself
+    // (cemuLog_log(LogType::Force, "DualDeck: ...")). Called from
+    // pumpCaptures() every time it runs (i.e. every real frame), but
+    // only actually logs occasionally.
+    void logCaptureDiagnosticsIfDue();
+
+    std::atomic<bool> m_running{true};
+};
+
+} // namespace DualDeck::RemoteServer
diff --git a/src/remote_server/RemoteController.cpp b/src/remote_server/RemoteController.cpp
new file mode 100644
index 0000000..1af7065
--- /dev/null
+++ b/src/remote_server/RemoteController.cpp
@@ -0,0 +1,123 @@
+#include "remote_server/RemoteController.h"
+
+#include "melonds_remote/adapter/generic_input.h"
+
+// This file's raw_state() feeds the same Buttons2 IDs
+// VPADController::set_default_mapping()'s InputAPI::XInput case reads
+// (input/emulated/VPADController.cpp), and that table already applies
+// an Xbox-layout -> Nintendo-layout physical-position correction
+// (kButtonId_A <- kButton13: Wii U's A comes from the position Xbox
+// calls B). Cemu is the only backend here that corrects positions a
+// second time, downstream of us.
+//
+// That matters because DualDeck's GenericButton_* does NOT carry a
+// physical position by the time it reaches an adapter -- it carries a
+// Nintendo *label*. adapter_bridge.cpp maps DSButton_A ->
+// GenericButton_South, and since 2026-08-04 the client sends the DS
+// button matching the physical position pressed, so the right-hand
+// face button arrives as DSButton_A -> GenericButton_South. Azahar and
+// melonDS consume that label directly and are correct.
+//
+// Feeding those labels to Cemu as though they were positions makes its
+// own correction fire against an already-corrected value, flipping all
+// four face buttons -- real user report, 2026-08-04. So each label is
+// mapped to the XInput bit Cemu's table turns *into* that same Nintendo
+// button: South ("A") -> kButton13, which its table reads as Wii U A.
+// See docs/known-limitations.md's 2026-08-04 entries.
+//
+//   client GenericButton --(this file, real-XInput-bit-position)-->
+//   Buttons2 --(VPADController's DualDeckRemote case, reusing the
+//   XInput table verbatim, Xbox->Nintendo position correction)--> Wii U
+//
+//   GenericButton_South (our "A") -> kButton13 -> Wii U A
+//   GenericButton_East  (our "B") -> kButton12 -> Wii U B
+//   GenericButton_West  (our "X") -> kButton15 -> Wii U X
+//   GenericButton_North (our "Y") -> kButton14 -> Wii U Y
+//   GenericButton_DpadUp         -> kButton0
+//   GenericButton_DpadDown       -> kButton1
+//   GenericButton_DpadLeft       -> kButton2
+//   GenericButton_DpadRight      -> kButton3
+//   GenericButton_L1             -> kButton8
+//   GenericButton_R1             -> kButton9
+//   GenericButton_L3             -> kButton6  (left stick click)
+//   GenericButton_R3             -> kButton7  (right stick click)
+//   GenericButton_Start          -> kButton4  (+)
+//   GenericButton_Select         -> kButton5  (-)
+//
+// GenericButton_L2/R2 (digital ZL/ZR fallback) are intentionally NOT
+// mapped here: ZL/ZR are analog-only on the Wii U GamePad
+// (kButtonId_ZL/ZR map to kTriggerXP/YP, not a plain Buttons2 button --
+// see ControllerBase::update_state()'s apply_axis_button(), which
+// derives kTriggerXP/XN's pressed-state itself from result.trigger), so
+// leftTrigger/rightTrigger below are what actually drives ZL/ZR; a
+// client with no analog trigger hardware still works because it sends
+// leftTrigger=rightTrigger=0xFF while GenericButton_L2/R2 is held (see
+// host/adapter_bridge.cpp's existing digital-trigger-fallback
+// convention for the DS/3DS adapters, reused as-is here).
+//
+// GenericButton_Home has no Wii U VPAD equivalent in the mirrored
+// XInput table and is left unmapped, same as XInput itself leaves it
+// unmapped in VPADController::set_default_mapping().
+
+namespace DualDeck::RemoteServer {
+
+namespace {
+using melonds_remote::adapter::GenericButton_DpadDown;
+using melonds_remote::adapter::GenericButton_DpadLeft;
+using melonds_remote::adapter::GenericButton_DpadRight;
+using melonds_remote::adapter::GenericButton_DpadUp;
+using melonds_remote::adapter::GenericButton_East;
+using melonds_remote::adapter::GenericButton_L1;
+using melonds_remote::adapter::GenericButton_L3;
+using melonds_remote::adapter::GenericButton_North;
+using melonds_remote::adapter::GenericButton_R1;
+using melonds_remote::adapter::GenericButton_R3;
+using melonds_remote::adapter::GenericButton_Select;
+using melonds_remote::adapter::GenericButton_South;
+using melonds_remote::adapter::GenericButton_Start;
+using melonds_remote::adapter::GenericButton_West;
+} // namespace
+
+RemoteController::RemoteController(std::shared_ptr<RemoteInputStatus> status)
+    : base_type("dualdeck-remote", "DualDeck Remote"), m_status(std::move(status)) {}
+
+ControllerState RemoteController::raw_state() {
+    ControllerState result{};
+
+    std::lock_guard guard(m_status->mutex);
+    const uint32_t buttons = m_status->buttons;
+
+    auto setIf = [&result](uint32_t mask, uint32_t bit, uint64 target) {
+        if (mask & bit) {
+            result.buttons.SetButtonState(static_cast<uint32>(target), true);
+        }
+    };
+    setIf(buttons, GenericButton_South, kButton13);
+    setIf(buttons, GenericButton_East, kButton12);
+    setIf(buttons, GenericButton_West, kButton15);
+    setIf(buttons, GenericButton_North, kButton14);
+    setIf(buttons, GenericButton_DpadUp, kButton0);
+    setIf(buttons, GenericButton_DpadDown, kButton1);
+    setIf(buttons, GenericButton_DpadLeft, kButton2);
+    setIf(buttons, GenericButton_DpadRight, kButton3);
+    setIf(buttons, GenericButton_L1, kButton8);
+    setIf(buttons, GenericButton_R1, kButton9);
+    setIf(buttons, GenericButton_L3, kButton6);
+    setIf(buttons, GenericButton_R3, kButton7);
+    setIf(buttons, GenericButton_Start, kButton4);
+    setIf(buttons, GenericButton_Select, kButton5);
+
+    // -32768..32767 -> -1..1, same convention (no inversion) the
+    // existing AzaharAdapter::RemoteAnalogDevice already uses for the
+    // same wire fields.
+    result.axis = {static_cast<float>(m_status->leftStickX) / 32768.0f,
+                    static_cast<float>(m_status->leftStickY) / 32768.0f};
+    result.rotation = {static_cast<float>(m_status->rightStickX) / 32768.0f,
+                        static_cast<float>(m_status->rightStickY) / 32768.0f};
+    result.trigger = {static_cast<float>(m_status->leftTrigger) / 255.0f,
+                       static_cast<float>(m_status->rightTrigger) / 255.0f};
+
+    return result;
+}
+
+} // namespace DualDeck::RemoteServer
diff --git a/src/remote_server/RemoteController.h b/src/remote_server/RemoteController.h
new file mode 100644
index 0000000..bd1c312
--- /dev/null
+++ b/src/remote_server/RemoteController.h
@@ -0,0 +1,75 @@
+#pragma once
+
+// ControllerBase implementation backing DualDeck's Cemu integration. A
+// single instance of this class is what CemuAdapter's constructor passes
+// to VPAD player 1's add_controller()/set_default_mapping() -- see
+// CemuAdapter.h's top comment for why that pairing (not
+// set_default_mapping() alone) is what actually makes the client's
+// input reach the game.
+//
+// raw_state() translates the shared RemoteInputStatus (written by
+// CemuAdapter::applyGenericInput()) into a Buttons2-space ControllerState
+// -- see this file's .cpp for the exact bit table, deliberately mirroring
+// VPADController::set_default_mapping()'s existing InputAPI::XInput case
+// bit-for-bit (confirmed by reading that function, not assumed), so the
+// patch's new InputAPI::DualDeckRemote case in that same function can
+// reuse the XInput table verbatim instead of needing a new one.
+//
+// has_position()/get_position() back the Wii U GamePad touchscreen --
+// ControllerBase virtuals VPADController::update_touch()
+// (input/emulated/VPADController.cpp) already checks before falling back
+// to a local mouse click, and that DSUController/NativeWiimoteController
+// already implement for their own touch/pointer hardware. See
+// CemuAdapter.h's top comment's touch section and RemoteController.cpp
+// for the exact normalization.
+
+#include <memory>
+#include <mutex>
+
+#include "input/api/Controller.h"
+#include "remote_server/RemoteControllerProvider.h"
+#include "remote_server/RemoteInputStatus.h"
+
+namespace DualDeck::RemoteServer {
+
+class RemoteController final : public Controller<RemoteControllerProvider> {
+public:
+    explicit RemoteController(std::shared_ptr<RemoteInputStatus> status);
+
+    std::string_view api_name() const override {
+        static_assert(to_string(InputAPI::DualDeckRemote) == "DualDeckRemote");
+        return to_string(InputAPI::DualDeckRemote);
+    }
+    InputAPI::Type api() const override { return InputAPI::DualDeckRemote; }
+
+    // Always true: this controller exists precisely because a game is
+    // being streamed to a DualDeck client, matching AzaharAdapter's
+    // identical RemoteButtonDevice/RemoteAnalogDevice reasoning (the
+    // physical presence of a network client, not a local USB/Bluetooth
+    // enumeration event, is what "connected" means here) -- whether a
+    // client has actually joined yet is a session-level concern
+    // (CemuAdapter::currentState()), not a per-button-poll one.
+    bool is_connected() override { return true; }
+
+    // Wii U GamePad touchscreen. Values are set by
+    // CemuAdapter::applyGenericInput() on the AdapterIpcClient readLoop()
+    // thread and read here on whatever thread polls VPAD (Cemu's HLE
+    // coreinit thread) -- always through RemoteInputStatus::mutex, same
+    // as raw_state()'s buttons/sticks/triggers below.
+    bool has_position() override {
+        std::lock_guard guard(m_status->mutex);
+        return m_status->touchActive;
+    }
+    glm::vec2 get_position() override {
+        std::lock_guard guard(m_status->mutex);
+        return {m_status->touchX, m_status->touchY};
+    }
+
+protected:
+    ControllerState raw_state() override;
+
+private:
+    std::shared_ptr<RemoteInputStatus> m_status;
+};
+
+} // namespace DualDeck::RemoteServer
