+++ b/src/Cafe/HW/Latte/Renderer/OpenGL/OpenGLRenderer.cpp
@@ -544,6 +544,74 @@ void OpenGLRenderer::HandleScreenshotRequest(LatteTextureView* texView, bool pad
 	SaveScreenshot(rgb_data, screenshotWidth, screenshotHeight, !padView);
 }
 
+#ifndef GL_BGRA
+#define GL_BGRA 0x80E1
+#endif
+
+// DualDeck (github.com/crimson3076/DualDeck): see Renderer.h's
+// CaptureSurfaceBGRA() comment. Reads directly as GL_BGRA so no
+// channel-swap pass over every pixel is needed (GL_BGRA +
+// GL_UNSIGNED_BYTE gives byte order B,G,R,A in memory, exactly
+// PixelFormat::Bgra8888's convention). Does apply the same
+// srcUsesSRGB/dstUsesSRGB correction HandleScreenshotRequest() above
+// applies -- skipping it isn't just cosmetic here (unlike a screenshot,
+// the whole point of this path is to look right when displayed
+// remotely): when a render target's GX2 surface format is sRGB but the
+// buffer it's ultimately composited into isn't (or vice versa), the raw
+// bytes are in the wrong color space and streamed frames come out
+// visibly darker/lighter than Cemu's own window.
+bool OpenGLRenderer::CaptureSurfaceBGRA(LatteTextureView* texView, bool padView, std::vector<uint8>& outPixels, int& outWidth, int& outHeight)
+{
+	if (!texView)
+		return false;
+
+	int width, height;
+	glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+	texture_bindAndActivate(texView, 0);
+	glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &width);
+	glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &height);
+	glPixelStorei(GL_PACK_ALIGNMENT, 1);
+
+	if (width <= 0 || height <= 0)
+	{
+		texture_bindAndActivate(nullptr, 0);
+		return false;
+	}
+
+	outPixels.resize(static_cast<size_t>(width) * height * 4);
+	glGetTexImage(GL_TEXTURE_2D, 0, GL_BGRA, GL_UNSIGNED_BYTE, outPixels.data());
+	texture_bindAndActivate(nullptr, 0);
+
+	const bool srcUsesSRGB = HAS_FLAG(texView->format, Latte::E_GX2SURFFMT::FMT_BIT_SRGB);
+	const bool dstUsesSRGB = (!padView && LatteGPUState.tvBufferUsesSRGB) || (padView && LatteGPUState.drcBufferUsesSRGB);
+	if (srcUsesSRGB != dstUsesSRGB)
+	{
+		const bool toLinear = srcUsesSRGB && !dstUsesSRGB;
+		uint8* pixels = outPixels.data();
+		const size_t pixelCount = static_cast<size_t>(width) * static_cast<size_t>(height);
+		for (size_t i = 0; i < pixelCount; ++i)
+		{
+			uint8* p = pixels + i * 4; // B, G, R, A
+			if (toLinear)
+			{
+				p[0] = SRGBComponentToRGB(p[0]);
+				p[1] = SRGBComponentToRGB(p[1]);
+				p[2] = SRGBComponentToRGB(p[2]);
+			}
+			else
+			{
+				p[0] = RGBComponentToSRGB(p[0]);
+				p[1] = RGBComponentToSRGB(p[1]);
+				p[2] = RGBComponentToSRGB(p[2]);
+			}
+		}
+	}
+
+	outWidth = width;
+	outHeight = height;
+	return true;
+}
