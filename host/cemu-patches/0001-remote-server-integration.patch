@@ -0,0 +1,14 @@
+#include "remote_server/RemoteControllerProvider.h"
+
+#include "remote_server/RemoteController.h"
+
+namespace DualDeck::RemoteServer {
+
+RemoteControllerProvider::RemoteControllerProvider()
+    : m_inputStatus(std::make_shared<RemoteInputStatus>()) {}
+
+std::vector<std::shared_ptr<ControllerBase>> RemoteControllerProvider::get_controllers() {
+    return {std::make_shared<RemoteController>(m_inputStatus)};
+}
