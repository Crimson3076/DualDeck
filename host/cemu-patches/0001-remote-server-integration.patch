+} // namespace DualDeck::RemoteServer
diff --git a/src/remote_server/RemoteControllerProvider.h b/src/remote_server/RemoteControllerProvider.h
new file mode 100644
index 0000000..25b973b
--- /dev/null
+++ b/src/remote_server/RemoteControllerProvider.h
@@ -0,0 +1,65 @@
+#pragma once
+
+// ControllerProviderBase implementation backing DualDeck's Cemu
+// integration (InputAPI::DualDeckRemote, added by this patch -- see
+// input/api/InputAPI.h). Registered exactly once, at Cemu startup,
+// via InputManager::instance().create_provider<RemoteControllerProvider>()
+// (the same call InputManager's constructor already makes for
+// KeyboardControllerProvider/SDLControllerProvider/etc., see
+// InputManager.cpp) -- independent of any particular game session, since
+// Wii U's own controller-provider model is process-lifetime, not
+// per-boot (confirmed by reading InputManager.cpp: every
+// create_provider<T>() call happens in InputManager's constructor).
+//
+// Owns the single, process-lifetime RemoteInputStatus CemuAdapter reads/
+// writes on every applyGenericInput() call -- CemuAdapter itself is
+// created/destroyed per game boot (see RemoteServerBridge), so it cannot
+// own this state directly without it being torn down and losing
+// InputManager's mapping between game sessions. CemuAdapter's
+// constructor looks this provider up via
+// InputManager::instance().get_api_provider(InputAPI::DualDeckRemote) and
+// borrows its shared_ptr<RemoteInputStatus> rather than constructing its
+// own.
+//
+// get_controllers() mints a fresh RemoteController on every call rather
+// than caching a singleton instance -- deliberately mirroring
+// KeyboardControllerProvider::get_controllers() (confirmed by reading
+// it), which does the same for the same reason: RemoteController itself
+// is trivial/stateless (all real state lives in the shared
+// RemoteInputStatus this provider owns), and constructing one requires
+// looking this provider up through
+// InputManager::instance().get_api_provider() (see Controller<TProvider>'s
+// constructor in input/api/Controller.h) -- which only succeeds once
+// InputManager has finished registering this provider via
+// create_provider<RemoteControllerProvider>(), i.e. strictly after this
+// provider's own constructor has already returned. Constructing the
+// RemoteController eagerly inside this provider's own constructor would
+// therefore hit that not-yet-registered chicken-and-egg case and fail;
+// deferring construction to get_controllers() (only ever called later,
+// once a game actually boots) avoids it, same as Keyboard's provider
+// does.
+
+#include <memory>
+#include <vector>
+
+#include "input/api/ControllerProvider.h"
+#include "remote_server/RemoteInputStatus.h"
+
+namespace DualDeck::RemoteServer {
+
+class RemoteControllerProvider final : public ControllerProviderBase {
+public:
+    RemoteControllerProvider();
+
+    inline static InputAPI::Type kAPIType = InputAPI::DualDeckRemote;
+    InputAPI::Type api() const override { return kAPIType; }
+
+    std::vector<std::shared_ptr<ControllerBase>> get_controllers() override;
+
+    const std::shared_ptr<RemoteInputStatus>& inputStatus() const { return m_inputStatus; }
+
+private:
+    std::shared_ptr<RemoteInputStatus> m_inputStatus;
+};
+
+} // namespace DualDeck::RemoteServer
diff --git a/src/remote_server/RemoteInputStatus.h b/src/remote_server/RemoteInputStatus.h
new file mode 100644
index 0000000..987a462
--- /dev/null
+++ b/src/remote_server/RemoteInputStatus.h
@@ -0,0 +1,43 @@
+#pragma once
+
+// Shared, mutex-protected input state for DualDeck's Cemu integration.
+// Written by CemuAdapter::applyGenericInput(), read by
+// RemoteController::raw_state() -- pulled out of CemuAdapter.h into its
+// own header so RemoteControllerProvider.h/RemoteController.h don't need
+// to include the whole adapter_contract.h-dependent CemuAdapter.h just
+// for this one struct.
+//
+// Packed directly in the same Buttons2 bit layout
+// VPADController::set_default_mapping()'s InputAPI::XInput case already
+// expects (see RemoteController.cpp's top comment for the exact table),
+// so no new per-API mapping logic was needed in the patch.
+//
+// touchActive/touchX/touchY back RemoteController::has_position()/
+// get_position() (see RemoteController.cpp's touch comment) -- CemuAdapter
+// normalizes protocol.h's DS-shaped touch wire fields (0..kTouchMaxX/
+// kTouchMaxY) into the same 0..1 fractional convention
+// ControllerBase::get_position() already documents and DSUController/
+// NativeWiimoteController already produce, so VPADController::update_touch()
+// (input/emulated/VPADController.cpp), which already checks has_position()
+// before falling back to a local mouse click, picks this up with no
+// upstream Cemu change at all.
+#include <cstdint>
+#include <mutex>
+
+namespace DualDeck::RemoteServer {
+
+struct RemoteInputStatus {
+    std::mutex mutex;
+    uint32_t buttons = 0; // GenericButton bitmask, translated in RemoteController::raw_state()
+    int16_t leftStickX = 0;
+    int16_t leftStickY = 0;
+    int16_t rightStickX = 0;
+    int16_t rightStickY = 0;
+    uint8_t leftTrigger = 0;  // analog ZL, 0..255
+    uint8_t rightTrigger = 0; // analog ZR, 0..255
+    bool touchActive = false;
+    float touchX = 0.0f; // normalized 0..1, valid only if touchActive
+    float touchY = 0.0f;
+};
+
+} // namespace DualDeck::RemoteServer
diff --git a/src/remote_server/RemoteServerBridge.cpp b/src/remote_server/RemoteServerBridge.cpp
new file mode 100644
index 0000000..e50c8e9
--- /dev/null
+++ b/src/remote_server/RemoteServerBridge.cpp
@@ -0,0 +1,177 @@
+#include "remote_server/RemoteServerBridge.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+
+#include <wx/event.h>
+
+#include "gui/MainWindow.h"
+#include "remote_server/CemuAdapter.h"
+
+namespace DualDeck::RemoteServer {
+
+namespace {
+std::atomic<CemuAdapter*> s_currentAdapter{nullptr};
+
+// Two private wx event types, defined and Bind()'d entirely inside this
+// file rather than added to MainWindow's own event table -- wx's Bind()
+// lets any code attach a handler to an existing window for an event
+// type that window never declared itself, so a CemuAdapter's
+// QuitSession/QuitApplication callbacks (which fire from
+// AdapterIpcClient's background thread, never Cemu's wx GUI thread, see
+// CemuAdapter.h's constructor comment) can safely reach g_mainFrame via
+// wxQueueEvent() (wx's documented thread-safe way to talk to the GUI
+// thread from a worker thread) without any change to MainWindow.h/.cpp
+// at all. Mirrors MainWindow::CafePPCProcessExit()'s existing identical
+// wxQueueEvent(g_mainFrame, new wxCommandEvent(wxEVT_REQUEST_GAME_EXIT))
+// pattern (confirmed by reading it) for the same "called from a non-GUI
+// thread" reason.
+wxDEFINE_EVENT(EVT_DUALDECK_QUIT_SESSION, wxCommandEvent);
+
+} // namespace
+
+RemoteServerBridge::RemoteServerBridge(std::string cemuVersion, std::string adapterSocketPath) {
+    if (g_mainFrame) {
+        // QuitSession: stop the current title, return to the game list --
+        // same "eject/stop" semantics as the File > End Emulation menu
+        // item, just reachable from a background thread. That menu item
+        // (MAINFRAME_MENU_ID_FILE_END_EMULATION in MainWindow.cpp) inlines
+        // its handling directly in OnFileMenu() rather than exposing a
+        // public method, and the id it switches on is a private
+        // implementation-detail enum with no stable value to reference
+        // from outside that translation unit -- so MainWindow::EndEmulation()
+        // (declared in MainWindow.h, defined in MainWindow.cpp) extracts
+        // that exact same sequence into a small public method OnFileMenu
+        // itself now also calls, rather than duplicating it here.
+        // QuitApplication: post a real wxCloseEvent, i.e. behave exactly
+        // as if the user had clicked MainWindow's own close button --
+        // MainWindow already binds EVT_CLOSE(MainWindow::OnClose)
+        // (confirmed by reading it), so no new close-handling logic is
+        // needed here at all.
+        g_mainFrame->Bind(EVT_DUALDECK_QUIT_SESSION, [](wxCommandEvent&) {
+            if (g_mainFrame) {
+                g_mainFrame->EndEmulation();
+            }
+        });
+    }
+
+    adapter_ = std::make_unique<CemuAdapter>(
+        std::move(cemuVersion),
+        [] {
+            if (g_mainFrame) {
+                wxQueueEvent(g_mainFrame, new wxCommandEvent(EVT_DUALDECK_QUIT_SESSION));
+            }
+        },
+        [] {
+            if (g_mainFrame) {
+                wxQueueEvent(g_mainFrame, new wxCloseEvent(wxEVT_CLOSE_WINDOW));
+            }
+        });
+    s_currentAdapter.store(adapter_.get());
+
+    ipcClient_ =
+        std::make_unique<dualdeck::adapter::ipc::AdapterIpcClient>(*adapter_, std::move(adapterSocketPath));
+
+    // DualDeck, 2026-08-26: wires ipc_protocol.h's ClientConnectionChanged
+    // message (already delivered here -- AdapterIpcClient::readLoop()
+    // already parsed it and already offered this exact callback hook,
+    // just never previously connected to anything) to
+    // CemuAdapter::setClientConnected(), which onSurfaceRendered() now
+    // gates all GPU capture work on. Set here, before start()/connect()
+    // is ever called (see setConnectionStateCallback()'s own comment for
+    // why that ordering matters), and captures `adapter_.get()` (a raw
+    // pointer, not `this`) rather than `adapter_` itself -- this callback
+    // outlives the exact moment adapter_ is later moved into stop()'s
+    // detached cleanup thread (see that function's own comment), and
+    // AdapterIpcClient guarantees this callback and CemuAdapter's own
+    // destruction (both driven through that same detached thread's
+    // ipcClient->disconnect() call, which joins readLoop() before
+    // returning) can never overlap.
+    CemuAdapter* const adapterPtr = adapter_.get();
+    ipcClient_->setConnectionStateCallback(
+        [adapterPtr](bool connected) { adapterPtr->setClientConnected(connected); });
+}
+
+RemoteServerBridge::~RemoteServerBridge() {
+    stop();
+}
+
+void RemoteServerBridge::start() {
+    // Same 1s-doubling-to-5s-backoff reconnect loop as Azahar's own
+    // RemoteServerBridge::start() (itself mirroring client/src/main.cpp's
+    // NetClient reconnect thread) -- see that file's comment for why:
+    // AdapterIpcClient::connect() is a single blocking, non-retrying
+    // attempt, so this thread supplies the retry loop, with a short poll
+    // granularity so stop() doesn't have to wait out a full backoff
+    // period to return.
+    stopRequested_ = false;
+    reconnectThread_ = std::thread([this]() {
+        uint32_t backoffMs = 1000;
+        constexpr uint32_t kMaxBackoffMs = 5000;
+        while (!stopRequested_.load()) {
+            if (!ipcClient_->isConnected()) {
+                std::fprintf(stderr, "cemu-remote: attempting to connect to the Host Service (adapter IPC)...\n");
+                if (ipcClient_->connect()) {
+                    std::fprintf(stderr, "cemu-remote: connected to Host Service\n");
+                    backoffMs = 1000;
+                } else {
+                    backoffMs = std::min(backoffMs * 2, kMaxBackoffMs);
+                }
+            }
+            for (uint32_t waited = 0; waited < backoffMs && !stopRequested_.load(); waited += 100) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            }
+        }
+    });
+}
+
+void RemoteServerBridge::stop() {
+    stopRequested_ = true;
+    // Cleared synchronously (not deferred to the background thread below)
+    // so any other code reading currentAdapter() sees "no active bridge"
+    // immediately, matching this function's previous synchronous behavior
+    // for that one piece of state.
+    s_currentAdapter.store(nullptr);
+    if (!reconnectThread_.joinable() && !ipcClient_ && !adapter_) {
+        return;
+    }
+    // Real user report, 2026-08-03: "cemu seems to hang when trying to
+    // exit. and I usually have to terminate it." Traced to this function
+    // running SYNCHRONOUSLY on Cemu's GUI thread (via
+    // MainWindow::EndEmulation() -> CafeSystem::ShutdownTitle() ->
+    // s_remoteServerBridge.reset(), see CafeSystem.cpp/MainWindow.cpp)
+    // while reconnectThread_.join() below can block for however long the
+    // reconnect loop takes to notice stopRequested_ and wake from its
+    // current 100ms sleep, INCLUDING the up-to-~5s it can be stuck inside
+    // a blocking AdapterIpcClient::connect() attempt at the exact moment
+    // stop() is called (bounded by adapter_ipc_client.cpp's own
+    // kRecvTimeoutSeconds, but still long enough for a GUI to look and
+    // feel completely frozen to an impatient user). Fixed by handing the
+    // actual join + disconnect off to a detached background thread, which
+    // also takes ownership of ipcClient_/adapter_ (moved in below) rather
+    // than leaving them to be destroyed synchronously right after this
+    // function returns -- ipcClient_'s read/write threads hold a
+    // reference to *adapter_ (see the constructor above) and must finish
+    // shutting down (inside ipcClient->disconnect(), which joins them)
+    // before adapter_'s destructor can safely run, so both must move into
+    // the same closure and be destroyed there, in that order, rather than
+    // adapter_ being destroyed back here on the GUI thread the instant
+    // this function returns.
+    std::thread cleanup([reconnectThread = std::move(reconnectThread_), ipcClient = std::move(ipcClient_),
+                          adapter = std::move(adapter_)]() mutable {
+        if (reconnectThread.joinable()) {
+            reconnectThread.join();
+        }
+        if (ipcClient) {
+            ipcClient->disconnect();
+        }
+    });
+    cleanup.detach();
+}
+
+CemuAdapter* RemoteServerBridge::currentAdapter() {
+    return s_currentAdapter.load();
+}
+
+} // namespace DualDeck::RemoteServer
