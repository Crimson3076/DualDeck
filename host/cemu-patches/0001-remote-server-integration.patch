+// DualDeck (github.com/crimson3076/DualDeck): see Renderer.h's
+// CaptureSurfaceBGRA() comment. Structurally the same blit-if-needed +
+// copy-to-host-buffer + wait approach as HandleScreenshotRequest()
+// above (a full GPU sync every call, same cost that function already
+// pays for a one-shot screenshot) -- deliberately not attempting a
+// non-blocking/double-buffered readback here, since this project's own
+// Azahar integration already establishes a periodic-poll-with-full-sync
+// as an acceptable tradeoff for a small streamed display (see
+// AzaharAdapter.cpp), and CemuAdapter.cpp throttles how often this is
+// even called (CEMU_REMOTE_CAPTURE_FPS, default 30) specifically to
+// bound this cost. Simpler than HandleScreenshotRequest() in two ways:
+// no main/pad screenshot-sequencing state (this isn't a one-shot
+// request), and the blit-if-needed path always targets UNORM rather
+// than choosing based on dstUsesSRGB (blitting doesn't itself apply a
+// gamma curve, so the source's original sRGB-ness -- captured below,
+// before any reassignment -- is what the post-copy correction actually
+// needs, not whatever the blit destination format happened to be).
+bool VulkanRenderer::CaptureSurfaceBGRA(LatteTextureView* texView, bool padView, std::vector<uint8>& outPixels, int& outWidth, int& outHeight)
+{
+	if (!texView)
+		return false;
+
+	auto texViewVk = (LatteTextureViewVk*)texView;
+	auto baseImageTex = texViewVk->GetBaseImage();
+
+	auto textureVk = baseImageTex->GetImageObj();
+	textureVk->flagForCurrentCommandBuffer();
+
+	auto dumpImage = textureVk->m_image;
+	auto baseImage = dumpImage;
+
+	int width, height;
+	baseImageTex->GetEffectiveSize(width, height, 0);
+	if (width <= 0 || height <= 0)
+		return false;
+
+	if (texViewVk->firstMip != 0)
+	{
+		cemuLog_log(LogType::Force, "DualDeck: failed to capture surface: capturing non-zero mip is not supported");
+		return false;
+	}
+
+	VkImage image = nullptr;
+	VkDeviceMemory imageMemory = nullptr;
+
+	auto format = baseImageTex->GetFormat();
+	// Captured before the blit-if-needed path below reassigns `format` --
+	// see HandleScreenshotRequest()'s identical srcUsesSRGB/dstUsesSRGB
+	// comparison, mirrored below after the pixel data is read back.
+	const bool srcUsesSRGB = format == VK_FORMAT_R8G8B8A8_SRGB || format == VK_FORMAT_R8G8B8_SRGB;
+	const bool isDirectlyReadable = format == VK_FORMAT_R8G8B8A8_UNORM || format == VK_FORMAT_R8G8B8A8_SRGB ||
+		format == VK_FORMAT_R8G8B8_UNORM || format == VK_FORMAT_R8G8B8_SNORM;
+	if (!isDirectlyReadable)
+	{
+		VkFormatProperties formatProps;
+		vkGetPhysicalDeviceFormatProperties(m_physicalDevice, format, &formatProps);
+		bool supportsBlit = (formatProps.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_SRC_BIT) != 0;
+
+		constexpr VkFormat blitFormat = VK_FORMAT_R8G8B8A8_UNORM;
+		vkGetPhysicalDeviceFormatProperties(m_physicalDevice, blitFormat, &formatProps);
+		supportsBlit &= (formatProps.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_DST_BIT) != 0;
+
+		if (!supportsBlit)
+		{
+			cemuLog_log(LogType::Force, "DualDeck: capture failed: surface is not RGB(A)8 and blitting is unsupported");
+			return false;
+		}
+
+		VkImageCreateInfo imageInfo{};
+		imageInfo.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+		imageInfo.format = blitFormat;
+		imageInfo.extent = {(uint32)width, (uint32)height, 1};
+		imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+		imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+		imageInfo.arrayLayers = 1;
+		imageInfo.mipLevels = 1;
+		imageInfo.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+		imageInfo.imageType = VK_IMAGE_TYPE_2D;
+		imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+		imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+
+		if (vkCreateImage(m_logicalDevice, &imageInfo, nullptr, &image) != VK_SUCCESS)
+			return false;
+
+		VkMemoryRequirements memRequirements;
+		vkGetImageMemoryRequirements(m_logicalDevice, image, &memRequirements);
+
+		VkMemoryAllocateInfo allocInfo{};
+		allocInfo.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+		allocInfo.allocationSize = memRequirements.size;
+		uint32 memIndex;
+		bool foundMemory = memoryManager->FindMemoryType(memRequirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, memIndex);
+		if (!foundMemory)
+		{
+			vkDestroyImage(m_logicalDevice, image, nullptr);
+			cemuLog_log(LogType::Force, "DualDeck: capture failed due to incompatible vulkan memory types.");
+			return false;
+		}
+		allocInfo.memoryTypeIndex = memIndex;
+
+		if (vkAllocateMemory(m_logicalDevice, &allocInfo, nullptr, &imageMemory) != VK_SUCCESS)
+		{
+			vkDestroyImage(m_logicalDevice, image, nullptr);
+			cemuLog_log(LogType::Force, "DualDeck: capture failed due to failed memory allocation.");
+			return false;
+		}
+
+		vkBindImageMemory(m_logicalDevice, image, imageMemory, 0);
+
+		{
+			VkImageSubresourceRange range;
+			range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+			range.baseMipLevel = 0;
+			range.levelCount = 1;
+			range.baseArrayLayer = 0;
+			range.layerCount = 1;
+			barrier_image<TRANSFER_READ, TRANSFER_WRITE>(image, range, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		}
+		{
+			VkImageSubresourceLayers range;
+			range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+			range.mipLevel = 0;
+			range.baseArrayLayer = texViewVk->firstSlice;
+			range.layerCount = 1;
+			barrier_image<IMAGE_WRITE | TRANSFER_WRITE, SYNC_OP::TRANSFER_READ>(baseImageTex, range, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+		}
+
+		VkOffset3D blitSize{width, height, 1};
+		VkImageBlit imageBlitRegion{};
+		imageBlitRegion.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+		imageBlitRegion.srcSubresource.mipLevel = 0;
+		imageBlitRegion.srcSubresource.baseArrayLayer = texViewVk->firstSlice;
+		imageBlitRegion.srcSubresource.layerCount = 1;
+		imageBlitRegion.srcOffsets[1] = blitSize;
+
+		imageBlitRegion.dstSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+		imageBlitRegion.dstSubresource.mipLevel = 0;
+		imageBlitRegion.dstSubresource.baseArrayLayer = 0;
+		imageBlitRegion.dstSubresource.layerCount = 1;
+		imageBlitRegion.dstOffsets[1] = blitSize;
+
+		vkCmdBlitImage(m_state.currentCommandBuffer, dumpImage, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &imageBlitRegion, VK_FILTER_NEAREST);
+
+		{
+			VkImageSubresourceRange range;
+			range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+			range.baseMipLevel = 0;
+			range.levelCount = 1;
+			range.baseArrayLayer = 0;
+			range.layerCount = 1;
+			barrier_image<TRANSFER_WRITE, TRANSFER_READ>(image, range, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL);
+		}
+		{
+			VkImageSubresourceLayers range;
+			range.aspectMask = baseImageTex->GetImageAspect();
+			range.mipLevel = 0;
+			range.baseArrayLayer = texViewVk->firstSlice;
+			range.layerCount = 1;
+			// DualDeck: LatteTextureVk has no GetDefaultLayout() in this
+			// Cemu version (a later addition) -- VK_IMAGE_LAYOUT_GENERAL
+			// is the literal, hardcoded restore target
+			// HandleScreenshotRequest() above already uses for this exact
+			// same "done reading a render target via blit, put it back"
+			// step (see its own barrier.oldLayout = VK_IMAGE_LAYOUT_GENERAL
+			// / newLayout = VK_IMAGE_LAYOUT_GENERAL pair around its own
+			// blit), not a value read from `baseImageTex` at all.
+			barrier_image<TRANSFER_READ, TRANSFER_WRITE | IMAGE_WRITE>(baseImageTex, range, VK_IMAGE_LAYOUT_GENERAL);
+		}
+
+		format = VK_FORMAT_R8G8B8A8_UNORM;
+		dumpImage = image;
+	}
+
+	uint32 size;
+	switch (format)
+	{
+	case VK_FORMAT_R8G8B8A8_UNORM:
+	case VK_FORMAT_R8G8B8A8_SRGB:
+		size = 4 * width * height;
+		break;
+	case VK_FORMAT_R8G8B8_UNORM:
+	case VK_FORMAT_R8G8B8_SRGB:
+		size = 3 * width * height;
+		break;
+	default:
+		size = 0;
+	}
+
+	if (size == 0)
+	{
+		if (image)
+			vkDestroyImage(m_logicalDevice, image, nullptr);
+		if (imageMemory)
+			vkFreeMemory(m_logicalDevice, imageMemory, nullptr);
+		return false;
+	}
+
+	VkBufferImageCopy region{};
+	region.bufferOffset = 0;
+	region.bufferRowLength = width;
+	region.bufferImageHeight = height;
+
+	region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+	region.imageSubresource.baseArrayLayer = 0;
+	region.imageSubresource.layerCount = 1;
+	region.imageSubresource.mipLevel = 0;
+
+	region.imageOffset = { 0,0,0 };
+	region.imageExtent = { (uint32)width,(uint32)height,1 };
+
+	// DualDeck: (re)allocate the persistent staging buffer only when it
+	// doesn't exist yet or is too small for this call's `size` -- see
+	// VulkanRenderer.h's m_dualDeckCaptureStagingBuffer comment for why
+	// this is cached across calls rather than a fresh vkCreateBuffer/
+	// vkAllocateMemory every time, unlike this function's blit-target
+	// `image` above (still per-call: only exercised for non-directly-
+	// readable formats, a smaller fraction of calls, and correctly
+	// tracking its layout across reuse is more involved than a buffer,
+	// which has none). CreateBuffer()'s return value is checked here
+	// (HandleScreenshotRequest() above doesn't check its own equivalent
+	// call, but that one only ever runs once per rare user action -- this
+	// one runs continuously, so a transient allocation failure needs to
+	// fail this call cleanly instead of mapping/copying through a
+	// VK_NULL_HANDLE).
+	if (m_dualDeckCaptureStagingBuffer == VK_NULL_HANDLE || m_dualDeckCaptureStagingBufferSize < size)
+	{
+		if (m_dualDeckCaptureStagingBuffer != VK_NULL_HANDLE)
+		{
+			vkUnmapMemory(m_logicalDevice, m_dualDeckCaptureStagingBufferMemory);
+			memoryManager->DeleteBuffer(m_dualDeckCaptureStagingBuffer, m_dualDeckCaptureStagingBufferMemory);
+			m_dualDeckCaptureStagingBufferSize = 0;
+		}
+		if (!memoryManager->CreateBuffer(size, VK_BUFFER_USAGE_TRANSFER_DST_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, m_dualDeckCaptureStagingBuffer, m_dualDeckCaptureStagingBufferMemory))
+		{
+			cemuLog_log(LogType::Force, "DualDeck: capture failed: could not allocate staging buffer");
+			if (image)
+				vkDestroyImage(m_logicalDevice, image, nullptr);
+			if (imageMemory)
+				vkFreeMemory(m_logicalDevice, imageMemory, nullptr);
+			return false;
+		}
+		m_dualDeckCaptureStagingBufferSize = size;
+		vkMapMemory(m_logicalDevice, m_dualDeckCaptureStagingBufferMemory, 0, VK_WHOLE_SIZE, 0, &m_dualDeckCaptureStagingBufferPtr);
+	}
+	VkBuffer buffer = m_dualDeckCaptureStagingBuffer;
+	void* bufferPtr = m_dualDeckCaptureStagingBufferPtr;
+
+	if (dumpImage == baseImage)
+	{
+		region.imageSubresource.baseArrayLayer = texViewVk->firstSlice;
+		barrier_image<IMAGE_WRITE | TRANSFER_WRITE, TRANSFER_READ>(baseImageTex, region.imageSubresource, VK_IMAGE_LAYOUT_GENERAL);
+	}
+
+	vkCmdCopyImageToBuffer(m_state.currentCommandBuffer, dumpImage, VK_IMAGE_LAYOUT_GENERAL, buffer, 1, &region);
+	if (dumpImage == baseImage)
+	{
+		// DualDeck: see the identical comment above this function's other
+		// GetDefaultLayout() replacement -- same reasoning, same fix.
+		barrier_image<TRANSFER_READ, TRANSFER_WRITE | IMAGE_WRITE>(baseImageTex, region.imageSubresource, VK_IMAGE_LAYOUT_GENERAL);
+	}
+
+	// DualDeck: real bug, found while diagnosing the Wind Waker HD
+	// 14-20fps regression (docs/history.md) -- this used to
+	// read `GetCurrentCommandBufferId()` *after* SubmitCommandBuffer()
+	// below, which returns m_numSubmittedCmdBuffers -- already
+	// incremented by that submit, i.e. the ID the *next* (still-empty)
+	// command buffer will get once *it* is submitted, not the one that
+	// actually contains this capture's copy command. WaitCommandBufferFinished()
+	// (VulkanRenderer.h) special-cases exactly this: `if (commandBufferId
+	// == m_numSubmittedCmdBuffers) SubmitCommandBuffer();` -- so passing
+	// the just-incremented value made it submit a second, entirely empty
+	// command buffer every single call, purely to have something to wait
+	// on, before the wait itself (correctly, if wastefully) still ended
+	// up blocking until the real capture buffer completed too, since
+	// buffers are processed in submission order. Reading the ID *before*
+	// the submit below fixes the double-submit; this function still
+	// blocks the render thread until the GPU catches up either way,
+	// which is the real, larger bug this whole feature's async
+	// redesign (ScheduleCaptureSurfaceBGRA() and friends, this file's
+	// .h) exists to actually fix -- CemuAdapter no longer calls this
+	// synchronous version for Vulkan at all (see its own
+	// onSurfaceRendered() comment), but it's kept working correctly
+	// (rather than just deleted) as the documented fallback any future
+	// caller -- or a backend without an async implementation -- gets via
+	// Renderer::CaptureSurfaceBGRA()'s default dispatch.
+	const uint64 captureCommandBufferId = GetCurrentCommandBufferId();
+	SubmitCommandBuffer();
+	WaitCommandBufferFinished(captureCommandBufferId);
+
+	// Convert to BGRA8888 (this project's PixelFormat::Bgra8888 wire
+	// convention) regardless of whether the source was 4- or 3-channel.
+	outPixels.resize(static_cast<size_t>(width) * height * 4);
+	uint8* dst = outPixels.data();
+	switch (format)
+	{
+	case VK_FORMAT_R8G8B8A8_UNORM:
+	case VK_FORMAT_R8G8B8A8_SRGB:
+		for (auto src = (uint8*)bufferPtr; src < (uint8*)bufferPtr + size; src += 4, dst += 4)
+		{
+			dst[0] = src[2]; // B
+			dst[1] = src[1]; // G
+			dst[2] = src[0]; // R
+			dst[3] = src[3]; // A
+		}
+		break;
+	case VK_FORMAT_R8G8B8_UNORM:
+	case VK_FORMAT_R8G8B8_SRGB:
+		for (auto src = (uint8*)bufferPtr; src < (uint8*)bufferPtr + size; src += 3, dst += 4)
+		{
+			dst[0] = src[2]; // B
+			dst[1] = src[1]; // G
+			dst[2] = src[0]; // R
+			dst[3] = 0xFF;   // A
+		}
+		break;
+	default:
+		break;
+	}
+
+	// DualDeck: m_dualDeckCaptureStagingBuffer/buffer is intentionally NOT
+	// unmapped/freed/destroyed here -- see its allocation above, kept
+	// alive across calls instead.
+
+	if (image)
+		vkDestroyImage(m_logicalDevice, image, nullptr);
+	if (imageMemory)
+		vkFreeMemory(m_logicalDevice, imageMemory, nullptr);
+
+	// Mirror HandleScreenshotRequest()'s sRGB<->linear correction -- without
+	// it, a render target whose original format was sRGB but whose display
+	// buffer isn't (or vice versa) streams visibly darker/lighter than
+	// Cemu's own window, since the raw bytes are then in the wrong color
+	// space for direct display.
+	const bool dstUsesSRGB = (!padView && LatteGPUState.tvBufferUsesSRGB) || (padView && LatteGPUState.drcBufferUsesSRGB);
+	if (srcUsesSRGB != dstUsesSRGB)
+	{
+		const bool toLinear = srcUsesSRGB && !dstUsesSRGB;
+		uint8* pixels = outPixels.data();
+		const size_t pixelCount = static_cast<size_t>(width) * static_cast<size_t>(height);
+		for (size_t i = 0; i < pixelCount; ++i)
+		{
+			uint8* p = pixels + i * 4; // B, G, R, A
+			if (toLinear)
+			{
+				p[0] = SRGBComponentToRGB(p[0]);
+				p[1] = SRGBComponentToRGB(p[1]);
+				p[2] = SRGBComponentToRGB(p[2]);
+			}
+			else
+			{
+				p[0] = RGBComponentToSRGB(p[0]);
+				p[1] = RGBComponentToSRGB(p[1]);
+				p[2] = RGBComponentToSRGB(p[2]);
+			}
+		}
+	}
+
+	outWidth = width;
+	outHeight = height;
+	return true;
+}
+
+// DualDeck (github.com/crimson3076/DualDeck): non-blocking replacement
+// for the always-synchronous CaptureSurfaceBGRA() above -- see Renderer.h's
+// comment on this method (and its four siblings below) for the contract,
+// and docs/history.md's Wind Waker HD entry for the real
+// 14-20fps-instead-of-30 regression this exists to fix.
+//
+// This function's own body is CaptureSurfaceBGRA()'s recording half,
+// verbatim in structure (same firstMip check, same isDirectlyReadable/
+// blit-if-needed path, same barrier sequence, same staging-buffer-copy)
+// -- retargeted from the single shared m_dualDeckCaptureStagingBuffer/
+// its one scratch blit `image` to this slot's own persistent
+// stagingBuffer/blitImage (see VulkanRenderer.h's DualDeckCaptureSlot
+// comment for why each slot needs its own rather than sharing one), and
+// stopping the instant the copy-to-buffer command is recorded: no
+// SubmitCommandBuffer(), no WaitCommandBufferFinished(), no CPU-side
+// BGRA/sRGB conversion here at all (that all moves to
+// ReadAndReleaseCaptureSlot(), below, which only runs once the GPU has
+// actually finished -- see IsCaptureSlotReady()). RequestSubmitSoon()/
+// RequestSubmitOnIdle() at the very end are the entire extent of this
+// function's involvement in getting the recording actually submitted:
+// both just nudge thresholds SubmitCommandBuffer() itself already checks
+// on Cemu's own normal rendering cadence (see their own definitions,
+// "submit within next 10 drawcalls" / "submit when GPU has no more
+// commands to process or when threshold is reached") -- never an
+// out-of-band submit this function forces itself, which is what made
+// the old synchronous path a guaranteed render-thread stall every call.
+bool VulkanRenderer::ScheduleCaptureSurfaceBGRA(LatteTextureView* texView, bool padView, uint32 slotIndex, int& outWidth, int& outHeight)
+{
+	if (slotIndex >= kDualDeckCaptureSlotCount)
+		return false;
+	auto& slot = m_dualDeckCaptureSlots[slotIndex];
+	if (slot.inUse || !texView)
+		return false;
+
+	auto texViewVk = (LatteTextureViewVk*)texView;
+	auto baseImageTex = texViewVk->GetBaseImage();
+
+	auto textureVk = baseImageTex->GetImageObj();
+	textureVk->flagForCurrentCommandBuffer();
+
+	auto dumpImage = textureVk->m_image;
+	auto baseImage = dumpImage;
+
+	int width, height;
+	baseImageTex->GetEffectiveSize(width, height, 0);
+	if (width <= 0 || height <= 0)
+		return false;
+
+	if (texViewVk->firstMip != 0)
+	{
+		cemuLog_log(LogType::Force, "DualDeck: failed to capture surface: capturing non-zero mip is not supported");
+		return false;
+	}
+
+	auto format = baseImageTex->GetFormat();
+	const bool srcUsesSRGB = format == VK_FORMAT_R8G8B8A8_SRGB || format == VK_FORMAT_R8G8B8_SRGB;
+	const bool isDirectlyReadable = format == VK_FORMAT_R8G8B8A8_UNORM || format == VK_FORMAT_R8G8B8A8_SRGB ||
+		format == VK_FORMAT_R8G8B8_UNORM || format == VK_FORMAT_R8G8B8_SNORM;
+	if (!isDirectlyReadable)
+	{
+		VkFormatProperties formatProps;
+		vkGetPhysicalDeviceFormatProperties(m_physicalDevice, format, &formatProps);
+		bool supportsBlit = (formatProps.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_SRC_BIT) != 0;
+
+		constexpr VkFormat blitFormat = VK_FORMAT_R8G8B8A8_UNORM;
+		vkGetPhysicalDeviceFormatProperties(m_physicalDevice, blitFormat, &formatProps);
+		supportsBlit &= (formatProps.optimalTilingFeatures & VK_FORMAT_FEATURE_BLIT_DST_BIT) != 0;
+
+		if (!supportsBlit)
+		{
+			cemuLog_log(LogType::Force, "DualDeck: capture failed: surface is not RGB(A)8 and blitting is unsupported");
+			return false;
+		}
+
+		// (Re)create this slot's own blit image only when it doesn't
+		// exist yet or this capture's size differs from what it was
+		// last sized for -- see DualDeckCaptureSlot's own comment for
+		// why each slot has its own rather than sharing the single
+		// scratch `image` CaptureSurfaceBGRA() above creates and
+		// destroys every single call.
+		if (slot.blitImage == VK_NULL_HANDLE || slot.blitImageWidth != width || slot.blitImageHeight != height)
+		{
+			if (slot.blitImage != VK_NULL_HANDLE)
+			{
+				vkDestroyImage(m_logicalDevice, slot.blitImage, nullptr);
+				slot.blitImage = VK_NULL_HANDLE;
+			}
+			if (slot.blitImageMemory != VK_NULL_HANDLE)
+			{
+				vkFreeMemory(m_logicalDevice, slot.blitImageMemory, nullptr);
+				slot.blitImageMemory = VK_NULL_HANDLE;
+			}
+
+			VkImageCreateInfo imageInfo{};
+			imageInfo.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+			imageInfo.format = blitFormat;
+			imageInfo.extent = {(uint32)width, (uint32)height, 1};
+			imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+			imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+			imageInfo.arrayLayers = 1;
+			imageInfo.mipLevels = 1;
+			imageInfo.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+			imageInfo.imageType = VK_IMAGE_TYPE_2D;
+			imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+			imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+
+			if (vkCreateImage(m_logicalDevice, &imageInfo, nullptr, &slot.blitImage) != VK_SUCCESS)
+				return false;
+
+			VkMemoryRequirements memRequirements;
+			vkGetImageMemoryRequirements(m_logicalDevice, slot.blitImage, &memRequirements);
+
+			VkMemoryAllocateInfo allocInfo{};
+			allocInfo.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+			allocInfo.allocationSize = memRequirements.size;
+			uint32 memIndex;
+			bool foundMemory = memoryManager->FindMemoryType(memRequirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, memIndex);
+			if (!foundMemory)
+			{
+				vkDestroyImage(m_logicalDevice, slot.blitImage, nullptr);
+				slot.blitImage = VK_NULL_HANDLE;
+				cemuLog_log(LogType::Force, "DualDeck: capture failed due to incompatible vulkan memory types.");
+				return false;
+			}
+			allocInfo.memoryTypeIndex = memIndex;
+
+			if (vkAllocateMemory(m_logicalDevice, &allocInfo, nullptr, &slot.blitImageMemory) != VK_SUCCESS)
+			{
+				vkDestroyImage(m_logicalDevice, slot.blitImage, nullptr);
+				slot.blitImage = VK_NULL_HANDLE;
+				cemuLog_log(LogType::Force, "DualDeck: capture failed due to failed memory allocation.");
+				return false;
+			}
+
+			vkBindImageMemory(m_logicalDevice, slot.blitImage, slot.blitImageMemory, 0);
+			slot.blitImageWidth = width;
+			slot.blitImageHeight = height;
+		}
+
+		{
+			// Always transitioned from UNDEFINED, even on a reused
+			// image -- see DualDeckCaptureSlot's own comment: this
+			// slot's previous capture (if any) has already been read
+			// and released by the time a new one is scheduled into it
+			// (ScheduleCaptureSurfaceBGRA() requires !slot.inUse), so
+			// there is never anything worth preserving in this image.
+			VkImageSubresourceRange range;
+			range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+			range.baseMipLevel = 0;
+			range.levelCount = 1;
+			range.baseArrayLayer = 0;
+			range.layerCount = 1;
+			barrier_image<TRANSFER_READ, TRANSFER_WRITE>(slot.blitImage, range, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+		}
+		{
+			VkImageSubresourceLayers range;
+			range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+			range.mipLevel = 0;
+			range.baseArrayLayer = texViewVk->firstSlice;
+			range.layerCount = 1;
+			barrier_image<IMAGE_WRITE | TRANSFER_WRITE, SYNC_OP::TRANSFER_READ>(baseImageTex, range, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+		}
+
+		VkOffset3D blitSize{width, height, 1};
+		VkImageBlit imageBlitRegion{};
+		imageBlitRegion.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+		imageBlitRegion.srcSubresource.mipLevel = 0;
+		imageBlitRegion.srcSubresource.baseArrayLayer = texViewVk->firstSlice;
+		imageBlitRegion.srcSubresource.layerCount = 1;
+		imageBlitRegion.srcOffsets[1] = blitSize;
+
+		imageBlitRegion.dstSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+		imageBlitRegion.dstSubresource.mipLevel = 0;
+		imageBlitRegion.dstSubresource.baseArrayLayer = 0;
+		imageBlitRegion.dstSubresource.layerCount = 1;
+		imageBlitRegion.dstOffsets[1] = blitSize;
+
+		vkCmdBlitImage(m_state.currentCommandBuffer, dumpImage, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, slot.blitImage, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &imageBlitRegion, VK_FILTER_NEAREST);
+
+		{
+			VkImageSubresourceRange range;
+			range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+			range.baseMipLevel = 0;
+			range.levelCount = 1;
+			range.baseArrayLayer = 0;
+			range.layerCount = 1;
+			barrier_image<TRANSFER_WRITE, TRANSFER_READ>(slot.blitImage, range, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL);
+		}
+		{
+			VkImageSubresourceLayers range;
+			range.aspectMask = baseImageTex->GetImageAspect();
+			range.mipLevel = 0;
+			range.baseArrayLayer = texViewVk->firstSlice;
+			range.layerCount = 1;
+			barrier_image<TRANSFER_READ, TRANSFER_WRITE | IMAGE_WRITE>(baseImageTex, range, VK_IMAGE_LAYOUT_GENERAL);
+		}
+
+		format = VK_FORMAT_R8G8B8A8_UNORM;
+		dumpImage = slot.blitImage;
+	}
+
+	uint32 size;
+	switch (format)
+	{
+	case VK_FORMAT_R8G8B8A8_UNORM:
+	case VK_FORMAT_R8G8B8A8_SRGB:
+		size = 4 * width * height;
+		break;
+	case VK_FORMAT_R8G8B8_UNORM:
+	case VK_FORMAT_R8G8B8_SRGB:
+		size = 3 * width * height;
+		break;
+	default:
+		size = 0;
+	}
+
+	if (size == 0)
+		return false;
+
+	VkBufferImageCopy region{};
+	region.bufferOffset = 0;
+	region.bufferRowLength = width;
+	region.bufferImageHeight = height;
+
+	region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+	region.imageSubresource.baseArrayLayer = 0;
+	region.imageSubresource.layerCount = 1;
+	region.imageSubresource.mipLevel = 0;
+
+	region.imageOffset = { 0,0,0 };
+	region.imageExtent = { (uint32)width,(uint32)height,1 };
+
+	// (Re)allocate this slot's own persistent staging buffer only when
+	// it doesn't exist yet or is too small -- same on-demand-resize
+	// pattern as the single shared m_dualDeckCaptureStagingBuffer
+	// CaptureSurfaceBGRA() above uses, just per-slot.
+	if (slot.stagingBuffer == VK_NULL_HANDLE || slot.stagingBufferCapacity < size)
+	{
+		if (slot.stagingBuffer != VK_NULL_HANDLE)
+		{
+			vkUnmapMemory(m_logicalDevice, slot.stagingBufferMemory);
+			memoryManager->DeleteBuffer(slot.stagingBuffer, slot.stagingBufferMemory);
+			slot.stagingBufferCapacity = 0;
+		}
+		if (!memoryManager->CreateBuffer(size, VK_BUFFER_USAGE_TRANSFER_DST_BIT, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, slot.stagingBuffer, slot.stagingBufferMemory))
+		{
+			cemuLog_log(LogType::Force, "DualDeck: capture failed: could not allocate staging buffer");
+			return false;
+		}
+		slot.stagingBufferCapacity = size;
+		vkMapMemory(m_logicalDevice, slot.stagingBufferMemory, 0, VK_WHOLE_SIZE, 0, &slot.stagingBufferPtr);
+	}
+
+	if (dumpImage == baseImage)
+	{
+		region.imageSubresource.baseArrayLayer = texViewVk->firstSlice;
+		barrier_image<IMAGE_WRITE | TRANSFER_WRITE, TRANSFER_READ>(baseImageTex, region.imageSubresource, VK_IMAGE_LAYOUT_GENERAL);
+	}
+
+	vkCmdCopyImageToBuffer(m_state.currentCommandBuffer, dumpImage, VK_IMAGE_LAYOUT_GENERAL, slot.stagingBuffer, 1, &region);
+	if (dumpImage == baseImage)
+	{
+		barrier_image<TRANSFER_READ, TRANSFER_WRITE | IMAGE_WRITE>(baseImageTex, region.imageSubresource, VK_IMAGE_LAYOUT_GENERAL);
+	}
+
+	// This capture's own recording is now complete -- record which
+	// command-buffer ID it belongs to *before* asking for a submission
+	// (see GetCurrentCommandBufferId()'s own comment: it returns
+	// m_numSubmittedCmdBuffers, i.e. the ID the CURRENTLY recording
+	// buffer will be assigned once *something* eventually submits it --
+	// exactly the id IsCaptureSlotReady()'s later HasCommandBufferFinished()
+	// check needs). This is the same "read the ID before, not after, the
+	// submit" fix CaptureSurfaceBGRA() above needed -- except here there
+	// is no submit call in this function at all to get the ordering
+	// wrong on.
+	slot.commandBufferId = GetCurrentCommandBufferId();
+	slot.width = width;
+	slot.height = height;
+	slot.capturedFormat = format;
+	const bool dstUsesSRGB = (!padView && LatteGPUState.tvBufferUsesSRGB) || (padView && LatteGPUState.drcBufferUsesSRGB);
+	slot.needsSRGBCorrection = srcUsesSRGB != dstUsesSRGB;
+	slot.toLinear = srcUsesSRGB && !dstUsesSRGB;
+	slot.inUse = true;
+
+	// Never an out-of-band SubmitCommandBuffer()/WaitCommandBufferFinished()
+	// here -- see this function's own top comment. Both calls below are
+	// the same cheap, non-blocking "nudge" every other Cemu draw call
+	// already relies on to eventually get its own commands submitted.
+	RequestSubmitSoon();
+	RequestSubmitOnIdle();
+
+	outWidth = width;
+	outHeight = height;
+	return true;
+}
+
+bool VulkanRenderer::IsCaptureSlotFree(uint32 slotIndex)
+{
+	if (slotIndex >= kDualDeckCaptureSlotCount)
+		return false;
+	auto& slot = m_dualDeckCaptureSlots[slotIndex];
+
+	// DualDeck: self-healing reclaim for an orphaned slot -- CemuAdapter
+	// is created/destroyed per game boot (RemoteServerBridge), but this
+	// VulkanRenderer, and therefore m_dualDeckCaptureSlots, is process-
+	// lifetime. If a CemuAdapter is destroyed (game exited, DualDeck
+	// itself deconfigured, etc.) with a capture still in flight, nobody
+	// is ever going to call ReadAndReleaseCaptureSlot() for it again --
+	// its owner is gone -- so without this, that one slot would stay
+	// "in use" forever, permanently shrinking the effective slot pool
+	// for the rest of this process's lifetime (including for a
+	// completely unrelated, later-launched title's own CemuAdapter).
+	// Safe to reclaim here specifically because a *live* CemuAdapter
+	// never lets this situation arise in the first place: its own
+	// pumpCaptures() (CemuAdapter.cpp) always runs before its own
+	// onSurfaceRendered() scheduling calls within the same
+	// LatteRenderTarget.cpp hook invocation, so a slot that's actually
+	// ready gets drained (freeing it the normal way, via
+	// ReadAndReleaseCaptureSlot()) before this function is ever asked
+	// about it again in the same frame. A slot found here that's both
+	// in-use and GPU-finished can therefore only be one whose owner
+	// stopped asking -- never a live, working adapter's own
+	// about-to-be-collected capture.
+	if (slot.inUse && HasCommandBufferFinished(slot.commandBufferId))
+		slot.inUse = false;
+
+	return !slot.inUse;
+}
+
+bool VulkanRenderer::IsCaptureSlotReady(uint32 slotIndex)
+{
+	if (slotIndex >= kDualDeckCaptureSlotCount)
+		return false;
+	auto& slot = m_dualDeckCaptureSlots[slotIndex];
+	return slot.inUse && HasCommandBufferFinished(slot.commandBufferId);
+}
+
+// See Renderer.h's comment: pure CPU work against an already-mapped,
+// HOST_COHERENT staging buffer -- no Vulkan calls, so this is safe to
+// call from CemuAdapter's "safe deferred path" without any new
+// synchronization (see CemuAdapter::pumpCaptures()'s own comment).
+bool VulkanRenderer::ReadAndReleaseCaptureSlot(uint32 slotIndex, std::vector<uint8>& outPixels)
+{
+	if (slotIndex >= kDualDeckCaptureSlotCount)
+		return false;
+	auto& slot = m_dualDeckCaptureSlots[slotIndex];
+	if (!slot.inUse)
+		return false;
+
+	// Always released, even if this function returns false below -- an
+	// unreadable slot must not stay permanently "in use" and starve
+	// CemuAdapter of a free slot forever.
+	struct ReleaseGuard
+	{
+		DualDeckCaptureSlot& slot;
+		~ReleaseGuard() { slot.inUse = false; }
+	} releaseGuard{slot};
+
+	if (slot.width <= 0 || slot.height <= 0 || !slot.stagingBufferPtr)
+		return false;
+
+	// Same conversion CaptureSurfaceBGRA() above always did, just
+	// reading this slot's own staging buffer instead of the shared one --
+	// except fused into a single pass over the frame instead of two
+	// (2026-08-26 real-hardware finding: this function runs on Cemu's own
+	// render thread, once per completed capture, and a second full pass
+	// -- re-reading and re-writing every byte of an already-converted
+	// frame just to apply sRGB correction -- doubled the memory traffic
+	// this paid for any capture that needed it, on top of the unavoidable
+	// cost of the first pass alone).
+	//
+	// Each format's loop is fully duplicated three ways below (no
+	// correction / correct-to-linear / correct-to-sRGB) rather than
+	// branching on slot.needsSRGBCorrection/toLinear inside the loop or
+	// selecting a function pointer once outside it -- a first version of
+	// this fix tried the function-pointer approach and measured *slower*
+	// than the original two-pass code (a real, verified regression, not
+	// a theoretical concern: a call through a function pointer can't be
+	// inlined the way a direct call to SRGBComponentToRGB()/
+	// RGBComponentToSRGB() can, and losing that inlining in this exact
+	// hot loop cost more than the second memory pass it was meant to
+	// avoid). Direct calls in fully-duplicated loop bodies keep every
+	// call inlinable, measured ~1.6-1.7x faster than the original two-
+	// pass version when correction is needed, and identical when it
+	// isn't (same single pass either way).
+	outPixels.resize(static_cast<size_t>(slot.width) * slot.height * 4);
+	uint8* dst = outPixels.data();
+	const uint8* srcBase = static_cast<const uint8*>(slot.stagingBufferPtr);
+	switch (slot.capturedFormat)
+	{
+	case VK_FORMAT_R8G8B8A8_UNORM:
+	case VK_FORMAT_R8G8B8A8_SRGB:
+	{
+		const uint8* srcEnd = srcBase + static_cast<size_t>(slot.width) * slot.height * 4;
+		if (!slot.needsSRGBCorrection)
+		{
+			for (auto src = srcBase; src < srcEnd; src += 4, dst += 4)
+			{
+				dst[0] = src[2]; // B
+				dst[1] = src[1]; // G
+				dst[2] = src[0]; // R
+				dst[3] = src[3]; // A
+			}
+		}
+		else if (slot.toLinear)
+		{
+			for (auto src = srcBase; src < srcEnd; src += 4, dst += 4)
+			{
+				dst[0] = SRGBComponentToRGB(src[2]); // B
+				dst[1] = SRGBComponentToRGB(src[1]); // G
+				dst[2] = SRGBComponentToRGB(src[0]); // R
+				dst[3] = src[3];                     // A -- never corrected
+			}
+		}
+		else
+		{
+			for (auto src = srcBase; src < srcEnd; src += 4, dst += 4)
+			{
+				dst[0] = RGBComponentToSRGB(src[2]); // B
+				dst[1] = RGBComponentToSRGB(src[1]); // G
+				dst[2] = RGBComponentToSRGB(src[0]); // R
+				dst[3] = src[3];                     // A -- never corrected
+			}
+		}
+		break;
+	}
+	case VK_FORMAT_R8G8B8_UNORM:
+	case VK_FORMAT_R8G8B8_SRGB:
+	{
+		const uint8* srcEnd = srcBase + static_cast<size_t>(slot.width) * slot.height * 3;
+		if (!slot.needsSRGBCorrection)
+		{
+			for (auto src = srcBase; src < srcEnd; src += 3, dst += 4)
+			{
+				dst[0] = src[2]; // B
+				dst[1] = src[1]; // G
+				dst[2] = src[0]; // R
+				dst[3] = 0xFF;   // A
+			}
+		}
+		else if (slot.toLinear)
+		{
+			for (auto src = srcBase; src < srcEnd; src += 3, dst += 4)
+			{
+				dst[0] = SRGBComponentToRGB(src[2]); // B
+				dst[1] = SRGBComponentToRGB(src[1]); // G
+				dst[2] = SRGBComponentToRGB(src[0]); // R
+				dst[3] = 0xFF;                       // A
+			}
+		}
+		else
+		{
+			for (auto src = srcBase; src < srcEnd; src += 3, dst += 4)
+			{
+				dst[0] = RGBComponentToSRGB(src[2]); // B
+				dst[1] = RGBComponentToSRGB(src[1]); // G
+				dst[2] = RGBComponentToSRGB(src[0]); // R
+				dst[3] = 0xFF;                       // A
+			}
+		}
+		break;
+	}
+	default:
+		return false;
+	}
+
+	return true;
+}
